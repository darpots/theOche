---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import current from '../data/tournament.json';

interface Props { title: string; description?: string; active?: 'home' | 'calendar' | 'matches' | 'news' | 'rankings' }
const { title, description = 'PDC darts on TV, live matches, news and world rankings.', active } = Astro.props;
const nav = [
  { key: 'home', href: '/', label: 'Home' },
  { key: 'news', href: '/news', label: 'News' },
  { key: 'calendar', href: '/calendar', label: 'Calendar' },
  { key: 'matches', href: `/tournament/${current.tournament.id}`, label: 'Matches' },
  { key: 'rankings', href: '/rankings', label: 'Rankings' },
];
const t = current.tournament;
const icons: Record<string, string> = {
  home: '<path d="M4 11l8-7 8 7v8a2 2 0 0 1-2 2h-3v-6H9v6H6a2 2 0 0 1-2-2z"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  matches: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/>',
  news: '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M8 9h8M8 13h8M8 17h5"/>',
  rankings: '<path d="M5 20V11M12 20V5M19 20v-6"/>',
};
const fullTitle = title === 'The Oche' ? title : `${title} · The Oche`;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0c10" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <ClientRouter />
  </head>
  <body>
    <header class="top" transition:persist transition:name="site-header" transition:animate="none">
      <div class="wrap bar">
        <a href="/" class="brand" aria-label="The Oche home"><Logo size={40} tone="light" /></a>
        <nav aria-label="Main" data-current={current.tournament.id}>
          {nav.map(n => (
            <a href={n.href} class:list={['nav', { on: active === n.key }]} aria-current={active === n.key ? 'page' : undefined} data-nav={n.key}>{n.label}</a>
          ))}
          <span class="pill" aria-hidden="true"></span>
          <!-- Shown by the live bar script while a match is in play; goes to that match -->
          <a class="livenav" id="livenav" href="/" hidden><span class="ln-dot" aria-hidden="true"></span>Live</a>
        </nav>
        <button class="searchbtn" type="button" data-open-search aria-label="Search players, events and news">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" /><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          <span>Search</span><kbd>⌘K</kbd>
        </button>
      </div>
      <!-- Live bar: shown site-wide while the current event has matches on today -->
      <div class="livebar" id="livebar" hidden data-id={t.id} data-start={t.start} data-end={t.end} data-name={t.name}>
        <div class="wrap lb-in" aria-live="polite"></div>
      </div>
    </header>

    <nav class="tabbar" aria-label="Main">
      {nav.map(n => (
        <a href={n.href} class:list={['tab', { on: active === n.key }]} data-tab={n.key}>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[n.key]} />
          <span>{n.label}</span>
        </a>
      ))}
      <button class="tab" type="button" data-open-search>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" /></svg>
        <span>Search</span>
      </button>
    </nav>

    <dialog class="search" id="search" aria-label="Search">
      <div class="s-box">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" /><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <input id="sq" type="search" placeholder="Search players, events and news" autocomplete="off" aria-controls="sr" />
        <button type="button" class="s-close" data-close-search aria-label="Close search">Esc</button>
      </div>
      <ul id="sr" class="s-res" role="listbox"></ul>
    </dialog>

    <main transition:animate="fade">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <p><strong>The Oche</strong> is an independent fan site and is not affiliated with the PDC, Sky Sports or ITV. <a href="/credits">Photo credits</a></p>
      </div>
    </footer>

    <script>
      import { liveScore } from '../lib/pdc.mjs';
      import { liveFor, LIVE_TICK } from '../lib/live-client.mjs';
      // Scroll-reveal + the sliding nav pill.
      const keyFor = (path: string) => {
        const p = path.replace(/\/$/, '') || '/';
        if (p === '/') return 'home';
        const [, a, b] = p.split('/');
        if (a === 'tournament') return b === document.querySelector<HTMLElement>('.top nav')?.dataset.current ? 'matches' : 'calendar';
        if (a === 'players') return 'rankings';
        return a;
      };
      // The header is persisted across page swaps, and re-inserting it cancels
      // CSS transitions, so the slide is driven with the Web Animations API
      // after each swap, starting from where the pill was before navigation.
      let last: { x: number; w: number } | null = null;
      function setOn(key: string) {
        document.querySelectorAll<HTMLAnchorElement>('.tabbar .tab[data-tab]').forEach(a => a.classList.toggle('on', a.dataset.tab === key));
        document.querySelectorAll<HTMLAnchorElement>('.top a.nav').forEach(a => {
          const on = a.dataset.nav === key;
          a.classList.toggle('on', on);
          if (on) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current');
        });
      }
      function movePill(key: string, animate = true) {
        const pill = document.querySelector<HTMLElement>('.top nav .pill');
        const a = document.querySelector<HTMLAnchorElement>(`.top a.nav[data-nav="${key}"]`);
        setOn(key);
        if (!pill) return;
        if (!a) { pill.style.opacity = '0'; last = null; return; }
        const to = { x: a.offsetLeft, w: a.offsetWidth };
        pill.style.transition = 'none';
        pill.style.width = to.w + 'px';
        pill.style.transform = `translateX(${to.x}px)`;
        const appear = pill.style.opacity !== '1';
        pill.style.opacity = '1';
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (animate && !reduce && last && (last.x !== to.x || last.w !== to.w)) {
          pill.animate([
            { transform: `translateX(${last.x}px)`, width: `${last.w}px` },
            { transform: `translateX(${to.x + (to.x > last.x ? 6 : -6)}px)`, width: `${to.w}px`, offset: 0.7 },
            { transform: `translateX(${to.x}px)`, width: `${to.w}px` },
          ], { duration: 520, easing: 'cubic-bezier(.2,.8,.2,1)' });
          pill.animate([{ scale: '1 1' }, { scale: '1.06 .84', offset: 0.35 }, { scale: '1 1' }], { duration: 520, easing: 'ease-out' });
        } else if (appear && !reduce) {
          pill.animate([{ opacity: 0, scale: '.9' }, { opacity: 1, scale: '1' }], { duration: 300, easing: 'ease-out' });
        }
        last = to;
      }
      function init() {
        const io = new IntersectionObserver(entries => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('[data-reveal]:not(.in)').forEach(el => io.observe(el));
        movePill(keyFor(location.pathname));
      }
      document.addEventListener('astro:page-load', init);
      // Highlight the chosen link straight away; the pill slides once the page swaps.
      document.addEventListener('astro:before-preparation', e => setOn(keyFor((e as any).to.pathname)));
      window.addEventListener('resize', () => movePill(keyFor(location.pathname), false));

      // Expose the header height (it grows when the live bar shows) for sticky elements.
      const hdr = document.querySelector<HTMLElement>('header.top');
      if (hdr) new ResizeObserver(() => document.documentElement.style.setProperty('--hdr', `${hdr.offsetHeight}px`)).observe(hdr);

      // ---- Live bar ------------------------------------------------------
      // While the current event is on, show live scores (or what's next today)
      // under the menu on every page. The schedule is re-read every 30 seconds;
      // live scores come from PDC's live data every few seconds.
      (() => {
        const bar = document.getElementById('livebar');
        if (!bar) return;
        const inner = bar.querySelector<HTMLElement>('.lb-in')!;
        const { id, start = '', end = '', name = '' } = bar.dataset;
        const today = () => new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/London' });
        if (!(start <= today() && end >= today())) return;
        const esc = (x: unknown) => String(x ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
        const surname = (p: any) => p?.lastName || '';
        let feed: any[] | null = null, feedAt = 0;
        async function tick() {
          if (document.hidden) return;
          try {
            if (!feed || Date.now() - feedAt > 28_000) {
              const a = (await (await fetch(`https://tournaments.darts.web.gc.pdcservices.co.uk/v2/${id}`, { cache: 'no-store' })).json()).data.attributes;
              feed = (a.stages || []).flatMap((s: any) => (s.fixtures || []).map((f: any) => ({ ...f, stage: s.stage?.name, sets: (s.numberOfSets || 0) > 1 })))
                .filter((f: any) => f.participant1?.lastName && f.participant2?.lastName && !/to be confirmed/i.test(f.participant1.lastName + f.participant2.lastName));
              feedAt = Date.now();
            }
            const d = today();
            // Live scores laid over the schedule (the official result wins once it's in).
            const lv = await liveFor(id!, feed.filter((f: any) => f.startDate === d).map((f: any) => String(f.fixtureID)));
            const fx = feed.map((f: any) => {
              const m = lv.get(String(f.fixtureID));
              if (!m || m.status === 'upcoming' || /result/i.test(f.status)) return f;
              const [s1, s2] = liveScore(m, f.sets);
              return { ...f, participant1Score: s1, participant2Score: s2, status: m.status === 'live' ? 'Live' : 'Result' };
            });
            // The public feed only updates when a match finishes, so a match counts as
            // "on now" once its start time has passed and it has no result yet.
            const nowLdn = new Date().toLocaleTimeString('en-GB', { timeZone: 'Europe/London', hour: '2-digit', minute: '2-digit', hour12: false });
            const pending = fx.filter((f: any) => f.startDate === d && !/result/i.test(f.status)).sort((x: any, y: any) => (x.startTime || '').localeCompare(y.startTime || ''));
            const live = fx.filter((f: any) => /live|progress/i.test(f.status)).concat(pending.filter((f: any) => !/live|progress/i.test(f.status) && (f.startTime || '99').slice(0, 5) <= nowLdn).slice(-1));
            const upcoming = pending.filter((f: any) => !live.includes(f));
            const done = fx.filter((f: any) => /result/i.test(f.status)).sort((x: any, y: any) => `${y.startDate}${y.startTime}`.localeCompare(`${x.startDate}${x.startTime}`));
            // Upcoming: "A v B" then the start time in its own pill, so a time never reads as a score.
            const chip = (f: any, kind: string) => kind === 'next'
              ? `<a class="lb-m next" href="/match?id=${f.fixtureID}"><span>${esc(surname(f.participant1))}</span><i class="lb-v">v</i><span>${esc(surname(f.participant2))}</span>${(f.startTime || '').slice(0, 5) ? `<time class="lb-t" aria-label="starts at ${esc(f.startTime.slice(0, 5))} UK time">${esc(f.startTime.slice(0, 5))}</time>` : ''}</a>`
              : `<a class="lb-m ${kind}" href="/match?id=${f.fixtureID}"><span>${esc(surname(f.participant1))}</span><b>${kind === 'now' && !/live|progress|result/i.test(f.status) ? 'v' : `${f.participant1Score ?? 0}–${f.participant2Score ?? 0}`}</b><span>${esc(surname(f.participant2))}</span></a>`;
            let html = '';
            const ln = document.getElementById('livenav') as HTMLAnchorElement | null;
            if (ln) {
              ln.hidden = !live.length;
              if (live.length) { ln.href = `/match?id=${live[0].fixtureID}`; ln.setAttribute('aria-label', `Live: ${surname(live[0].participant1)} v ${surname(live[0].participant2)}`); }
            }
            if (live.length) html = `<span class="lb-tag live">On now</span>${live.slice(0, 3).map((f: any) => chip(f, 'now')).join('')}${upcoming[0] ? `<span class="lb-sep">Next</span>${chip(upcoming[0], 'next')}` : ''}`;
            else if (upcoming.length) html = `<span class="lb-tag">Next</span>${chip(upcoming[0], 'next')}${done[0] ? `<span class="lb-sep">Latest</span>${chip(done[0], 'done')}` : ''}`;
            else if (done[0] && done[0].startDate === d) html = `<span class="lb-tag">Latest</span>${chip(done[0], 'done')}`;
            if (!html) { bar.hidden = true; if (ln) ln.hidden = true; return; }
            inner.innerHTML = `<a class="lb-ev" href="/tournament/${id}">${esc(name)}</a>${html}`;
            bar.hidden = false;
          } catch { /* keep the last state */ }
        }
        tick();
        setInterval(tick, LIVE_TICK);
        document.addEventListener('visibilitychange', () => { if (!document.hidden) tick(); });
      })();

      // ---- Search (⌘K / Ctrl+K) ------------------------------------------
      let index: any[] | null = null;
      const kind: Record<string, string> = { p: 'Player', e: 'Event', n: 'News' };
      function openSearch() {
        const dlg = document.getElementById('search') as HTMLDialogElement;
        const q = document.getElementById('sq') as HTMLInputElement;
        if (!dlg.open) dlg.showModal();
        q.value = ''; render('');
        q.focus();
        if (!index) fetch('/search.json').then(r => r.json()).then(d => { index = d; render(q.value); });
      }
      function render(v: string) {
        const ul = document.getElementById('sr')!;
        const esc = (x: unknown) => String(x ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
        const terms = v.trim().toLowerCase().split(/\s+/).filter(Boolean);
        if (!index) { ul.innerHTML = '<li class="s-empty">Loading…</li>'; return; }
        if (!terms.length) { ul.innerHTML = '<li class="s-empty">Try a player (“Littler”), an event (“Matchplay”) or a city.</li>'; return; }
        const hits = index.filter(x => terms.every(t => x.k.includes(t)))
          .map(x => ({ x, r: 'pen'.indexOf(x.t) * 10 + (x.k.split(/\s+/).some((w: string) => w.startsWith(terms[0])) ? 0 : 5) }))
          .sort((a, b) => a.r - b.r).map(({ x }) => x).slice(0, 12);
        ul.innerHTML = hits.length ? hits.map((x, i) => `<li role="option" aria-selected="${i === 0}"><a href="${x.u}"><span class="s-k s-${x.t}">${kind[x.t]}</span><span class="s-t"><span class="s-n">${x.c ? `<img class="flag" src="/flags/${String(x.c).toLowerCase()}.svg" alt="" width="16" height="12"> ` : ''}${esc(x.n)}</span><span class="s-s">${esc(x.s)}</span></span></a></li>`).join('') : '<li class="s-empty">No matches.</li>';
      }
      document.addEventListener('click', e => {
        const t = e.target as HTMLElement;
        if (t.closest('[data-open-search]')) { e.preventDefault(); openSearch(); }
        const dlg = document.getElementById('search') as HTMLDialogElement;
        if (t === dlg || t.closest('[data-close-search]')) dlg.close();
        if (t.closest('#sr a')) dlg.close();
      });
      document.addEventListener('keydown', e => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); openSearch(); }
        const dlg = document.getElementById('search') as HTMLDialogElement;
        if (!dlg?.open) return;
        const items = [...document.querySelectorAll<HTMLElement>('#sr li[role=option]')];
        const cur = items.findIndex(li => li.getAttribute('aria-selected') === 'true');
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          const n = Math.max(0, Math.min(items.length - 1, cur + (e.key === 'ArrowDown' ? 1 : -1)));
          items.forEach((li, i) => li.setAttribute('aria-selected', String(i === n)));
          items[n]?.scrollIntoView({ block: 'nearest' });
        }
        if (e.key === 'Enter' && items[cur]) { e.preventDefault(); items[cur].querySelector('a')!.click(); }
      });
      document.addEventListener('input', e => { if ((e.target as HTMLElement).id === 'sq') render((e.target as HTMLInputElement).value); });
    </script>
  </body>
</html>

<style>
  .top { position: sticky; top: 0; z-index: 50; background: var(--ink); color: #fff; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 68px; }
  .brand { display: inline-flex; text-decoration: none; }
  nav { position: relative; display: flex; gap: 2px; padding: 4px; border-radius: 999px; }
  .nav { position: relative; z-index: 1; padding: 10px 18px; border-radius: 999px; text-decoration: none; font-weight: 600; font-size: 14px; color: #fff; transition: color .3s; }
  .nav:hover { color: var(--volt); }
  .nav.on { color: var(--ink); font-weight: 800; }
  .pill { position: absolute; z-index: 0; left: 0; top: 4px; bottom: 4px; border-radius: 999px; background: var(--volt); opacity: 0; transition: transform .55s var(--spring), width .55s var(--spring), opacity .2s; }
  .nav { transition: color .3s .1s; }
  .searchbtn { display: inline-flex; align-items: center; gap: 8px; border: 0; background: var(--ink-3); color: var(--on-ink); border-radius: 999px; padding: 11px 12px 11px 16px; font-weight: 600; font-size: 14px; cursor: pointer; transition: color .2s, background .2s; }
  .searchbtn:hover { color: #fff; background: var(--ink-2); }
  .searchbtn kbd { font: inherit; font-size: 11px; background: var(--ink); border: 1px solid var(--ink-2); border-radius: 6px; padding: 1px 6px; }

  .livebar { background: var(--ink); color: #fff; border-top: 1px solid var(--ink-2); }
  .lb-in { display: flex; align-items: center; gap: 10px; height: 40px; overflow-x: auto; scrollbar-width: none; font-size: 13px; white-space: nowrap; }
  .lb-in :global(.lb-ev) { color: #fff; font-weight: 800; text-decoration: none; margin-right: 4px; }
  .lb-in :global(.lb-tag) { font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; background: rgba(255, 255, 255, .14); border-radius: 999px; padding: 2px 8px; }
  .lb-in :global(.lb-tag.live) { background: var(--red); }
  .lb-in :global(.lb-sep) { color: rgba(255, 255, 255, .55); font-size: 12px; margin-left: 6px; }
  .lb-in :global(.lb-m) { display: inline-flex; align-items: center; gap: 8px; color: rgba(255, 255, 255, .85); text-decoration: none; padding: 4px 10px; border-radius: 999px; transition: background .2s; }
  .lb-in :global(.lb-m:hover) { background: rgba(255, 255, 255, .1); color: #fff; }
  .lb-in :global(.lb-m b) { font-family: var(--poster); font-weight: 400; font-size: 17px; font-variant-numeric: tabular-nums; color: #fff; }
  .lb-in :global(.lb-m.now b) { color: var(--volt); }
  .lb-in :global(.lb-v) { font-style: normal; color: rgba(255, 255, 255, .5); font-size: 12px; }
  .lb-in :global(.lb-t) { font-size: 11px; font-weight: 800; letter-spacing: .04em; color: rgba(255, 255, 255, .85); border: 1px solid rgba(255, 255, 255, .25); border-radius: 6px; padding: 1px 6px; font-variant-numeric: tabular-nums; }
  /* LIVE in the menu while a match is on */
  .livenav { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 7px; margin-left: 6px; padding: 8px 14px; border-radius: 999px; background: var(--red); color: #fff; text-decoration: none; font-weight: 800; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; transition: background .2s; }
  .livenav:hover { background: #ff4a3d; }
  .livenav[hidden] { display: none; }
  .ln-dot { width: 7px; height: 7px; border-radius: 50%; background: #fff; animation: lnblink 1.4s ease-in-out infinite; }
  @keyframes lnblink { 50% { opacity: .25; } }
  @media (prefers-reduced-motion: reduce) { .ln-dot { animation: none; } }

  .tabbar { display: none; }

  .search { border: 0; padding: 0; width: min(620px, 100% - 24px); margin-top: 12vh; border-radius: 20px; background: var(--card); color: var(--ink); box-shadow: var(--shadow-lg); }
  .search::backdrop { background: rgba(20, 22, 31, .5); }
  .s-box { display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-bottom: 1px solid var(--line); color: var(--muted); }
  .s-box input { flex: 1; border: 0; outline: 0; font: inherit; font-size: 17px; background: none; color: var(--ink); }
  .s-close { border: 1px solid var(--line); background: var(--paper-2); border-radius: 6px; font-size: 12px; padding: 2px 8px; cursor: pointer; }
  .s-res { list-style: none; margin: 0; padding: 6px; max-height: 56vh; overflow-y: auto; }
  .s-res :global(li a) { display: grid; grid-template-columns: 64px 1fr; align-items: center; gap: 10px; padding: 10px; border-radius: 12px; text-decoration: none; }
  .s-res :global(li[aria-selected='true'] a), .s-res :global(li a:hover) { background: var(--paper-2); }
  .s-res :global(.s-k) { font-size: 11px; font-weight: 800; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }
  .s-res :global(.s-n) { font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .s-res :global(.s-t) { display: flex; flex-direction: column; min-width: 0; }
  .s-res :global(.s-s) { font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .s-res :global(.s-empty) { padding: 18px; color: var(--muted); font-size: 14px; }

  main { min-height: 70vh; }
