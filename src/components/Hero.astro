---
// Homepage hero: a floodlit "stage" featuring the players in the current (or
// next) tournament as cut-outs in front of giant event lettering, plus a
// scrolling results ticker. Everything is chosen from the generated data.
import calendar from '../data/calendar.json';
import data from '../data/tournament.json';
import rankings from '../data/rankings.json';
import cutouts from '../data/cutouts.json';
import { keyName, flag, tvBadge } from '../lib/pdc.mjs';
import { dateRange } from '../lib/format.mjs';

const cut = cutouts as Record<string, string>;
const today = new Date().toISOString().slice(0, 10);
const t = data.tournament;
const daysTo = (d: string) => Math.round((Date.parse(d) - Date.parse(today)) / 864e5);
const rankOf = new Map(rankings.players.map(p => [p.id, p.pos]));

type Mode = 'live' | 'soon' | 'champion' | 'next';
let mode: Mode;
let ev: { id: string; name: string; tag: string | null; start: string; end: string; venue: string | null; city: string | null; broadcaster: string | null };
let ids: string[] = [];

const field = [...new Set(t.stages.flatMap(s => s.fixtures.flatMap(f => [f.p1?.id, f.p2?.id]).filter(Boolean) as string[]))];
if (t.start <= today && t.end >= today) mode = 'live';
else if (t.start > today && daysTo(t.start) <= 3) mode = 'soon';
else if (t.end < today && daysTo(t.end) >= -2 && t.winner) mode = 'champion';
else mode = 'next';

if (mode === 'next') {
  const n = calendar.events.find(e => e.start > today) || calendar.events[calendar.events.length - 1];
  ev = { ...n, broadcaster: n.broadcaster };
  ids = rankings.players.map(p => p.id);
} else {
  ev = { id: t.id, name: t.name, tag: t.tag, start: t.start, end: t.end, venue: t.venue, city: t.city, broadcaster: t.broadcaster };
  ids = field.sort((a, b) => (rankOf.get(a) ?? 999) - (rankOf.get(b) ?? 999));
  if (mode === 'champion' && t.winner) ids = [t.winner.id, ...ids.filter(i => i !== t.winner!.id)];
}

const byId = new Map(rankings.players.map(p => [p.id, p]));
const nameFor = (id: string) => byId.get(id)?.name || t.stages.flatMap(s => s.fixtures.flatMap(f => [f.p1, f.p2])).find(p => p?.id === id)?.name || '';
const stars = ids
  .map(id => ({ id, name: nameFor(id), rank: rankOf.get(id) ?? null, country: byId.get(id)?.country ?? null }))
  .filter(p => p.name && cut[keyName(p.name)])
  .slice(0, 3)
  .map(p => ({ ...p, img: cut[keyName(p.name)] }));
// Visual order: #1 in the middle, #2 left, #3 right.
const order = stars.length === 3 ? [stars[1], stars[0], stars[2]] : stars;

const results = t.stages.flatMap(s => s.fixtures.map(f => ({ ...f, stage: s.name })))
  .filter(f => f.status === 'result' && f.p1 && f.p2)
  .sort((a, b) => `${b.date}${b.time}`.localeCompare(`${a.date}${a.time}`))
  .slice(0, 14);
const upcoming = t.stages.flatMap(s => s.fixtures).filter(f => f.status !== 'result' && f.p1 && f.p2)
  .sort((a, b) => `${a.date}${a.time}`.localeCompare(`${b.date}${b.time}`)).slice(0, 10);
const short = (n: string) => n.split(' ').slice(-1)[0];
const ticker = mode === 'next' ? [] : results.length
  ? results.map(f => ({ a: short(f.p1!.name), b: short(f.p2!.name), s: `${f.s1}–${f.s2}`, aw: f.winner === f.p1!.id, bw: f.winner === f.p2!.id }))
  : upcoming.map(f => ({ a: short(f.p1!.name), b: short(f.p2!.name), s: f.time || 'vs', aw: false, bw: false }));

const big = ev.name.replace(/ of Darts$| Darts$/i, '').toUpperCase();
const place = ev.venue && ev.city && ev.venue.includes(ev.city) ? ev.venue : [ev.venue, ev.city].filter(Boolean).join(', ');
const label = { live: 'Live now', soon: 'Starts soon', champion: 'Champion crowned', next: 'Next up' }[mode];
---
<section class="stage-wrap wrap" aria-labelledby="hero-title">
  <div class="stage" data-mode={mode} data-start={ev.start} data-end={ev.end}>
    <div class="lights" aria-hidden="true"><span class="beam b1"></span><span class="beam b2"></span><span class="glow"></span></div>
    <svg class="rings" viewBox="-100 -100 200 200" aria-hidden="true">
      <circle r="96" /><circle r="78" /><circle r="62" /><circle r="40" /><circle r="14" />
    </svg>
    <div class="bigword" aria-hidden="true"><span>{big}</span><span>{big}</span></div>

    <div class="copy">
      <p class="kicker">
        <span class:list={['state', { live: mode === 'live' }]} data-state>{label}</span>
        {ev.broadcaster && <Fragment set:html={tvBadge(ev.broadcaster)} />}
      </p>
      <h1 id="hero-title">{ev.name}{ev.tag && <small>{ev.tag}</small>}</h1>
      <p class="meta">{dateRange(ev.start, ev.end)}{place && <> · {place}</>}</p>
      {mode === 'champion' && t.winner && <p class="champ">🏆 {t.winner.name} wins the {t.name}</p>}
      <div class="ctas">
        {mode === 'next'
          ? <div class="count" data-count={ev.start}>{['d', 'h', 'm'].map(u => <div><b data-u={u}>–</b><span>{{ d: 'days', h: 'hrs', m: 'mins' }[u]}</span></div>)}</div>
          : <a class="cta" href="/matches">{mode === 'champion' ? 'See the results' : 'Follow the matches'} <span aria-hidden="true">→</span></a>}
        <a class="ghost" href="#months">Full calendar <span aria-hidden="true">↓</span></a>
      </div>
    </div>

    <div class:list={['players', `n${order.length}`]}>
      {order.map((p, i) => (
        <a href="/rankings" class:list={['player', { lead: p.id === stars[0]?.id }]} style={`--i:${i}`}>
          <img src={p.img} alt={p.name} width="600" height="800" fetchpriority={i === 1 ? 'high' : 'auto'} />
          <span class="tagline">
            {mode === 'champion' && p.id === t.winner?.id ? <b class="rk gold">Champion</b> : p.rank && <b class="rk">#{p.rank}</b>}
            <span>{flag(p.country)} {p.name}</span>
          </span>
        </a>
      ))}
    </div>

    {ticker.length > 0 && (
      <div class="ticker" aria-label={results.length ? 'Latest results' : 'Coming up'}>
        <span class="tk-label">{results.length ? 'Results' : 'Order of play'}</span>
        <div class="tk-track">
          <div class="tk-run">
            {[...ticker, ...ticker].map(r => (
              <span class="tk-item"><span class:list={{ w: r.aw }}>{r.a}</span><b>{r.s}</b><span class:list={{ w: r.bw }}>{r.b}</span></span>
            ))}
          </div>
        </div>
      </div>
    )}
  </div>
</section>

<script>
  function init() {
    const stage = document.querySelector<HTMLElement>('.stage');
    if (!stage) return;
    // Correct the label if the page was built before the event started/ended.
    const today = new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/London' });
    const { start = '', end = '', mode } = stage.dataset;
    const st = stage.querySelector<HTMLElement>('[data-state]');
    if (st && mode !== 'champion') {
      if (start <= today && end >= today) { st.textContent = 'Live now'; st.classList.add('live'); }
      else if (end < today) { st.textContent = 'Latest event'; st.classList.remove('live'); }
    }
    // Countdown (next-event mode)
    const count = stage.querySelector<HTMLElement>('[data-count]');
    if (count) {
      const target = Date.parse(count.dataset.count + 'T12:00:00Z');
      const tick = () => {
        const s = Math.max(0, (target - Date.now()) / 1000);
        const v: Record<string, number> = { d: Math.floor(s / 86400), h: Math.floor(s / 3600) % 24, m: Math.floor(s / 60) % 60 };
        count.querySelectorAll<HTMLElement>('[data-u]').forEach(el => { el.textContent = String(v[el.dataset.u!]).padStart(2, '0'); });
      };
      tick(); setInterval(tick, 30_000);
    }
    // Gentle pointer parallax
    if (matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      stage.addEventListener('pointermove', e => {
        const r = stage.getBoundingClientRect();
        stage.style.setProperty('--px', String((e.clientX - r.left) / r.width - 0.5));
        stage.style.setProperty('--py', String((e.clientY - r.top) / r.height - 0.5));
      });
      stage.addEventListener('pointerleave', () => { stage.style.setProperty('--px', '0'); stage.style.setProperty('--py', '0'); });
    }
    requestAnimationFrame(() => stage.classList.add('ready'));
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .stage-wrap { padding-top: 22px; }
  .stage {
    --px: 0; --py: 0;
    position: relative; overflow: hidden; isolation: isolate;
    min-height: 560px; border-radius: 30px; color: #fff;
    background:
      radial-gradient(120% 90% at 75% 110%, #2a1420 0%, transparent 55%),
      radial-gradient(90% 80% at 10% -10%, #10261f 0%, transparent 60%),
      linear-gradient(160deg, #191b26, #0d0e14 70%);
    box-shadow: var(--shadow-lg);
    display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
  }
  /* floodlights */
  .lights { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .beam { position: absolute; top: -20%; width: 46%; height: 140%; background: linear-gradient(180deg, rgba(255, 240, 210, .22), transparent 70%); filter: blur(18px); transform-origin: top center; opacity: 0; transition: opacity 1.4s var(--ease); }
  .b1 { left: 38%; transform: rotate(18deg); animation: sway 9s ease-in-out infinite alternate; }
  .b2 { left: 64%; transform: rotate(-16deg); animation: sway 11s ease-in-out infinite alternate-reverse; }
  .ready .beam { opacity: 1; }
  @keyframes sway { from { rotate: -4deg; } to { rotate: 5deg; } }
  .glow { position: absolute; right: 8%; bottom: -30%; width: 60%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgba(215, 38, 61, .45), transparent 65%); filter: blur(10px); }
  .rings { position: absolute; z-index: -1; right: -6%; top: 50%; width: 70%; translate: calc(var(--px) * -14px) calc(-50% + var(--py) * -10px); fill: none; stroke: rgba(255, 255, 255, .07); stroke-width: 1.2; animation: spin 140s linear infinite; }
  .rings circle:nth-child(2) { stroke: rgba(14, 138, 95, .35); stroke-width: 5; stroke-dasharray: 12 12; }
  .rings circle:nth-child(4) { stroke: rgba(215, 38, 61, .35); stroke-width: 4; stroke-dasharray: 12 12; }
  @keyframes spin { to { rotate: 360deg; } }

  /* giant event lettering behind the players */
  .bigword { position: absolute; z-index: -1; left: 0; right: 0; bottom: 30%; display: flex; white-space: nowrap; pointer-events: none; translate: calc(var(--px) * 18px) 0; }
  .bigword span { font-family: var(--display); font-weight: 800; font-size: clamp(110px, 17vw, 230px); letter-spacing: -.05em; line-height: .8; padding-right: .4em; color: transparent; -webkit-text-stroke: 1.5px rgba(255, 255, 255, .24); animation: drift 38s linear infinite; }
  @keyframes drift { to { transform: translateX(-100%); } }

  .copy { position: relative; z-index: 3; padding: 56px 0 96px 52px; display: flex; flex-direction: column; justify-content: center; }
  .kicker { display: flex; align-items: center; gap: 12px; margin: 0 0 18px; }
  .state { font-size: 12px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: #f1c96b; display: inline-flex; align-items: center; gap: 8px; }
  .state.live { color: #ff6b7d; }
  .state.live::before { content: ''; width: 9px; height: 9px; border-radius: 50%; background: #ff4d63; animation: pulse 1.6s infinite; }
  .kicker :global(.tv) { box-shadow: none; }
  h1 { font-size: clamp(42px, 5.6vw, 76px); font-weight: 800; letter-spacing: -.04em; line-height: .95; max-width: 9ch; }
  h1 small { display: block; font-size: .32em; letter-spacing: 0; color: rgba(255, 255, 255, .6); margin-top: 10px; font-weight: 600; }
  .meta { color: rgba(255, 255, 255, .7); margin: 18px 0 0; font-size: 16px; }
  .champ { margin: 14px 0 0; font-weight: 700; color: #f1c96b; }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 28px; }
  .cta { display: inline-flex; gap: 10px; align-items: center; background: var(--red); color: #fff; padding: 14px 22px; border-radius: 999px; font-weight: 700; text-decoration: none; box-shadow: 0 12px 30px -10px rgba(215, 38, 61, .8); transition: transform .3s var(--spring), box-shadow .3s; }
  .cta:hover { transform: translateY(-2px); box-shadow: 0 18px 36px -10px rgba(215, 38, 61, .9); }
  .cta span { transition: transform .3s var(--spring); }
  .cta:hover span { transform: translateX(4px); }
  .ghost { color: #fff; text-decoration: none; font-weight: 600; padding: 13px 18px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, .22); transition: background .2s; }
  .ghost:hover { background: rgba(255, 255, 255, .08); }
  .count { display: flex; gap: 8px; }
  .count div { background: rgba(255, 255, 255, .08); border: 1px solid rgba(255, 255, 255, .12); border-radius: 14px; padding: 8px 14px; text-align: center; min-width: 64px; }
  .count b { display: block; font-family: var(--display); font-size: 28px; }
  .count span { font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: rgba(255, 255, 255, .6); }

  /* player cut-outs */
  .players { position: relative; z-index: 2; display: flex; align-items: flex-end; justify-content: center; padding-right: 20px; translate: calc(var(--px) * 10px) calc(var(--py) * 6px); }
  .player { position: relative; display: block; flex: 0 0 auto; width: 42%; margin: 0 -9%; text-decoration: none; color: #fff; opacity: 0; transform: translateY(60px) scale(.96); filter: brightness(.82) saturate(.9); transition: opacity .9s var(--ease), transform 1.1s var(--ease), filter .4s; transition-delay: calc(var(--i) * 140ms + 150ms); }
  .player.lead { width: 54%; z-index: 2; filter: none; }
  .ready .player { opacity: 1; transform: none; }
  .player:hover { filter: none; z-index: 3; }
  .player img { width: 100%; height: auto; display: block; -webkit-mask-image: linear-gradient(180deg, #000 78%, transparent 99%); mask-image: linear-gradient(180deg, #000 78%, transparent 99%); filter: drop-shadow(0 20px 30px rgba(0, 0, 0, .55)); transition: transform .5s var(--spring); }
  .player:hover img { transform: translateY(-6px); }
  .tagline { position: absolute; left: 50%; bottom: 66px; translate: -50% 0; z-index: 2; transition: opacity .3s, translate .4s var(--spring); display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; background: rgba(13, 14, 20, .72); backdrop-filter: blur(8px); border: 1px solid rgba(255, 255, 255, .14); padding: 6px 12px 6px 6px; border-radius: 999px; font-size: 13px; font-weight: 600; }
  .player:not(.lead) .tagline { bottom: 110px; }
  .player:first-child:not(.lead) .tagline { translate: -86% 0; }
  .player:last-child:not(.lead) .tagline { translate: -12% 0; }
  .rk { background: #fff; color: var(--ink); border-radius: 999px; padding: 2px 8px; font-size: 12px; }
  .rk.gold { background: linear-gradient(135deg, #f1c96b, var(--gold)); }
  .players.n1 .player { width: 62%; }

  /* results ticker */
  .ticker { position: absolute; z-index: 4; left: 0; right: 0; bottom: 0; display: flex; align-items: center; height: 52px; background: rgba(8, 9, 13, .78); backdrop-filter: blur(10px); border-top: 1px solid rgba(255, 255, 255, .08); }
  .tk-label { flex: none; height: 100%; display: grid; place-items: center; padding: 0 18px; background: var(--red); font-size: 12px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .tk-track { overflow: hidden; flex: 1; -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent); mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent); }
  .tk-run { display: flex; width: max-content; animation: drift 60s linear infinite; }
  .ticker:hover .tk-run { animation-play-state: paused; }
  .tk-item { display: inline-flex; align-items: center; gap: 10px; padding: 0 26px; font-size: 14px; color: rgba(255, 255, 255, .6); border-right: 1px solid rgba(255, 255, 255, .1); }
  .tk-item b { font-family: var(--display); color: #fff; font-size: 16px; font-variant-numeric: tabular-nums; }
  .tk-item .w { color: #fff; font-weight: 700; }

  @media (max-width: 900px) {
    .stage { grid-template-columns: 1fr; min-height: 0; }
    .copy { padding: 36px 24px 8px; }
    h1 { max-width: none; }
    .players { height: 340px; padding: 0; margin-bottom: 52px; }
    .player { width: 42%; }
    .player.lead { width: 52%; }
    .tagline { bottom: 18px; font-size: 11px; }
    .bigword { bottom: 70px; }
    .rings { width: 120%; right: -40%; top: 70%; }
  }
  @media (max-width: 520px) {
    .players { height: 280px; }
    .player:not(.lead) .tagline { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bigword span, .tk-run, .rings, .beam { animation: none; }
  }
</style>
