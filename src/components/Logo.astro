---
// The Oche brand: a dartboard roundel with a dart in the bull, and a
// wordmark underlined by the oche itself (the throw line).
interface Props { size?: number; tone?: 'ink' | 'light'; markOnly?: boolean }
const { size = 36, tone = 'ink', markOnly = false } = Astro.props;
const segs = Array.from({ length: 20 }, (_, i) => i);
const step = (Math.PI * 2) / 20;
const arc = (r: number, a0: number, a1: number) => {
  const p = (a: number) => `${(32 + Math.cos(a) * r).toFixed(2)} ${(32 + Math.sin(a) * r).toFixed(2)}`;
  return `M${p(a0)} A${r} ${r} 0 0 1 ${p(a1)}`;
};
---
<span class:list={['logo', tone]} style={`--h:${size}px`}>
  <svg class="mark" viewBox="0 0 64 64" width={size} height={size} aria-hidden="true">
    <circle cx="32" cy="32" r="31" fill="#14161f" />
    <g fill="none" stroke-width="4.2">
      {segs.map(i => <path d={arc(25.5, -Math.PI / 2 - step / 2 + i * step + 0.02, -Math.PI / 2 + step / 2 + i * step - 0.02)} stroke={i % 2 ? '#0e8a5f' : '#d7263d'} />)}
    </g>
    <circle cx="32" cy="32" r="21" fill="#f3ead2" />
    <g fill="#1b1d26">
      {segs.filter(i => i % 2).map(i => <path d={`M32 32 L${(32 + Math.cos(-Math.PI / 2 - step / 2 + i * step) * 21).toFixed(2)} ${(32 + Math.sin(-Math.PI / 2 - step / 2 + i * step) * 21).toFixed(2)} A21 21 0 0 1 ${(32 + Math.cos(-Math.PI / 2 + step / 2 + i * step) * 21).toFixed(2)} ${(32 + Math.sin(-Math.PI / 2 + step / 2 + i * step) * 21).toFixed(2)}Z`} />)}
    </g>
    <circle cx="32" cy="32" r="6.5" fill="#0e8a5f" />
    <circle cx="32" cy="32" r="3" fill="#d7263d" />
    <g class="dart">
      <path d="M33 31 L46.5 17.5" stroke="#14161f" stroke-width="4.6" stroke-linecap="round" />
      <path d="M33 31 L46.5 17.5" stroke="#c9ced8" stroke-width="2.6" stroke-linecap="round" />
      <path d="M45 19 L49.5 14.5" stroke="#14161f" stroke-width="2" />
      <path d="M48 16 L60 5 L57.5 14 Z M48 16 L59 4.5 L50.5 7 Z" fill="#d7263d" stroke="#14161f" stroke-width="1.4" stroke-linejoin="round" />
    </g>
  </svg>
  {!markOnly && (
    <span class="word">
      <span class="the">The</span>
      <span class="oche">Oche</span>
    </span>
  )}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: calc(var(--h) * .28); line-height: 1; }
  .mark { flex: none; transition: transform .7s var(--spring); }
  .logo:hover .mark { transform: rotate(-14deg) scale(1.06); }
  .mark .dart { transform-origin: 33px 31px; }
  .logo:hover .dart { animation: wobble .6s var(--ease); }
  @keyframes wobble { 30% { transform: rotate(4deg); } 60% { transform: rotate(-2deg); } }
  .word { display: inline-flex; flex-direction: column; justify-content: center; }
  .the { font-family: var(--body); font-weight: 800; font-size: calc(var(--h) * .27); letter-spacing: .32em; text-transform: uppercase; color: var(--red); margin-bottom: calc(var(--h) * .02); padding-left: .1em; }
  .oche {
    position: relative; font-family: var(--display); font-weight: 800; font-size: calc(var(--h) * .74); letter-spacing: -.045em;
    color: var(--ink); padding-bottom: calc(var(--h) * .12);
  }
  /* the oche: the throw line, with a red toe-line edge */
  .oche::after {
    content: ''; position: absolute; left: 0; right: -.12em; bottom: 0; height: calc(var(--h) * .07); border-radius: 2px;
    background: linear-gradient(90deg, var(--ink) 0 82%, var(--red) 82% 100%);
  }
  .light .oche { color: #fff; }
  .light .oche::after { background: linear-gradient(90deg, #fff 0 82%, var(--red) 82% 100%); }
</style>
