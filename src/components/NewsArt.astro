---
// Cover photo for a news story (see src/lib/covers.ts for how it is chosen).
// One photo, or two side by side for a head-to-head. Faces stay in frame at
// every size because each photo is positioned on its detected face.
import { chooseCover } from '../lib/covers';

interface Props {
  story: { slug: string; headline: string; tags: string[]; players: string[]; image?: string; kind?: string };
  label?: string;
  class?: string;
  eager?: boolean;
}
const { story, label, class: cls = '', eager = false } = Astro.props;
const shots = chooseCover(story);
---
<div class:list={['art', cls, { split: shots.length > 1 }]}>
  {shots.map(s => <img src={s.src} alt={s.alt} style={`object-position:${s.focus}`} loading={eager ? 'eager' : 'lazy'} decoding="async" />)}
  {label && <span class="lbl">{label}</span>}
</div>
<style>
  .art { position: relative; overflow: hidden; display: flex; gap: 3px; background: var(--ink); }
  .art img { flex: 1; min-width: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease); }
  :global(a:hover) .art img { transform: scale(1.04); }
  .lbl { position: absolute; z-index: 1; left: 14px; top: 12px; background: var(--ink); color: #fff; font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; padding: 5px 10px; border-radius: 999px; }
  @media (prefers-reduced-motion: reduce) { .art img { transition: none; } }
</style>
