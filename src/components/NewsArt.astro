---
// Cover art for a news story: a unique dartboard-inspired composition seeded
// from the headline, with cut-outs of the players the story is about (from
// the licensed Wikimedia photos). Each cut-out is placed by its detected face
// position, so the face stays in frame at every card shape and screen size.
import cutouts from '../data/cutouts.json';
import faces from '../data/faces.json';
import { keyName } from '../lib/pdc.mjs';

interface Props { seed: string; label?: string; class?: string; players?: string[] }
const { seed, label, class: cls = '', players = [] } = Astro.props;
const cut = cutouts as Record<string, string>;
const face = faces as Record<string, { x: number; y: number; h: number }>;
const FACE_H = 0.3; // face height as a share of the cover's height
const FACE_Y = 0.4; // where the face centre sits, from the top
const cast = [...new Set(players.slice(0, 2).map(keyName))] // only the story's two main players
  .filter(k => cut[k] && face[k])
  .slice(0, 2)
  .map((k, i) => {
    const f = face[k];
    const scale = Math.max(1.1, FACE_H / f.h) * (i ? 0.92 : 1);
    return {
      src: cut[k], name: players.find(p => keyName(p) === k), lead: i === 0,
      style: `height:${(scale * 100).toFixed(1)}%;top:${((FACE_Y - f.y * scale) * 100).toFixed(1)}%;--fx:${(-f.x * 100).toFixed(1)}%`,
    };
  });
let h = 2166136261;
for (const c of seed) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
const rnd = () => ((h = Math.imul(h ^ (h >>> 15), 2246822507) ^ Math.imul(h ^ (h >>> 13), 3266489909)) >>> 0) / 4294967296;
const palettes = [
  ['#d7263d', '#0e8a5f', '#f3ead2', '#14161f'],
  ['#1d3fd6', '#d7263d', '#fbf1d4', '#14161f'],
  ['#0b8a8f', '#c99a1c', '#f4efe5', '#14161f'],
  ['#f05d23', '#14161f', '#fde8eb', '#0e8a5f'],
];
const [a, b, bg, ink] = palettes[Math.floor(rnd() * palettes.length)];
const cx = 260 + rnd() * 280, cy = 80 + rnd() * 200;
const rings = Array.from({ length: 6 }, (_, i) => ({ r: 60 + i * (34 + rnd() * 22), w: 6 + rnd() * 22, c: [a, b, ink][i % 3], dash: rnd() > 0.5 ? `${8 + rnd() * 40} ${6 + rnd() * 20}` : 'none', op: 0.25 + rnd() * 0.6 }));
const rot = Math.floor(rnd() * 360);
---
<div class={`art ${cls}`} aria-hidden="true">
  <svg viewBox="0 0 600 340" preserveAspectRatio="xMidYMid slice">
    <rect width="600" height="340" fill={bg} />
    <g transform={`rotate(${rot} ${cx} ${cy})`} fill="none">
      {rings.map(r => <circle cx={cx} cy={cy} r={r.r} stroke={r.c} stroke-width={r.w} stroke-dasharray={r.dash} opacity={r.op} />)}
    </g>
    <circle cx={cx} cy={cy} r="20" fill={b} />
    <circle cx={cx} cy={cy} r="8" fill={a} />
    <g opacity=".08" fill={ink}>{Array.from({ length: 40 }, (_, i) => <circle cx={(i * 53) % 600} cy={(i * 97) % 340} r="2" />)}</g>
  </svg>
  {cast.length > 0 && <span class="halo" />}
  {cast.slice().reverse().map(c => <img class:list={['cut', c.lead ? 'p1' : 'p2', { duo: cast.length > 1 }]} src={c.src} alt="" loading="lazy" decoding="async" style={c.style} />)}
  {label && <span class="lbl">{label}</span>}
</div>
<style>
  .art { position: relative; overflow: hidden; background: var(--paper-2); }
  .art svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; transition: transform 1.2s var(--ease); }
  .cut { position: absolute; left: var(--x, 68%); width: auto; max-width: none; translate: var(--fx) 0; filter: drop-shadow(0 14px 22px rgba(20, 22, 31, .35)); -webkit-mask-image: linear-gradient(180deg, #000 70%, transparent 98%), linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent); -webkit-mask-composite: source-in; mask-image: linear-gradient(180deg, #000 70%, transparent 98%), linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent); mask-composite: intersect; transition: transform .8s var(--ease); transform-origin: 50% 40%; }
  .cut.p1.duo { --x: 70%; }
  .cut.p2 { --x: 38%; filter: drop-shadow(0 14px 22px rgba(20, 22, 31, .35)) saturate(.85) brightness(.92); }
  .halo { position: absolute; right: 8%; top: 8%; width: 46%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgba(255, 255, 255, .7), transparent 65%); pointer-events: none; }
  :global(a:hover) .cut.p1, :global(.story:hover) .cut.p1 { transform: scale(1.04); }
  .lbl { position: absolute; left: 14px; bottom: 12px; background: rgba(20, 22, 31, .85); color: #fff; font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; padding: 5px 10px; border-radius: 999px; backdrop-filter: blur(4px); }
</style>
