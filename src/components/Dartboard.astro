---
// Decorative animated dartboard. Pure SVG, no external assets.
interface Props { size?: number; class?: string; spin?: boolean; dart?: boolean }
const { size = 420, class: cls = '', spin = true, dart = true } = Astro.props;
const segs = Array.from({ length: 20 }, (_, i) => i);
const R = 200;
const arc = (r1: number, r2: number, a0: number, a1: number) => {
  const p = (r: number, a: number) => `${(Math.cos(a) * r).toFixed(2)} ${(Math.sin(a) * r).toFixed(2)}`;
  return `M${p(r1, a0)} L${p(r2, a0)} A${r2} ${r2} 0 0 1 ${p(r2, a1)} L${p(r1, a1)} A${r1} ${r1} 0 0 0 ${p(r1, a0)}Z`;
};
const step = (Math.PI * 2) / 20;
const nums = [20, 1, 18, 4, 13, 6, 10, 15, 2, 17, 3, 19, 7, 16, 8, 11, 14, 9, 12, 5];
---
<div class={`board ${cls}`} style={`--s:${size}px`} aria-hidden="true">
  <svg viewBox="-230 -230 460 460" class={spin ? 'spin' : ''}>
    <circle r="228" fill="#14161f" />
    <g class="nums" font-family="var(--display)" font-size="17" font-weight="700" fill="#fbf8f2" text-anchor="middle" dominant-baseline="central">
      {nums.map((n, i) => {
        const a = -Math.PI / 2 + i * step;
        return <text x={(Math.cos(a) * 214).toFixed(1)} y={(Math.sin(a) * 214).toFixed(1)}>{n}</text>;
      })}
    </g>
    <g transform={`rotate(${-90 - 9})`}>
      {segs.map(i => {
        const a0 = i * step, a1 = (i + 1) * step;
        const even = i % 2 === 0;
        return (
          <g>
            <path d={arc(16, 112, a0, a1)} fill={even ? '#f3ead2' : '#1b1d26'} />
            <path d={arc(112, 124, a0, a1)} fill={even ? '#0e8a5f' : '#d7263d'} />
            <path d={arc(124, 186, a0, a1)} fill={even ? '#f3ead2' : '#1b1d26'} />
            <path d={arc(186, R, a0, a1)} fill={even ? '#0e8a5f' : '#d7263d'} />
          </g>
        );
      })}
    </g>
    <g stroke="#b9b2a0" stroke-width="1" fill="none" opacity=".7">
      <circle r="16" /><circle r="112" /><circle r="124" /><circle r="186" /><circle r={R} />
    </g>
    <circle r="16" fill="#0e8a5f" />
    <circle r="7" fill="#d7263d" />
  </svg>
  {dart && (
    <svg class="dart" viewBox="0 0 200 40">
      <defs>
        <linearGradient id="barrel" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#e9edf3" /><stop offset=".5" stop-color="#8b93a3" /><stop offset="1" stop-color="#4b5160" /></linearGradient>
      </defs>
      <path d="M0 20 L38 18.5 L38 21.5Z" fill="#9aa1ad" />
      <rect x="38" y="13" width="62" height="14" rx="6" fill="url(#barrel)" />
      <g stroke="#3d4250" stroke-width="1.2" opacity=".6">{[48, 54, 60, 66, 72, 78, 84, 90].map(x => <line x1={x} x2={x} y1="14" y2="26" />)}</g>
      <rect x="100" y="17" width="44" height="6" rx="3" fill="#2b2f3c" />
      <path d="M140 20 L196 2 L188 20 L196 38Z" fill="#d7263d" />
      <path d="M140 20 L196 2 L188 20Z" fill="#f05d23" opacity=".8" />
    </svg>
  )}
</div>

<style>
  .board { position: relative; width: var(--s); aspect-ratio: 1; }
  .board > svg:first-child { width: 100%; height: 100%; filter: drop-shadow(0 30px 50px rgba(20, 22, 31, .25)); }
  .spin { animation: spin 120s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .dart {
    position: absolute; width: 46%; left: 50%; top: 50%; transform-origin: 0 50%;
    transform: translate(-1%, -50%) rotate(-28deg);
    animation: throw 1.1s .35s cubic-bezier(.2, .9, .25, 1.05) both;
    filter: drop-shadow(6px 10px 8px rgba(20, 22, 31, .35));
  }
  @keyframes throw {
    0% { transform: translate(140%, -260%) rotate(-28deg) scale(1.4); opacity: 0; }
    60% { opacity: 1; }
    85% { transform: translate(-1%, -50%) rotate(-28deg) scale(1); }
    92% { transform: translate(-1%, -50%) rotate(-25deg); }
    100% { transform: translate(-1%, -50%) rotate(-28deg); }
  }
</style>
