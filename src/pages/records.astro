---
// Season records from every main-tour match with stats (data/stats-cache.json,
// filled by the daily players job): the best single-match numbers of the season.
import Layout from '../layouts/Layout.astro';
import statsCache from '../../data/stats-cache.json';
import results from '../../data/results-cache.json';
import rankings from '../data/rankings.json';
import { playPlayers } from '../lib/play-data';
import { cleanName } from '../lib/pdc.mjs';

type Side = [string, number, number, number, number, number, number, number, number];
const R = results as Record<string, any>;
const season = new Date().getFullYear();
const slugOf = new Map(rankings.players.map(p => [String(p.id), p.slug]));
// Player names and each match's date, score and stage from the tournament summaries.
const names = new Map<string, string>();
const fxInfo = new Map<string, { date: string; s: [number, number]; ids: [string, string]; stage: string }>();
for (const t of Object.values(R)) {
  for (const [id, n] of Object.entries(t.pn || {})) names.set(id, n as string);
  for (const f of t.fx || []) if (Array.isArray(f)) fxInfo.set(String(f[0]), { date: f[1], ids: [String(f[2]), String(f[3])], s: [f[4], f[5]], stage: f[7] });
}
for (const p of rankings.players) names.set(String(p.id), p.name);

interface Row { pid: string; opp: string; tid: string; fid: string; avg: number; f9: number | null; t80: number; hi: number; darts: number; date: string; score: string; stage: string }
const rows: Row[] = [];
for (const [fid, m] of Object.entries(statsCache as Record<string, { t: string; a: Side; b: Side }>)) {
  const t = R[m.t];
  if (!t || t.s !== season) continue;
  const info = fxInfo.get(fid);
  for (const [me, them] of [[m.a, m.b], [m.b, m.a]] as [Side, Side][]) {
    if (!me[2]) continue;
    const mine = info ? (info.ids[0] === me[0] ? 0 : 1) : 0;
    rows.push({ pid: me[0], opp: them[0], tid: m.t, fid, avg: (me[1] / me[2]) * 3, f9: me[4] ? (me[3] / me[4]) * 3 : null, t80: me[5], hi: me[8], darts: me[2],
      date: info?.date || t.e, score: info ? `${info.s[mine]}–${info.s[1 - mine]}` : '', stage: info?.stage || '' });
  }
}
const ev = (tid: string) => cleanName(R[tid]?.n || '').name.replace(/^European Tour \d+ - /, '');
// Averages need a decent sample: at least 30 darts (ten visits).
const topAvg = rows.filter(r => r.darts >= 30).sort((a, b) => b.avg - a.avg).slice(0, 12);
const topF9 = rows.filter(r => r.f9 && r.darts >= 30).sort((a, b) => b.f9! - a.f9!).slice(0, 8);
const top180 = [...rows].sort((a, b) => b.t80 - a.t80 || b.avg - a.avg).slice(0, 8);
const ton70 = rows.filter(r => r.hi === 170).sort((a, b) => b.date.localeCompare(a.date));
const count170 = new Map<string, number>();
for (const r of ton70) count170.set(r.pid, (count170.get(r.pid) || 0) + 1);
const kings170 = [...count170].sort((a, b) => b[1] - a[1]).slice(0, 5);
const nine = playPlayers(128).filter(p => p.nine > 0).sort((a, b) => b.nine - a.nine).slice(0, 10);
const matches = Object.values(statsCache as Record<string, { t: string }>).filter(m => R[m.t]?.s === season).length;
const total180 = rows.reduce((s, r) => s + r.t80, 0);

const who = (id: string) => names.get(id) || 'Unknown';
const link = (id: string) => (slugOf.get(id) ? `/players/${slugOf.get(id)}` : null);
const day = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
---
<Layout title="Records" description={`The ${season} PDC season's best: highest match averages, most 180s, every 170 checkout and the nine-dart club.`} active="stats">
  <section class="hero wrap">
    <span class="eyebrow">{season} season</span>
    <h1>The <span class="accent">record books.</span></h1>
    <p class="lede">The best single-match numbers of the season, from {matches.toLocaleString('en-GB')} main-tour matches with full stats. That's {total180.toLocaleString('en-GB')} maximums and counting.</p>
  </section>

  <section class="wrap rec">
    <article class="tile tile-ink big">
      <h2 class="lbl">Highest match averages</h2>
      <ol class="list">
        {topAvg.map((r, i) => (
          <li>
            <span class="n poster-num">{i + 1}</span>
            <span class="w">{link(r.pid) ? <a href={link(r.pid)!}>{who(r.pid)}</a> : who(r.pid)}<small>v {who(r.opp)} · {r.score} · {ev(r.tid)} {r.stage && `· ${r.stage}`} · {day(r.date)}</small></span>
            <a class="v poster-num" href={`/match?id=${r.fid}`}>{r.avg.toFixed(2)}</a>
          </li>
        ))}
      </ol>
    </article>

    <article class="tile tile-card">
      <h2 class="lbl">Most 180s in a match</h2>
      <ol class="list">
        {top180.map((r, i) => (
          <li><span class="n poster-num">{i + 1}</span><span class="w">{who(r.pid)}<small>v {who(r.opp)} · {ev(r.tid)}</small></span><a class="v poster-num" href={`/match?id=${r.fid}`}>{r.t80}</a></li>
        ))}
      </ol>
    </article>

    <article class="tile tile-card">
      <h2 class="lbl">Best first-nine average</h2>
      <ol class="list">
        {topF9.map((r, i) => (
          <li><span class="n poster-num">{i + 1}</span><span class="w">{who(r.pid)}<small>v {who(r.opp)} · {ev(r.tid)}</small></span><a class="v poster-num" href={`/match?id=${r.fid}`}>{r.f9!.toFixed(2)}</a></li>
        ))}
      </ol>
    </article>

    <article class="tile tile-volt">
      <h2 class="lbl">The 170 club · {ton70.length} this season</h2>
      <ol class="list">
        {kings170.map(([id, n], i) => (
          <li><span class="n poster-num">{i + 1}</span><span class="w">{link(id) ? <a href={link(id)!}>{who(id)}</a> : who(id)}</span><b class="v poster-num">{n}</b></li>
        ))}
      </ol>
      <p class="latest">Latest: {ton70.slice(0, 4).map(r => `${who(r.pid)} (${ev(r.tid)}, ${day(r.date)})`).join(' · ')}</p>
    </article>

    <article class="tile tile-card">
      <h2 class="lbl">Nine-dart club · career, televised and floor</h2>
      <ol class="list">
        {nine.map((p, i) => (
          <li><span class="n poster-num">{i + 1}</span><span class="w"><a href={`/players/${p.slug}`}>{p.name}</a></span><b class="v poster-num">{p.nine}</b></li>
        ))}
      </ol>
    </article>
  </section>
</Layout>

<style>
  .rec { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .rec .tile { padding: 22px 24px; }
  .rec .big { grid-row: span 2; }
  .lbl { margin-bottom: 12px; }
  .tile-ink .lbl { color: var(--volt); }
  .list { list-style: none; margin: 0; padding: 0; }
  .list li { display: grid; grid-template-columns: 34px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 9px 0; border-top: 1px solid var(--line); }
  .tile-ink .list li { border-color: rgba(255, 255, 255, .1); }
  .tile-volt .list li { border-color: rgba(11, 12, 16, .15); }
  .n { font-size: 24px; opacity: .6; }
  .w { font-weight: 700; min-width: 0; }
  .w a { text-decoration: none; }
  .w small { display: block; font-size: 12px; font-weight: 600; opacity: .7; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .v { font-size: 30px; text-decoration: none; }
  .tile-ink .v { color: var(--volt); }
  .latest { margin: 12px 0 0; font-size: 13px; font-weight: 600; }
  @media (max-width: 820px) { .rec { grid-template-columns: 1fr; } .rec .big { grid-row: auto; } }
</style>
