---
// One page per calendar event: the full schedule and results, rendered at
// build time when we have the data and kept up to date live from the PDC
// feed while the event is on.
import Layout from '../../layouts/Layout.astro';
import NewsArt from '../../components/NewsArt.astro';
import { getCollection } from 'astro:content';
import data from '../../data/tournament.json';
import calendar from '../../data/calendar.json';
import { tvBadge } from '../../lib/pdc.mjs';
import { dateRange, newsDate } from '../../lib/format.mjs';
import { matchDays, renderDay, renderTabs, progress, renderDraw, renderPrize } from '../../lib/render-matches.mjs';

export function getStaticPaths() {
  const seen = new Set<string>();
  const list: { params: { id: string }; props: { ev: any } }[] = [];
  const cur = data.tournament as any;
  for (const e of [cur, ...(calendar.events as any[])]) {
    if (!e || seen.has(e.id)) continue;
    seen.add(e.id);
    list.push({ params: { id: e.id }, props: { ev: e } });
  }
  return list;
}

const { ev } = Astro.props as { ev: any };
const isCurrent = ev.id === (data.tournament as any).id;
const t: any = isCurrent ? data.tournament : { ...ev, fullName: [ev.name, ev.tag].filter(Boolean).join(' '), stages: [] };
const place = t.venue && t.city && t.venue.includes(t.city) ? t.venue : [t.venue, t.city].filter(Boolean).join(', ');
const portraits = {};
const buildDay = new Date().toISOString().slice(0, 10);
const { days, def } = matchDays(t, buildDay);
const prog = progress(t);
const drawHtml = renderDraw(t);
const prizeHtml = renderPrize(t);
const hasFixtures = t.stages.some((s: any) => s.fixtures.some((f: any) => f.p1 && f.p2 && f.time));

// Stories about this event: tagged with its id, or (older reports) carrying the
// event's name as a tag and dated around it.
const shift = (d: string, n: number) => new Date(Date.parse(d) + n * 864e5).toISOString().slice(0, 10);
const news = (await getCollection('news')).map(n => n.data)
  .filter(n => n.tournament ? n.tournament === t.id : n.tags.some(tag => tag.toLowerCase() === String(t.name).toLowerCase()) && n.date.slice(0, 10) >= shift(t.start, -7) && n.date.slice(0, 10) <= shift(t.end, 3))
  .sort((a, b) => (b.kind === 'recap' ? 1 : 0) - (a.kind === 'recap' ? 1 : 0) || b.date.localeCompare(a.date));
---
<Layout title={`${t.fullName || t.name}`} description={`Full schedule, live scores and results from the ${t.fullName || t.name}.`} active={isCurrent ? 'matches' : 'calendar'}
  jsonld={{ '@context': 'https://schema.org', '@type': 'SportsEvent', name: t.fullName || t.name, sport: 'Darts', startDate: t.start, endDate: t.end, eventStatus: 'https://schema.org/EventScheduled',
    location: { '@type': 'Place', name: t.venue || t.city || 'TBC', address: t.city || undefined }, url: new URL(`/tournament/${t.id}`, Astro.site).href }}>
  <section class={`banner b-${t.broadcaster || 'none'}`}>
    <svg class="brings" viewBox="-100 -100 200 200" aria-hidden="true"><circle r="96" /><circle r="80" /><circle r="58" /><circle r="40" /><circle r="12" /></svg>
    <div class="wrap banner-in">
      <a class="back" href="/calendar">← Calendar</a>
      <span class="eyebrow" id="phase">{isCurrent ? 'Current tournament' : 'Tournament'}</span>
      <div class="title-row">
        <h1>{t.name}{t.tag && <span class="tagline"> {t.tag}</span>}</h1>
      </div>
      <div class="meta">
        {t.broadcaster && <Fragment set:html={tvBadge(t.broadcaster)} />}
        <span>{dateRange(t.start, t.end)}</span>
        {place && <span>· {place}</span>}
        <span class="live-dot" id="liveflag" hidden>Live updates</span>
      </div>
      <div class="bactions">
        {t.winner && <p class="champ" id="champ">🏆 Won by <b>{t.winner.name}</b></p>}
        <a class="newsbtn" href="#news" data-open-news>Tournament news <span>{news.length}</span></a>
        <a class="calbtn" href={`/tournament/${t.id}.ics`} download={`${t.name}.ics`}>＋ Add to calendar</a>
      </div>
      <div class="progress" id="prog" hidden={!prog.total}>
        <div class="pbar"><span id="pfill" style={`width:${prog.pct}%`}></span></div>
        <p><b id="pdone">{prog.done}</b> of <b id="ptotal">{prog.total}</b> matches played <span id="updated"></span></p>
      </div>
    </div>
  </section>

  <div class="wrap viewtabs" role="tablist" aria-label="Tournament sections">
    <button class="vt" role="tab" data-view="schedule" aria-selected="true">Schedule</button>
    <button class="vt" role="tab" data-view="draw" aria-selected="false" hidden={!drawHtml}>Draw</button>
    <button class="vt" role="tab" data-view="prize" aria-selected="false" hidden={!prizeHtml}>Prize money</button>
    <button class="vt" role="tab" data-view="news" aria-selected="false">News <span class="cnt">{news.length}</span></button>
  </div>

  <section class="wrap tnews" id="tnews" hidden>
    {news.length ? (
      <div class="tn-grid">
        {news.map(n => (
          <a class="tn card lift" href={`/news/${n.slug}`}>
            <NewsArt story={n} class="tn-art" sizes="(max-width: 760px) 100vw, 380px" label={n.kind === 'recap' ? 'Round-up' : undefined} />
            <div class="tn-copy"><time datetime={n.date}>{newsDate(n.date)}</time><h3>{n.headline}</h3><p>{n.standfirst}</p></div>
          </a>
        ))}
      </div>
    ) : <div class="empty"><h3>No stories yet</h3><p>Reports on this event appear here as the newsdesk publishes them.</p></div>}
  </section>

  <section class="wrap tdraw" id="tdraw" hidden set:html={drawHtml} />
  <section class="wrap tprize" id="tprize" hidden set:html={prizeHtml} />

  <section class="wrap" id="tschedule">
    <div class="days" id="days" role="group" aria-label="Choose a day" set:html={days.length ? renderTabs(days, def) : ''} />
    <div id="board" class="board" data-day={def} set:html={days.length ? renderDay(t, def, portraits) : '<div class="empty" id="loading"><span class="spinner"></span><h3>Loading the schedule…</h3></div>'} />
  </section>

  <script is:inline type="application/json" id="t-data" set:html={JSON.stringify({ t, portraits })}></script>

  <script>
    import { API, normaliseTournament, fixtureStatsUrl, slimStats, applyLive, onBreak } from '../../lib/pdc.mjs';
    import { liveFor, watchLive, unwatch, isPushing, currentLeg, LIVE_TICK, PUSH_TICK } from '../../lib/live-client.mjs';
    import { matchDays, renderDay, renderTabs, progress, fixtureRow, renderDraw } from '../../lib/render-matches.mjs';
    import { markFollowed } from '../../lib/follow.mjs';

    let poll: number | undefined;
    function init() {
      const board = document.getElementById('board');
      if (!board) { clearInterval(poll); return; }
      const { t: initial, portraits } = JSON.parse(document.getElementById('t-data')!.textContent!);
      const isComplete = initial.stages.length > 0 && initial.stages.every((s: any) => s.fixtures.every((f: any) => f.status === 'result'));
      let t = initial;
      // Averages and 180s come from each match's timeline; finished matches are fetched once.
      const statsCache = new Map<string, any>(initial.stages.flatMap((s: any) => s.fixtures).filter((f: any) => f.stats).map((f: any) => [f.id, f.stats]));
      const merge = () => t.stages.forEach((s: any) => s.fixtures.forEach((f: any) => { if (statsCache.has(f.id)) f.stats = statsCache.get(f.id); }));
      let loading = false;
      // Official stats are retried at most every two minutes per match until they appear.
      const triedAt = new Map<string, number>();
      async function loadStats() {
        if (loading) return; loading = true;
        try {
          const shown = new Set([...board!.querySelectorAll<HTMLElement>('.fx')].map(li => li.dataset.id));
          const want = t.stages.flatMap((s: any) => s.fixtures.map((f: any) => ({ f, stage: s.name, sets: s.sets })))
            // Official stats are fetched once per finished match; live matches use the live data instead.
            .filter(({ f }: any) => shown.has(f.id) && f.status !== 'upcoming' && !statsCache.has(f.id) && !(f.status === 'live' && f.statsLive) && Date.now() - (triedAt.get(f.id) || 0) > 120_000);
          want.forEach(({ f }: any) => triedAt.set(f.id, Date.now()));
          let i = 0;
          await Promise.all(Array.from({ length: 4 }, async () => {
            while (i < want.length) {
              const { f, stage, sets } = want[i++];
              try {
                const res = await fetch(fixtureStatsUrl(f.id), { cache: 'no-store' });
                const st = res.ok ? slimStats(await res.json()) : null;
                if (!st) continue;
                f.statsLive = false;
                statsCache.set(f.id, st); f.stats = st;
                const li = board!.querySelector<HTMLElement>(`.fx[data-id="${f.id}"]`);
                if (li) { const tmp = document.createElement('div'); tmp.innerHTML = fixtureRow({ ...f, stage, sets }, portraits).trim(); const n = tmp.firstElementChild as HTMLElement; n.classList.add('stats-in'); li.replaceWith(n); }
              } catch { /* stats are optional */ }
            }
          }));
          // No official stats yet: use the live figures until they arrive.
          const gaps = want.filter(({ f }: any) => !f.stats);
          if (gaps.length) {
            const lv = await liveFor(t.id, gaps.map(({ f }: any) => f.id));
            for (const { f, stage, sets } of gaps) {
              const m = lv.get(String(f.id));
              if (!m?.stats) continue;
              f.stats = m.stats; f.statsLive = true;
              const li = board!.querySelector<HTMLElement>(`.fx[data-id="${f.id}"]`);
              if (li) { const tmp = document.createElement('div'); tmp.innerHTML = fixtureRow({ ...f, stage, sets }, portraits).trim(); const n = tmp.firstElementChild as HTMLElement; n.classList.add('stats-in'); li.replaceWith(n); }
            }
          }
        } finally { loading = false; }
      }
      const today = new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/London' });
      let { days, def } = matchDays(t, today);
      let current = def;
      const live = t.start <= today && t.end >= today;
      document.getElementById('phase')!.textContent = live ? 'Tournament in progress' : t.end < today ? 'Completed' : 'Coming up';
      const empty = () => t.start > today
        ? `<div class="empty"><h3>The draw isn't out yet</h3><p>The full schedule appears here as soon as the PDC publishes the draw and order of play.</p></div>`
        : `<div class="empty"><h3>No matches published</h3><p>The PDC hasn't published fixtures for this event.</p></div>`;

      const paint = (animate = false) => {
        if (!days.length) { document.getElementById('days')!.innerHTML = ''; board.innerHTML = empty(); return; }
        const before = new Map([...board.querySelectorAll<HTMLElement>('.fx')].map(li => [li.dataset.id, li.dataset.sig]));
        document.getElementById('days')!.innerHTML = (days.length > 1 ? `<button class="day all${current === 'all' ? ' on' : ''}" data-day="all" aria-pressed="${current === 'all'}"><span>Every</span><b>All days</b></button>` : '') + renderTabs(days, current);
        board.innerHTML = current === 'all'
          ? days.map(d => `<div class="dayblock"><h2 class="dayhead">${new Date(d + 'T12:00:00Z').toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' })}</h2>${renderDay(t, d, portraits)}</div>`).join('')
          : renderDay(t, current, portraits);
        board.querySelectorAll<HTMLElement>('.stage').forEach(s => requestAnimationFrame(() => s.classList.add('in')));
        markFollowed(board);
        if (animate) board.querySelectorAll<HTMLElement>('.fx').forEach(li => { if (before.has(li.dataset.id) && before.get(li.dataset.id) !== li.dataset.sig) li.classList.add('flash'); });
        const draw = renderDraw(t);
        if (draw) { document.getElementById('tdraw')!.innerHTML = draw; (document.querySelector('.vt[data-view="draw"]') as HTMLElement).hidden = false; }
        const p = progress(t);
        document.getElementById('prog')!.hidden = !p.total;
        document.getElementById('pfill')!.style.width = p.pct + '%';
        document.getElementById('pdone')!.textContent = String(p.done);
        document.getElementById('ptotal')!.textContent = String(p.total);
        // Centre the selected day within the day strip only. (scrollIntoView also scrolled
        // the whole page back up to the strip on every live update.)
        const strip = document.getElementById('days'), on = strip?.querySelector<HTMLElement>('.on');
        if (strip && on && !animate) strip.scrollTo({ left: strip.scrollLeft + on.getBoundingClientRect().left - strip.getBoundingClientRect().left - (strip.clientWidth - on.offsetWidth) / 2 });
        loadStats();
      };
      document.getElementById('days')!.addEventListener('click', e => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-day]');
        if (!b) return;
        current = b.dataset.day!;
        paint();
      });
      paint();

      // Live refresh straight from the PDC feed while the event is on.
      const refresh = async () => {
        if (document.hidden) return;
        try {
          const res = await fetch(`${API.tournaments}${t.id}`, { cache: 'no-store' });
          if (!res.ok) return;
          t = normaliseTournament(await res.json());
          merge();
          liveSig = '';
          await liveTick().catch(() => {});
          ({ days } = matchDays(t, today));
          if (current !== 'all' && !days.includes(current)) current = matchDays(t, today).def;
          paint(true);
          if (live) document.getElementById('updated')!.textContent = `· updated ${new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })}`;
        } catch { /* keep showing the last good data */ }
      };
      // Live scores and averages from PDC's live data every few seconds; the
      // board only redraws when something changed.
      let liveSig = '', lastTick = 0;
      const liveTick = async () => {
        if (document.hidden) return;
        lastTick = Date.now();
        const ids = t.stages.flatMap((s: any) => s.fixtures).filter((f: any) => f.date === today && f.status !== 'result' || (f.date === today && !f.stats) || f.statsLive).map((f: any) => f.id);
        if (!ids.length) return;
        const lv = await liveFor(t.id, ids);
        // Matches under way: have PDC push every change to us.
        const inPlay = [...lv.values()].filter((m: any) => m.status === 'live').map((m: any) => String(m.id));
        if (inPlay.length) watchLive(t.id, inPlay, onPush);
        // The leg in play for each live match: what each player needs.
        const legs = new Map<string, any>();
        await Promise.all([...lv.values()].filter((m: any) => m.status === 'live').map(async (m: any) => {
          legs.set(String(m.id), await currentLeg(t.id, m).catch(() => null));
        }));
        const sig = JSON.stringify([...lv.values()].map((m: any) => [m.id, m.status, m.legs, m.sets, m.stats?.map((x: any) => x?.avg), legs.get(String(m.id))?.left, legs.get(String(m.id))?.throwing, onBreak(legs.get(String(m.id)))]));
        if (sig === liveSig) return;
        liveSig = sig;
        applyLive(t, lv);
        t.stages.forEach((s: any) => s.fixtures.forEach((f: any) => { f.legNow = f.status === 'live' ? legs.get(String(f.id)) || null : null; }));
        paint(true);
      };
      const onPush = () => { liveTick().catch(() => {}); };
      // Schedule / News tabs (#news opens the news tab).
      const tabs = document.querySelectorAll<HTMLButtonElement>('.vt');
      const show = (v: string) => {
        tabs.forEach(b => b.setAttribute('aria-selected', String(b.dataset.view === v)));
        for (const k of ['schedule', 'draw', 'prize', 'news']) document.getElementById(`t${k}`)!.hidden = v !== k;
      };
      tabs.forEach(b => b.addEventListener('click', () => { show(b.dataset.view!); history.replaceState(null, '', b.dataset.view === 'schedule' ? location.pathname : `#${b.dataset.view}`); }));
      if (['#news', '#draw', '#prize'].includes(location.hash)) show(location.hash.slice(1));
      document.querySelector('[data-open-news]')?.addEventListener('click', e => { e.preventDefault(); show('news'); history.replaceState(null, '', '#news'); document.querySelector('.viewtabs')!.scrollIntoView({ behavior: 'smooth', block: 'start' }); });

      clearInterval(poll);
      if (live) {
        document.getElementById('liveflag')!.hidden = false;
        refresh();
        let n = 0;
        // Polls only when push isn't running; otherwise a slow safety check. The schedule is re-read every ~30s.
        poll = window.setInterval(() => { if (++n % 4 === 0) refresh(); else if (!isPushing() || Date.now() - lastTick > PUSH_TICK) liveTick().catch(() => {}); }, LIVE_TICK);
        document.addEventListener('astro:before-swap', () => unwatch(onPush), { once: true });
      } else if (t.end >= today || !isComplete) refresh();
    }
    document.addEventListener('astro:page-load', init);
  </script>
</Layout>

<style>
  .banner {
    position: relative; color: #fff; overflow: hidden; isolation: isolate; padding: 28px 0 34px;
    background: var(--ink); border-top: 1px solid var(--ink-2);
  }
  .banner::before { content: ''; position: absolute; inset: 0; z-index: -2; background: radial-gradient(70% 120% at 85% 120%, var(--glow, rgba(215, 38, 61, .5)), transparent 60%), radial-gradient(60% 90% at 0% -20%, rgba(14, 138, 95, .35), transparent 60%); }
  .b-sky { --glow: rgba(43, 76, 255, .55); }
  .b-itv { --glow: rgba(11, 160, 160, .5); }
  .b-pdctv { --glow: rgba(215, 38, 61, .55); }
  .brings { position: absolute; z-index: -1; right: -8%; top: 50%; translate: 0 -50%; width: min(620px, 70vw); fill: none; stroke: rgba(255, 255, 255, .08); stroke-width: 1.2; }
  .brings circle:nth-child(2) { stroke: rgba(14, 138, 95, .4); stroke-width: 6; stroke-dasharray: 13 13; }
  .brings circle:nth-child(4) { stroke: rgba(215, 38, 61, .4); stroke-width: 5; stroke-dasharray: 10 10; }
  .back { display: block; width: fit-content; color: rgba(255, 255, 255, .7); text-decoration: none; font-weight: 600; font-size: 14px; margin-bottom: 18px; transition: color .2s, transform .3s var(--spring); }
  .back:hover { color: #fff; transform: translateX(-3px); }
  .banner .eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #ff6b7d; }
  .banner .eyebrow::before { content: ''; width: 22px; height: 2px; background: currentColor; border-radius: 2px; }
  .title-row { display: flex; align-items: center; gap: 18px; margin: 10px 0 12px; }
  .banner h1 { font-size: clamp(54px, 7vw, 104px); }
  .banner .meta { color: rgba(255, 255, 255, .78); }
  .bactions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 16px; }
  .newsbtn { display: inline-flex; align-items: center; gap: 8px; background: #fff; color: var(--ink); text-decoration: none; font-weight: 800; font-size: 14px; padding: 8px 8px 8px 16px; border-radius: 999px; transition: transform .3s var(--spring), box-shadow .3s; }
  .newsbtn:hover { transform: translateY(-2px); box-shadow: 0 10px 24px -10px rgba(0, 0, 0, .6); }
  .newsbtn span { background: var(--red); color: #fff; border-radius: 999px; padding: 2px 9px; font-size: 12px; }
  .viewtabs { scroll-margin-top: 80px; }
  .champ { margin: 0; display: inline-flex; gap: 6px; background: linear-gradient(135deg, #f1c96b, var(--gold)); color: #2b1f02; padding: 6px 14px; border-radius: 999px; font-size: 15px; }
  .banner .progress { margin-top: 22px; max-width: 520px; }
  .banner .pbar { background: rgba(255, 255, 255, .14); }
  .banner .progress p { color: rgba(255, 255, 255, .78); }
  .board { margin-bottom: 20px; }
  .viewtabs { display: flex; gap: 6px; margin-top: 18px; border-bottom: 1px solid var(--line); }
  .vt { border: 0; background: none; padding: 12px 16px; font-weight: 800; font-size: 15px; color: var(--muted); cursor: pointer; position: relative; display: inline-flex; align-items: center; gap: 8px; }
  .vt::after { content: ''; position: absolute; left: 10px; right: 10px; bottom: -1px; height: 3px; border-radius: 3px; background: var(--red); transform: scaleX(0); transition: transform .35s var(--spring); }
  .vt[aria-selected='true'] { color: var(--fg); }
  .vt[aria-selected='true']::after { transform: scaleX(1); }
  .cnt { font-size: 12px; background: var(--paper-2); border-radius: 999px; padding: 1px 8px; color: var(--fg-2); }
  .vt[aria-selected='true'] .cnt { background: var(--red); color: #fff; }
  .tnews { padding-top: 22px; }
  .tn-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 18px; }
  .tn { display: flex; flex-direction: column; overflow: hidden; text-decoration: none; }
  .tn :global(.tn-art) { aspect-ratio: 16 / 8; }
  .tn-copy { padding: 16px 18px 20px; display: flex; flex-direction: column; gap: 6px; }
  .tn time { font-size: 12px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--red-text); }
  .tn h3 { font-size: 19px; }
  .tn p { margin: 0; color: var(--muted); font-size: 14px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .days { margin-top: 14px; }
  .dayhead { font-size: 15px; font-family: var(--body); font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); display: flex; align-items: center; gap: 14px; margin-top: 34px; }
  .dayhead::after { content: ''; flex: 1; height: 1px; background: var(--line); }
  .board :global(.spinner) { display: inline-block; width: 26px; height: 26px; border-radius: 50%; border: 3px solid var(--line); border-top-color: var(--red); animation: spin .8s linear infinite; margin-bottom: 10px; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .tagline { color: var(--muted); font-size: .45em; letter-spacing: 0; }
  .calbtn { display: inline-flex; align-items: center; gap: 6px; color: #fff; text-decoration: none; font-weight: 800; font-size: 14px; padding: 8px 16px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, .3); }
  .calbtn:hover { background: rgba(255, 255, 255, .1); }
  /* Sessions in the schedule */
  .board :global(.session) { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin: 30px 0 4px; padding-bottom: 10px; border-bottom: 2px solid var(--ink); font-size: 14px; }
  .board :global(.session b) { font-family: var(--poster); font-weight: 400; font-size: 24px; text-transform: uppercase; }
  .board :global(.session span) { color: var(--muted); font-weight: 600; }
  .board :global(.session .s-tv) { margin-left: auto; }
  /* Knockout draw */
  .tdraw { padding-top: 22px; overflow-x: auto; }
  .tdraw :global(.draw) { display: grid; grid-template-columns: repeat(var(--cols), minmax(190px, 1fr)); gap: 18px; min-width: calc(var(--cols) * 200px); }
  .tdraw :global(.dr-col) { display: flex; flex-direction: column; }
  .tdraw :global(.dr-col h3) { font-size: 13px; font-family: var(--body); font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }
  .tdraw :global(.dr-list) { flex: 1; display: flex; flex-direction: column; justify-content: space-around; gap: 10px; }
  .tdraw :global(.dr-m) { display: block; background: var(--card); border-radius: 14px; box-shadow: var(--shadow-sm); text-decoration: none; overflow: hidden; }
  .tdraw :global(a.dr-m[href]:hover) { box-shadow: var(--shadow); }
  .tdraw :global(.dr-m.live) { box-shadow: 0 0 0 2px var(--red); }
