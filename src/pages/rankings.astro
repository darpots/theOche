---
import Layout from '../layouts/Layout.astro';
import data from '../data/rankings.json';
import portraitsRaw from '../data/portraits.json';
import { flag, countryName, age, keyName } from '../lib/pdc.mjs';
import { money, avatarColours, initials } from '../lib/format.mjs';

const portraits = Object.fromEntries(Object.entries(portraitsRaw as Record<string, { image: string }>).map(([k, v]) => [k, v.image]));
const prev = (data.previous || {}) as Record<string, number>;
// Top 128 shown; a few more are rendered hidden so the live race can promote them.
const players = data.players.filter(p => p.pos <= 150).map(p => ({ ...p, move: prev[p.id] ? prev[p.id] - p.pos : null }));
const max = players[0]?.money || 1;
const pic = (name: string) => portraits[keyName(name)];
const av = (name: string) => { const [c1, c2] = avatarColours(name); return `--c1:${c1};--c2:${c2}`; };
---
<Layout title="World Rankings" description="The PDC Order of Merit, with full player profiles, darts used and tournament history." active="rankings">
  <section class="hero wrap">
    <span class="eyebrow">PDC Order of Merit</span>
    <h1>World <span class="accent">Rankings</span></h1>
    <p class="lede">The top 128, ranked on prize money won over two years. Tap any player for their profile, season record and full tournament history.</p>
  </section>


  <section class="wrap">
    <div class="tools" data-reveal>
      <label class="search">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" /><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <input id="q" type="search" placeholder="Search players or countries" autocomplete="off" />
      </label>
      <div class="mode" id="mode" hidden role="group" aria-label="Ranking view">
        <button class="seg" data-mode="live" aria-pressed="true"><span class="ldot"></span>Live race</button>
        <button class="seg" data-mode="official" aria-pressed="false">Official</button>
      </div>
      <span class="muted small" id="asof">Top 128 · official PDC list</span>
    </div>
    <p class="race-note" id="raceNote" hidden></p>
    <div class="table card" role="table" aria-label="PDC World Rankings">
      <div class="tr th" role="row">
        <span role="columnheader">#</span><span role="columnheader">Player</span><span role="columnheader" class="hide-s">Country</span><span role="columnheader" class="hide-s">Age</span><span role="columnheader" class="r">Prize money</span>
      </div>
      {players.map(p => (
        <button class="tr clickable" role="row" data-player={p.id} hidden={p.pos > 128} data-search={`${p.name} ${p.nick || ''} ${countryName(p.country) || ''}`.toLowerCase()}>
          <span class="pos tabular" role="cell" data-pos={p.pos} data-move={p.move ?? ''}><b>{p.pos}</b>
            {p.move ? <i class={p.move > 0 ? 'up' : 'down'} title={`${p.move > 0 ? 'Up' : 'Down'} ${Math.abs(p.move)}`}>{p.move > 0 ? '▲' : '▼'}{Math.abs(p.move)}</i> : null}
          </span>
          <span class="who" role="cell">
            <span class="avatar" style={`--size:38px;${av(p.name)}`}>{pic(p.name) ? <img src={pic(p.name)} alt="" loading="lazy" /> : initials(p.name)}</span>
            <span><b>{p.name}</b>{p.nick && <small>{p.nick}</small>}</span>
          </span>
          <span class="hide-s" role="cell">{flag(p.country)} {countryName(p.country)}</span>
          <span class="hide-s tabular" role="cell">{age(p.dob) ?? '–'}</span>
          <span class="r money-cell" role="cell">
            <span class="tabular" data-money={p.money}>{money(p.money)}</span>
            <small class="delta" hidden></small>
            <span class="bar"><span style={`width:${(p.money / max) * 100}%`} /></span>
          </span>
        </button>
      ))}
    </div>
  </section>

  <dialog id="profile" aria-label="Player profile">
    <div class="sheet" id="sheet"></div>
  </dialog>

  <script is:inline type="application/json" id="r-data" set:html={JSON.stringify({ portraits })}></script>

  <script>
    import { API, normaliseRankings, flag, countryName, age, keyName, RANKED_TYPES, liveRace, previousEdition } from '../lib/pdc.mjs';
    import { money, avatarColours, initials } from '../lib/format.mjs';

    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    const cache = new Map<string, any>();

    function finishClass(label: string) {
      if (label === 'Winner') return 'f-win';
      if (label === 'Runner-up') return 'f-ru';
      if (/semi/i.test(label)) return 'f-sf';
      if (/quarter/i.test(label)) return 'f-qf';
      return '';
    }

    function render(p: any, portraits: Record<string, string>) {
      const [c1, c2] = avatarColours(p.name);
      const img = portraits[keyName(p.name)];
      const s = p.season;
      const winPct = s.played ? Math.round((s.won / s.played) * 100) : 0;
      const legPct = s.legsFor + s.legsAgainst ? Math.round((s.legsFor / (s.legsFor + s.legsAgainst)) * 100) : 0;
      const career = Object.entries(p.career || {}) as [string, number][];
      const groups = [
        { k: 'all', label: 'All' },
        { k: 'major', label: 'Majors', test: (h: any) => !h.tag && !/masters$|world series/i.test(h.name) },
        { k: 'ws', label: 'World Series', test: (h: any) => /masters$|world series/i.test(h.name) && !/^the masters$/i.test(h.name) },
        { k: 'et', label: 'European Tour', test: (h: any) => /^European Tour/.test(h.tag || '') },
      ];
      const titles = p.history.filter((h: any) => h.label === 'Winner').length;
      const finals = p.history.filter((h: any) => h.label === 'Winner' || h.label === 'Runner-up').length;
      const bySeason = new Map<number, any[]>();
      for (const h of p.history) { if (!bySeason.has(h.season)) bySeason.set(h.season, []); bySeason.get(h.season)!.push(h); }
      const fact = (k: string, v: unknown) => v ? `<div class="fact"><span>${k}</span><b>${esc(v)}</b></div>` : '';
      return `
        <button class="close" aria-label="Close profile" data-close>✕</button>
        <header class="ph">
          <span class="avatar" style="--size:112px;--c1:${c1};--c2:${c2}">${img ? `<img src="${img}" alt="">` : esc(initials(p.name))}</span>
          <div>
            <p class="ph-rank">World #${esc(p.rank)} ${p.tourCard ? '<span>Tour Card</span>' : ''}</p>
            <h2>${esc(p.name)}</h2>
            ${p.nick ? `<p class="ph-nick">“${esc(p.nick)}”</p>` : ''}
            <p class="ph-country">${flag(p.country)} ${esc(countryName(p.country) || '')}</p>
          </div>
        </header>
        <div class="facts">
          ${fact('Age', age(p.dob))}
          ${fact('Darts', p.darts)}
          ${fact('Hometown', p.hometown)}
          ${fact('Walk-on', p.walkOn)}
          ${fact('Throws', p.leftHanded ? 'Left-handed' : null)}
          ${fact('Started playing', p.started)}
          ${fact('Nine-darters', p.nineDarters)}
        </div>
        <section class="season">
          <h3>${s.year} season</h3>
          ${s.stats ? `<div class="avgcard">
            <div class="big"><span>Season average</span><b data-count="${s.stats.avg}">${s.stats.avg.toFixed(2)}</b><small>across ${s.stats.matches} matches</small></div>
            <div class="minis">
              <div><b>${s.stats.f9 != null ? s.stats.f9.toFixed(2) : '–'}</b><span>First 9 avg</span></div>
              <div><b>${s.stats.t80}</b><span>180s</span></div>
              <div><b>${s.stats.co != null ? s.stats.co.toFixed(1) + '%' : '–'}</b><span>Checkout</span></div>
              <div><b>${s.stats.hi ?? '–'}</b><span>Best finish</span></div>
            </div>
          </div>` : ''}
          <div class="stats">
            <div class="ring" style="--p:${winPct}"><svg viewBox="0 0 36 36"><circle cx="18" cy="18" r="15.9" class="bg"/><circle cx="18" cy="18" r="15.9" class="fg" style="stroke-dasharray:${winPct} 100"/></svg><b>${winPct}%</b><span>Matches won</span></div>
            <div class="ring alt" style="--p:${legPct}"><svg viewBox="0 0 36 36"><circle cx="18" cy="18" r="15.9" class="bg"/><circle cx="18" cy="18" r="15.9" class="fg" style="stroke-dasharray:${legPct} 100"/></svg><b>${legPct}%</b><span>Legs won</span></div>
            <div class="num"><b>${s.won}–${s.lost}</b><span>Win–loss</span></div>
            <div class="num"><b>${s.titles.length}</b><span>Titles in ${s.year}</span></div>
          </div>
          ${s.titles.length ? `<p class="titles">🏆 ${s.titles.map(esc).join(' · ')}</p>` : ''}
          <p class="note">Season record covers PDC main-tour events (majors, Premier League, World Series, European Tour and Players Championships). Leg counts exclude set-play matches. Averages are weighted by darts thrown and update daily.</p>
        </section>
        ${career.length ? `<section class="career"><h3>Career titles</h3><div class="bars">${career.map(([k, v]) => `<div><span>${esc(k.replace('Senior PDC Titles', 'All PDC titles'))}</span><i style="--w:${Math.min(100, (v / Math.max(...career.map(c => c[1]), 1)) * 100)}%"></i><b>${v}</b></div>`).join('')}</div></section>` : ''}
        <section class="history">
          <div class="hh"><h3>Tournament history</h3><p class="muted">${p.history.length} events · ${finals} finals · ${titles} titles</p></div>
          <div class="hfilter">${groups.map((g, i) => `<button class="chip" data-g="${g.k}" aria-pressed="${i === 0}">${g.label}</button>`).join('')}</div>
          <div class="seasons">
            ${p.history.length ? [...bySeason.entries()].map(([yr, list]) => `
              <div class="yr"><h4>${yr}</h4><ul>${list.map(h => `<li data-g="${groups.slice(1).filter(g => g.test!(h)).map(g => g.k).join(' ')}"><span class="ev">${esc(h.name)}${h.tag ? ` <small>${esc(h.tag)}</small>` : ''}</span><span class="hr">${h.avg ? `<i class="havg" title="Three-dart average">${h.avg.toFixed(2)}</i>` : ''}<span class="fin ${finishClass(h.label)}">${esc(h.label)}</span></span></li>`).join('')}</ul></div>`).join('')
              : '<p class="muted">No major, World Series or European Tour appearances recorded yet.</p>'}
          </div>
        </section>
        <p class="src muted">Data: PDC. <a href="https://www.pdc.tv/players/${esc(p.slug)}" target="_blank" rel="noopener">Official PDC profile ↗</a></p>`;
    }

    function init() {
      const dlg = document.getElementById('profile') as HTMLDialogElement | null;
      if (!dlg) return;
      const sheet = document.getElementById('sheet')!;
      const { portraits } = JSON.parse(document.getElementById('r-data')!.textContent!);

      const open = async (id: string, rank: string) => {
        sheet.innerHTML = '<div class="loading"><span class="spinner"></span>Loading profile…</div>';
        dlg.showModal();
        try {
          if (!cache.has(id)) {
            const res = await fetch(`/data/players/${id}.json`);
            if (!res.ok) throw new Error();
            cache.set(id, await res.json());
          }
          sheet.innerHTML = render({ ...cache.get(id), rank }, portraits);
          sheet.querySelectorAll<HTMLElement>('.bars i').forEach((el, i) => setTimeout(() => el.classList.add('go'), 150 + i * 80));
          sheet.querySelectorAll<HTMLElement>('.ring').forEach(el => requestAnimationFrame(() => el.classList.add('go')));
          sheet.querySelectorAll<HTMLElement>('[data-count]').forEach(el => {
            const end = Number(el.dataset.count); const t0 = performance.now();
            if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            const tick = (now: number) => { const k = Math.min(1, (now - t0) / 1100); el.textContent = (end * (1 - Math.pow(1 - k, 3))).toFixed(2); if (k < 1) requestAnimationFrame(tick); };
            requestAnimationFrame(tick);
          });
        } catch {
          sheet.innerHTML = '<button class="close" data-close aria-label="Close">✕</button><div class="loading">Profile unavailable right now. Please try again later.</div>';
        }
      };
      document.querySelectorAll<HTMLElement>('[data-player]').forEach(el => el.addEventListener('click', () => {
        const rank = el.querySelector<HTMLElement>('.pos')!.dataset.pos!;
        open(el.dataset.player!, rank);
      }));
      dlg.addEventListener('click', e => {
        const t = e.target as HTMLElement;
        if (t === dlg || t.closest('[data-close]')) dlg.close();
        const g = t.closest<HTMLElement>('[data-g]');
        if (g && g.tagName === 'BUTTON') {
          sheet.querySelectorAll('.hfilter .chip').forEach(c => c.setAttribute('aria-pressed', String(c === g)));
          const k = g.dataset.g!;
          sheet.querySelectorAll<HTMLElement>('.seasons li').forEach(li => { li.hidden = k !== 'all' && !li.dataset.g!.split(' ').includes(k); });
          sheet.querySelectorAll<HTMLElement>('.seasons .yr').forEach(y => { y.hidden = !y.querySelector('li:not([hidden])'); });
        }
      });

      // Search
      const q = document.getElementById('q') as HTMLInputElement;
      q.addEventListener('input', () => {
        const v = q.value.trim().toLowerCase();
        document.querySelectorAll<HTMLElement>('.table .tr[data-search]').forEach(r => r.classList.toggle('nomatch', !!v && !r.dataset.search!.includes(v)));
      });

      // ---- Official list, refreshed from the PDC feed, plus the live race ----
      const table = document.querySelector<HTMLElement>('.table')!;
      const rows = new Map([...table.querySelectorAll<HTMLElement>('.tr[data-search]')].map(r => [r.dataset.player!, r]));
      const asof = document.getElementById('asof')!;
      const modeBox = document.getElementById('mode')!;
      const note = document.getElementById('raceNote')!;
      let official: any[] = [];
      let full: any[] = [];
      let race: any[] | null = null;
      let event: any = null;
      let mode: 'live' | 'official' = 'live';
      const k = (n: number) => '£' + (n / 1000).toLocaleString('en-GB', { maximumFractionDigits: 2 }) + 'k';
      const keyOf = (p: any) => p.id;

      const paint = () => {
        const live = mode === 'live' && race;
        const list = live ? race! : official;
        if (!list.length) return;
        const max = list[0].money || 1;
        const frag = document.createDocumentFragment();
        const seen = new Set<HTMLElement>();
        for (const p of list) {
          const r = rows.get(keyOf(p)); if (!r || seen.has(r)) continue; seen.add(r);
          const pos = live ? p.live : p.pos;
          const move = live ? p.move : (Number(r.querySelector<HTMLElement>('.pos')!.dataset.move) || 0);
          if (p.pos) r.querySelector<HTMLElement>('.pos')!.dataset.pos = String(p.pos);
          r.querySelector('.pos')!.innerHTML = `<b>${pos}</b>${move ? `<i class="${move > 0 ? 'up' : 'down'}" title="${move > 0 ? 'Up' : 'Down'} ${Math.abs(move)}${live ? ' on the official list' : ''}">${move > 0 ? '▲' : '▼'}${Math.abs(move)}</i>` : ''}`;
          const m = r.querySelector<HTMLElement>('[data-money]')!;
          if (Number(m.dataset.money) !== p.money) { m.textContent = money(p.money); m.dataset.money = String(p.money); m.classList.remove('bump'); void m.offsetWidth; m.classList.add('bump'); }
          const d = r.querySelector<HTMLElement>('.delta')!;
          const bits = live ? [p.plus ? `<span class="plus">+${k(p.plus)}</span>` : '', p.minus ? `<span class="minus">−${k(p.minus)}${p.estimated ? '*' : ''}</span>` : ''].filter(Boolean) : [];
          d.hidden = !bits.length; d.innerHTML = bits.join(' ');
          r.classList.toggle('in-event', !!(live && p.round));
          r.classList.toggle('knocked', !!(live && p.round && p.alive === false));
          r.querySelector<HTMLElement>('.bar span')!.style.width = `${(p.money / max) * 100}%`;
          frag.appendChild(r);
        }
        // Players outside this view's top 128 are hidden.
        rows.forEach(r => { r.hidden = !seen.has(r); if (!seen.has(r)) frag.appendChild(r); });
        table.appendChild(frag);
        note.hidden = !live;
        if (live) note.innerHTML = `<span class="live-dot">Live</span> Projected standings during the <b>${esc(event.name.replace(/^\d{4}\s+/, ''))}</b>: prize money from the ${esc(String(Number(event.seasonID) - 2))} edition comes off (<span class="minus">−</span>) and money players have guaranteed so far is added (<span class="plus">+</span>). Positions settle when the PDC publishes the official list after the final.`;
        asof.textContent = live ? `Movement shown against the official list` : `Top ${official.length} · official PDC list`;
      };

      modeBox.addEventListener('click', e => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-mode]'); if (!b) return;
        mode = b.dataset.mode as any;
        modeBox.querySelectorAll('[data-mode]').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
        table.classList.add('shuffle'); setTimeout(() => table.classList.remove('shuffle'), 500);
        paint();
      });

      const json = (u: string) => fetch(u).then(r => (r.ok ? r.json() : null));
      const todayLdn = new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/London' });
      async function findEvent() {
        const y = Number(todayLdn.slice(0, 4));
        const lists = await Promise.all([y, y + 1].map(s => json(`${API.tournaments}?seasonID=${s}&page.size=500`)));
        const idx = lists.flatMap(l => (l?.data || []).map((d: any) => ({ id: d.id, ...d.attributes })));
        const live = idx.find((t: any) => RANKED_TYPES.includes(t.tournamentTypeID) && t.fixtureCount > 0 && t.startDate <= todayLdn && t.endDate >= todayLdn && !/test/i.test(t.name));
        if (!live) return null;
        const prevMeta = previousEdition(live, await Promise.all([Number(live.seasonID) - 2].map(s => json(`${API.tournaments}?seasonID=${s}&page.size=500`))).then(l => l.flatMap(x => (x?.data || []).map((d: any) => ({ id: d.id, ...d.attributes })))));
        const prev = prevMeta ? (await json(API.tournaments + prevMeta.id))?.data?.attributes : null;
        return { meta: live, prev };
      }

      let found: any = null;
      async function refresh() {
        try {
          const body = await json(`${API.rankings}2YEAR?page.size=500`);
          if (body) { full = normaliseRankings(body); official = full.filter((p: any) => p.pos <= 128); }
          if (found === null) found = (await findEvent()) || false;
          if (found && official.length) {
            const cur = (await json(API.tournaments + found.meta.id))?.data?.attributes;
            if (cur) { event = { ...found.meta, ...cur }; race = liveRace(full, cur, found.prev).filter((p: any) => p.live <= 128); }
          }
          modeBox.hidden = !race;
          paint();
          if (race && document.getElementById('profile')) setTimeout(refresh, 60_000);
        } catch { /* keep the build-time list */ }
      }
      refresh();
    }
    document.addEventListener('astro:page-load', init);
  </script>
</Layout>

<style>

  .tools { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; flex-wrap: wrap; }
  .search { display: flex; align-items: center; gap: 10px; background: var(--card); border: 1px solid var(--line); border-radius: 999px; padding: 0 16px; flex: 1; max-width: 420px; box-shadow: var(--shadow-sm); transition: box-shadow .2s, border-color .2s; }
  .search:focus-within { border-color: var(--ink); box-shadow: 0 0 0 4px rgba(20, 22, 31, .08); }
  .search input { border: 0; outline: 0; background: none; font: inherit; padding: 12px 0; width: 100%; }
  .small { font-size: 13px; }
  .table { overflow: hidden; }
  .tr { display: grid; grid-template-columns: 76px 1.6fr 1fr 60px 1.1fr; align-items: center; gap: 12px; padding: 10px 18px; width: 100%; border: 0; border-bottom: 1px solid var(--line); background: none; text-align: left; font: inherit; color: inherit; }
  .tr:last-child { border-bottom: 0; }
  .tr.nomatch { display: none; }
  .th { font-size: 12px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); background: var(--paper-2); }
  .tr.clickable { cursor: pointer; transition: background .2s, transform .25s var(--ease); }
  .tr.clickable:hover { background: #fffaf0; }
  .tr.clickable:hover .who b { color: var(--red); }
  .tr:disabled { cursor: default; opacity: .85; }
  .pos { font-family: var(--display); font-weight: 800; font-size: 18px; display: flex; align-items: center; gap: 6px; }
  .pos :global(i) { font-style: normal; font-family: var(--body); font-size: 11px; font-weight: 700; }
  :global(.up) { color: var(--green); } :global(.down) { color: var(--red); }
  .who { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .who > span:last-child { display: flex; flex-direction: column; min-width: 0; }
  .who b { transition: color .2s; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .who small { color: var(--muted); font-size: 12px; }
  .r { text-align: right; justify-self: end; }
  .money-cell { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; width: 100%; font-weight: 600; }
  .bar { width: 100%; max-width: 180px; height: 4px; background: var(--paper-2); border-radius: 9px; overflow: hidden; }
  .bar span { display: block; height: 100%; background: linear-gradient(90deg, var(--red), #f05d23); border-radius: 9px; }
  .mode { display: inline-flex; padding: 4px; gap: 2px; background: var(--paper-2); border: 1px solid var(--line); border-radius: 999px; }
  .seg { border: 0; background: none; padding: 7px 14px; border-radius: 999px; font-weight: 700; font-size: 13px; cursor: pointer; display: inline-flex; align-items: center; gap: 7px; color: var(--muted); transition: background .25s, color .25s, box-shadow .25s; }
  .seg[aria-pressed='true'] { background: var(--card); color: var(--ink); box-shadow: var(--shadow-sm); }
  .ldot { width: 8px; height: 8px; border-radius: 50%; background: var(--red); animation: pulse 1.6s infinite; }
  .race-note { margin: -2px 0 12px; font-size: 13px; color: var(--muted); background: var(--card); border: 1px solid var(--line); border-left: 3px solid var(--red); border-radius: 12px; padding: 10px 14px; }
  .race-note .live-dot { margin-right: 6px; }
  :global(.delta) { font-size: 11px; font-weight: 700; display: inline-flex; gap: 6px; }
  :global(.plus) { color: var(--green); } :global(.minus) { color: var(--red); }
  .tr.in-event .who b::after { content: ''; display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--green); margin-left: 7px; vertical-align: middle; box-shadow: 0 0 0 3px var(--green-soft); }
  .tr.knocked .who b::after { background: #b9b2a4; box-shadow: none; }
  .table.shuffle .tr { animation: shuffle .45s var(--ease); }
  @keyframes shuffle { from { opacity: .3; transform: translateY(6px); } }
  :global(.bump) { animation: bump 1s var(--spring); display: inline-block; }
  @keyframes bump { 0% { transform: scale(1.25); color: var(--green); } 100% { transform: none; } }

