---
import Layout from '../layouts/Layout.astro';
import data from '../data/rankings.json';
import liveRaceData from '../data/live-race.json';
import { avatarSrc } from '../lib/images.mjs';
import { flag, countryName, age, keyName } from '../lib/pdc.mjs';
import { money, avatarColours, initials } from '../lib/format.mjs';
import { loadProfile } from '../lib/players';

const prev = (data.previous || {}) as Record<string, number>;
// Top 128 shown; a few more are rendered hidden so the live race can promote them.
// The live race is worked out by the daily data job (scripts/refresh-live-race.mjs).
const lr = liveRaceData as any;
const liveCache = lr.event ? { event: lr.event, dropNames: lr.dropNames, updatedAt: lr.updatedAt, race: lr.race } : null;
const players = data.players.filter(p => p.pos <= 150).map(p => ({ ...p, move: prev[p.id] ? prev[p.id] - p.pos : null }));
// Ranking trend from the snapshots kept after each ranking event.
const hist = ((data as any).history || []) as { d: string; pos: Record<string, number> }[];
const trend = (id: string) => {
  const v = hist.map(h => h.pos[id]).filter(Boolean) as number[];
  if (v.length < 2) return null;
  const lo = Math.min(...v), hi = Math.max(...v), W = 64, H = 20;
  const pts = v.map((r, i) => `${((i / (v.length - 1)) * (W - 4) + 2).toFixed(1)},${(hi === lo ? H / 2 : 2 + ((r - lo) / (hi - lo)) * (H - 4)).toFixed(1)}`).join(' ');
  return `<svg class="spark" viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" role="img" aria-label="Ranking trend: ${v.map(r => '#' + r).join(', ')}"><polyline points="${pts}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>`;
};
const pic = (name: string) => avatarSrc(name);
// Season average for each ranked player (from their profile), shown instead of age.
const seasonAvg = (id: string) => { const s = loadProfile(id)?.season; return s?.stats?.avg ? { avg: s.stats.avg, year: s.year } : null; };
const avgYear = seasonAvg(data.players[0].id)?.year;
const av = (name: string) => { const [c1, c2] = avatarColours(name); return `--c1:${c1};--c2:${c2}`; };
---
<Layout title="World Rankings" description="The PDC Order of Merit, with full player profiles, darts used and tournament history." active="rankings">
  <section class="hero wrap">
    <span class="eyebrow">PDC Order of Merit</span>
    <h1>World <span class="accent">Rankings</span></h1>
    <p class="lede">The top 128, ranked on prize money won over two years. Tap any player for their profile, season record and full tournament history.</p>
  </section>


  <section class="wrap">
    <div class="tools" data-reveal>
      <label class="search">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" /><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <input id="q" type="search" placeholder="Search players or countries" autocomplete="off" />
      </label>
      <div class="mode" id="mode" hidden role="group" aria-label="Ranking view">
        <button class="seg" data-mode="live" aria-pressed="true"><span class="ldot"></span>Live race</button>
        <button class="seg" data-mode="official" aria-pressed="false">Official</button>
      </div>
      <label class="onlyev" id="onlyev" hidden><input type="checkbox" id="onlyevcb" /> <span id="onlyev-label">In this event only</span></label>
      <span class="muted small" id="asof">Top 128 · official PDC list</span>
    </div>
    <p class="race-note" id="raceNote" hidden></p>
    <div class="table card" role="table" aria-label="PDC World Rankings">
      <div class="tr th" role="row">
        <span role="columnheader">#</span><span role="columnheader">Player</span><span role="columnheader" class="hide-s">Country</span><span role="columnheader" class="hide-s r" title="Three-dart average this season">{avgYear || 'Season'} avg</span><span role="columnheader" class="r">Prize money</span>
      </div>
      {players.map(p => (
        <a class="tr clickable" role="row" href={p.pos <= 128 ? `/players/${p.slug}` : `https://www.pdc.tv/players/${p.slug}`} data-player={p.id} hidden={p.pos > 128} data-search={`${p.name} ${p.nick || ''} ${countryName(p.country) || ''}`.toLowerCase()}>
          <span class="pos tabular" role="cell" data-pos={p.pos} data-move={p.move ?? ''}><b>{p.pos}</b>
            {p.move ? <i class={p.move > 0 ? 'up' : 'down'} title={`${p.move > 0 ? 'Up' : 'Down'} ${Math.abs(p.move)}`}>{p.move > 0 ? '▲' : '▼'}{Math.abs(p.move)}</i> : null}
          </span>
          <span class="who" role="cell">
            <span class="avatar" style={`--size:38px;${av(p.name)}`}>{pic(p.name) ? <img src={pic(p.name)} alt="" width="38" height="38" loading="lazy" decoding="async" /> : initials(p.name)}</span>
            <span><b>{p.name}</b>{p.nick && <small>{p.nick}</small>}</span>
          </span>
          <span class="hide-s" role="cell"><Fragment set:html={flag(p.country)} /> {countryName(p.country)}</span>
          <span class="hide-s tabular r avgcell" role="cell">{trend(p.id) && <Fragment set:html={trend(p.id)} />}<b>{seasonAvg(p.id)?.avg.toFixed(2) ?? '–'}</b></span>
          <span class="r money-cell" role="cell">
            <span class="top"><small class="netslot"></small><span class="tabular" data-money={p.money}>{money(p.money)}</span></span>
            <small class="delta" hidden></small>
          </span>
        </a>
      ))}
    </div>
  </section>


  <script is:inline type="application/json" id="r-official" set:html={JSON.stringify(data.players.filter(p => p.pos <= 128))}></script>
  <script is:inline type="application/json" id="lr-data" set:html={JSON.stringify(liveCache)}></script>

  <script>
    import { API, normaliseRankings } from '../lib/pdc.mjs';
    import { money } from '../lib/format.mjs';

    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

    function init() {
      if (!document.querySelector('.table')) return;

      // Search
      const q = document.getElementById('q') as HTMLInputElement;
      q.addEventListener('input', () => {
        const v = q.value.trim().toLowerCase();
        document.querySelectorAll<HTMLElement>('.table .tr[data-search]').forEach(r => r.classList.toggle('nomatch', !!v && !r.dataset.search!.includes(v)));
      });

      // ---- Official list, refreshed from the PDC feed, plus the live race ----
      const table = document.querySelector<HTMLElement>('.table')!;
      const rows = new Map([...table.querySelectorAll<HTMLElement>('.tr[data-search]')].map(r => [r.dataset.player!, r]));
      const asof = document.getElementById('asof')!;
      const modeBox = document.getElementById('mode')!;
      const note = document.getElementById('raceNote')!;
      let official: any[] = JSON.parse(document.getElementById('r-official')!.textContent!);
      let full: any[] = [];
      let race: any[] | null = null;
      let event: any = null;
      let mode: 'live' | 'official' = 'live';
      const k = (n: number) => '£' + (n / 1000).toLocaleString('en-GB', { maximumFractionDigits: 2 }) + 'k';
      const keyOf = (p: any) => p.id;

      const paint = () => {
        const live = mode === 'live' && race;
        const onlyEv = (document.getElementById('onlyevcb') as HTMLInputElement)?.checked;
        const list = live ? race!.filter((p: any) => !onlyEv || p.round) : official;
        if (!list.length) return;
        const frag = document.createDocumentFragment();
        const seen = new Set<HTMLElement>();
        for (const p of list) {
          const r = rows.get(keyOf(p)); if (!r || seen.has(r)) continue; seen.add(r);
          const pos = live ? p.live : p.pos;
          const move = live ? p.move : (Number(r.querySelector<HTMLElement>('.pos')!.dataset.move) || 0);
          if (p.pos) r.querySelector<HTMLElement>('.pos')!.dataset.pos = String(p.pos);
          r.querySelector('.pos')!.innerHTML = `<b>${pos}</b>${move ? `<i class="${move > 0 ? 'up' : 'down'}" title="${move > 0 ? 'Up' : 'Down'} ${Math.abs(move)}${live ? ' on the official list' : ''}">${move > 0 ? '▲' : '▼'}${Math.abs(move)}</i>` : ''}`;
          const m = r.querySelector<HTMLElement>('[data-money]')!;
          if (Number(m.dataset.money) !== p.money) { m.textContent = money(p.money); m.dataset.money = String(p.money); m.classList.remove('bump'); void m.offsetWidth; m.classList.add('bump'); }
          const d = r.querySelector<HTMLElement>('.delta')!;
          // Net change as a chip, then what was won and what is expiring (named on hover).
          let html = '', netHtml = '';
          if (live && (p.plus || p.minus)) {
            const net = p.plus - p.minus;
            const ev = (p.expiring || []).map((e: any) => `${k(e.amount)} ${e.name}`).join(', ');
            // Progress in the event, beside what it has won them (event named on hover).
            const evName = event.name.replace(/^\d{4}\s+/, '');
            const round = p.round ? (/^(group|league)/i.test(p.round) ? 'Group stage' : p.round) : '';
            // Short round names for phones: "Quarter-Final" -> "QF", "Last 16" -> "L16".
            const abbr = (r: string) => r.replace(/quarter-?final/i, 'QF').replace(/semi-?final/i, 'SF').replace(/^final$/i, 'Final').replace(/^last (\d+)$/i, 'L$1').replace(/^group stage$/i, 'Groups');
            const chip = round ? `<span class="stage-chip tip ${p.alive === false ? 'out' : 'in'}" data-tip="${esc(`${evName}\n${p.alive === false ? `Knocked out · ${round}` : `Still in · ${round}`}`)}">${p.alive === false ? `Out<span class="rnd"> · ${esc(round)}</span>` : `<span class="full">${esc(round)}</span><span class="abbr">${esc(abbr(round))}</span>`}</span>` : '';
            // Three fixed slots (chip · won · expiring) so every row lines up.
            const parts = [
              chip || '<span></span>',
              p.plus ? `<span class="plus">won ${k(p.plus)}</span>` : '<span></span>',
              p.minus ? `<span class="minus tip" data-tip="${esc(`Expiring:\n${(p.expiring || []).map((e: any) => `${k(e.amount)} · ${e.name}`).join('\n')}`)}" aria-label="${esc(`Expiring: ${ev}`)}">expiring ${k(p.minus)}${p.estimated ? '*' : ''}</span>` : '<span></span>',
            ].join('');
            netHtml = `<span class="net ${net > 0 ? 'up' : net < 0 ? 'down' : 'flat'}">${net > 0 ? '▲ ' : net < 0 ? '▼ ' : ''}${net ? k(Math.abs(net)) : 'No change'}</span>`;
            html = `<span class="br">${parts}</span>`;
          }
          d.hidden = !html; d.innerHTML = html;
          r.querySelector<HTMLElement>('.netslot')!.innerHTML = netHtml;
          frag.appendChild(r);
        }
        // Players outside this view's top 128 are hidden.
        rows.forEach(r => { r.hidden = !seen.has(r); if (!seen.has(r)) frag.appendChild(r); });
        table.appendChild(frag);
        note.hidden = !live;
        document.getElementById('onlyev')!.classList.toggle('off', mode !== 'live');
        if (live) {
          const drops: string[] = found?.dropNames || [];
          const list = drops.length ? drops.map(d => `<b>${esc(d)}</b>`).join(' and ') : 'events from two years ago';
          note.innerHTML = `<span class="live-dot">Live</span> Projected standings at the end of the <b>${esc(event.name.replace(/^\d{4}\s+/, ''))}</b>. The PDC drops prize money 104 weeks after it was won, so money from the ${list} is <span class="minus">expiring</span>, and money players have guaranteed in this event so far counts as <span class="plus">won</span>. The red or green chip shows each player's net change (hover “expiring” to see which events); the volt chip shows how far they've got in the ${esc(event.name.replace(/^\d{4}\s+/, ''))}. <b>Updated daily</b>${found?.updatedAt ? ` (last at ${new Date(found.updatedAt).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/London' })})` : ''}; positions settle when the PDC publishes the official list after the final.`;
        }
        asof.textContent = live ? `Movement shown against the official list` : `Top ${official.length} · official PDC list`;
      };

      document.getElementById('onlyevcb')!.addEventListener('change', () => { if (mode !== 'live') return; table.classList.add('shuffle'); setTimeout(() => table.classList.remove('shuffle'), 500); paint(); });
      modeBox.addEventListener('click', e => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-mode]'); if (!b) return;
        mode = b.dataset.mode as any;
        modeBox.querySelectorAll('[data-mode]').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
        table.classList.add('shuffle'); setTimeout(() => table.classList.remove('shuffle'), 500);
        paint();
      });

      const json = (u: string) => fetch(u).then(r => (r.ok ? r.json() : null));
      const todayLdn = new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/London' });
      // Live race: the daily snapshot saved with the site, shown at once.
      const cache = JSON.parse(document.getElementById('lr-data')!.textContent || 'null');
      const found: any = cache && cache.event.startDate <= todayLdn && cache.event.endDate >= todayLdn ? cache : null;
      if (found) {
        event = found.event;
        document.getElementById('onlyev-label')!.textContent = `In the ${found.event.name.replace(/^\d{4}\s+/, '').replace(/ of Darts$/, '')} only`;
        race = found.race.filter((p: any) => p.live <= 128);
      }
      modeBox.hidden = !race;
      document.getElementById('onlyev')!.hidden = !race;
      paint();
      // The official list itself is refreshed quietly in the background.
      json(`${API.rankings}2YEAR?page.size=500`).then(body => {
        if (!body || !document.querySelector('.table')) return;
        full = normaliseRankings(body); official = full.filter((p: any) => p.pos <= 128);
        if (mode === 'official' || !race) paint();
      }).catch(() => {});
    }
    document.addEventListener('astro:page-load', init);
  </script>
</Layout>

<style>

  /* Fixed slots so the Live/Official switch never moves when the view changes */
  .tools { display: grid; grid-template-columns: minmax(0, 420px) auto auto minmax(0, 1fr); align-items: center; gap: 12px 20px; margin-bottom: 12px; }
  .tools #asof { grid-column: -2 / -1; justify-self: end; text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
  .onlyev.off { visibility: hidden; }
  .search { display: flex; align-items: center; gap: 10px; background: var(--card); border: 1px solid var(--line); border-radius: 999px; padding: 0 16px; min-width: 0; box-shadow: var(--shadow-sm); transition: box-shadow .2s, border-color .2s; }
  .search:focus-within { border-color: var(--ink); box-shadow: 0 0 0 4px rgba(20, 22, 31, .08); }
  .search input { border: 0; outline: 0; background: none; font: inherit; padding: 12px 0; width: 100%; }
  .small { font-size: 13px; }
  .table { overflow: hidden; }
  .tr { display: grid; text-decoration: none; grid-template-columns: 76px minmax(0, 1.6fr) minmax(0, 1fr) 150px 340px; align-items: center; gap: 12px; padding: 10px 18px; width: 100%; border: 0; border-bottom: 1px solid var(--line); background: none; text-align: left; font: inherit; color: inherit; }
  .tr:last-child { border-bottom: 0; }
  .tr.nomatch { display: none; }
  .th { font-size: 12px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); background: var(--paper-2); }
  .tr.clickable { cursor: pointer; transition: background .2s, transform .25s var(--ease); }
  .tr.clickable:hover { background: #fffaf0; }
  .tr.clickable:hover .who b { color: var(--red); }
  .tr:disabled { cursor: default; opacity: .85; }
  .pos { font-family: var(--poster); font-weight: 400; font-size: 26px; display: flex; align-items: center; gap: 6px; }
  .pos :global(i) { font-style: normal; font-family: var(--body); font-size: 14px; font-weight: 800; }
  :global(.up) { color: var(--green); } :global(.down) { color: var(--red); }
  .who { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .who > span:last-child { display: flex; flex-direction: column; min-width: 0; }
  .who b { transition: color .2s; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .who small { color: var(--muted); font-size: 12px; }
  .r { text-align: right; justify-self: end; }
  .money-cell { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; width: 100%; font-weight: 600; }
  .money-cell :global(.delta) { margin-bottom: 2px; }
  .money-cell :global(.delta .br) { line-height: 1.3; }
  .mode { display: inline-flex; padding: 4px; gap: 2px; background: var(--paper-2); border: 1px solid var(--line); border-radius: 999px; }
  .seg { border: 0; background: none; padding: 7px 14px; border-radius: 999px; font-weight: 700; font-size: 13px; cursor: pointer; display: inline-flex; align-items: center; gap: 7px; color: var(--muted); transition: background .25s, color .25s, box-shadow .25s; }
  .seg[aria-pressed='true'] { background: var(--card); color: var(--ink); box-shadow: var(--shadow-sm); }
  .onlyev { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; cursor: pointer; }
  .onlyev input { accent-color: var(--ink); width: 16px; height: 16px; }
  :global(.spark) { color: var(--ink-2); vertical-align: middle; margin-right: 12px; }
  .avgcell { display: flex; align-items: center; justify-content: flex-end; }
  .avgcell b { font-variant-numeric: tabular-nums; min-width: 5ch; text-align: right; }
  .ldot { width: 8px; height: 8px; border-radius: 50%; background: var(--red); animation: pulse 1.6s infinite; }
  .race-note { margin: -2px 0 12px; font-size: 13px; color: var(--muted); background: var(--card); border: 1px solid var(--line); border-left: 3px solid var(--red); border-radius: 12px; padding: 10px 14px; }
  .race-note .live-dot { margin-right: 6px; }
  :global(.delta) { display: flex; flex-direction: column; align-items: flex-end; font-size: 12px; font-weight: 700; }
  .top { display: flex; align-items: center; justify-content: flex-end; gap: 10px; }
  .top [data-money] { min-width: 10ch; text-align: right; font-variant-numeric: tabular-nums; }
  .netslot:empty { display: none; }
  /* One pill size for the net change and the progress chip */
  :global(.money-cell .net), :global(.stage-chip) { display: inline-flex; align-items: center; height: 20px; padding: 0 8px; border-radius: 999px; font-size: 11px; font-weight: 800; line-height: 1; white-space: nowrap; font-variant-numeric: tabular-nums; }
  :global(.money-cell .net.up) { background: var(--green-soft); color: #075c3f; }
  :global(.money-cell .net.down) { background: var(--red-soft); color: #a3221a; }
  :global(.money-cell .net.flat) { background: var(--paper-2); color: var(--muted); }
  /* Fixed tracks: chips line up on the left, won and expiring line up on the right */
  :global(.delta .br) { display: grid; grid-template-columns: 1fr 76px 118px; align-items: center; column-gap: 12px; white-space: nowrap; width: 100%; }
  :global(.delta .br > *) { justify-self: end; }
  :global(.delta .br > .stage-chip) { justify-self: start; }
  :global(.money-cell .delta) { width: 100%; }
  /* Instant tooltip naming the events whose money is expiring */
  :global(.delta .tip) { position: relative; }
  :global(.delta .minus.tip) { text-decoration: underline dotted; text-underline-offset: 2px; }
  :global(.delta .tip::after) {
    content: attr(data-tip); white-space: pre; position: absolute; z-index: 20; right: 0; bottom: calc(100% + 8px);
    background: var(--ink); color: #fff; font-size: 12px; font-weight: 600; line-height: 1.5; text-align: left;
    padding: 8px 12px; border-radius: 10px; box-shadow: 0 10px 24px -10px rgba(11, 12, 16, .6);
    opacity: 0; transform: translateY(4px); pointer-events: none; transition: opacity .15s, transform .15s;
  }
  :global(.delta .tip:hover::after), :global(.tr:focus-visible .delta .tip::after) { opacity: 1; transform: none; }
  :global(.plus) { color: #0a7a3a; } :global(.minus) { color: #c42c23; }
  :global(.stage-chip) { margin-right: 2px; letter-spacing: .05em; text-transform: uppercase; }
  :global(.stage-chip.in) { background: var(--volt); color: var(--ink); }
  :global(.stage-chip.out) { background: var(--paper-2); color: var(--muted); }
  :global(.stage-chip .abbr) { display: none; }
  .table.shuffle .tr { animation: shuffle .45s var(--ease); }
  @keyframes shuffle { from { opacity: .3; transform: translateY(6px); } }
  :global(.bump) { animation: bump 1s var(--spring); display: inline-block; }
  @keyframes bump { 0% { transform: scale(1.25); color: var(--green); } 100% { transform: none; } }


  @media (max-width: 900px) {
    .tools { grid-template-columns: auto auto minmax(0, 1fr); }
    .tools .search { grid-column: 1 / -1; }
  }
  @media (max-width: 720px) {
    .tr { grid-template-columns: 50px minmax(0, 1fr) auto; gap: 10px; padding: 10px 12px; }
    /* Phones: full names, wrapping onto a second line rather than cut off */
    .who { gap: 10px; }
    .who b { white-space: normal; overflow: visible; text-overflow: clip; line-height: 1.2; overflow-wrap: break-word; }
    .hide-s { display: none; }
    /* Phones: prize money on top, then the net change and the round reached side by side
       (won/expiring detail is left to the net chip) */
    .money-cell { display: grid; grid-template-columns: auto auto; justify-content: end; justify-items: end; align-items: center; gap: 5px 6px; width: auto; }
    .top, .money-cell :global(.delta), .money-cell :global(.delta .br) { display: contents; }
    .top [data-money] { min-width: 0; grid-column: 1 / -1; order: -1; }
    :global(.delta .br > :not(.stage-chip)) { display: none; }
    :global(.stage-chip.out .rnd) { display: none; }
    :global(.stage-chip .full) { display: none; }
    :global(.stage-chip .abbr) { display: inline !important; }
  }
</style>
