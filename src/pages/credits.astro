---
import Layout from '../layouts/Layout.astro';
import portraits from '../data/portraits.json';
import library from '../data/news-library.json';
import extraPhotos from '../data/extra-photos.json';
import rankings from '../data/rankings.json';
import { pdcImageKeys } from '../lib/images.mjs';
import { keyName } from '../lib/pdc.mjs';
const nameOf = Object.fromEntries(rankings.players.map(p => [keyName(p.name), p.name]));
const pdc = pdcImageKeys().map(k => nameOf[k] || k).sort();
const lib = Object.entries(library as Record<string, any>);
const list = Object.values(portraits as Record<string, any>).sort((a, b) => a.name.localeCompare(b.name));
const nameFor = (k: string) => (portraits as any)[k]?.name || k;
const extras = Object.entries(extraPhotos as Record<string, any[]>).flatMap(([k, xs]) => xs.map(x => ({ ...x, name: nameFor(k) }))).sort((a, b) => a.name.localeCompare(b.name));
---
<Layout title="Credits" description="Photo credits and data sources for The Oche.">
  <section class="hero wrap">
    <span class="eyebrow">Credits</span>
    <h1>Photo credits</h1>
    <p class="lede">Player photographs are reused under Creative Commons licences from Wikimedia Commons and cropped for display. The cut-out player images are adapted from the same photographs (background removed) and are shared under the same licences.</p>
    <p class="lede">Small round player pictures across the site, and cut-outs of players with no free photo, are the PDC's official player headshots (© PDC). They are used on this non-commercial fan site and will be licensed or replaced before the site carries any advertising.</p>
  </section>
  <section class="wrap">
    <h2 class="h">Player photographs</h2>
    <ul class="grid">
      {list.map(p => (
        <li class="card"><img src={p.image} alt={p.name} loading="lazy" /><div><strong>{p.name}</strong><span>{p.credit}</span><a href={p.licenseUrl} target="_blank" rel="noopener">{p.license}</a> · <a href={p.source} target="_blank" rel="noopener">Source</a></div></li>
      ))}
    </ul>
    <p class="src">News covers and player pages use these photos and larger versions of them, cropped to fit.</p>
    <h2 class="h">More player photographs</h2>
    <ul class="grid">
      {extras.map(p => (
        <li class="card"><img src={p.file.replace('.jpg', '-600.webp')} alt={p.name} loading="lazy" style={`object-position:${(p.face.x * 100).toFixed(0)}% ${(p.face.y * 100).toFixed(0)}%`} /><div><strong>{p.name}</strong><span>{p.credit}</span><a href={p.licenseUrl} target="_blank" rel="noopener">{p.license}</a> · <a href={p.source} target="_blank" rel="noopener">Source</a></div></li>
      ))}
    </ul>
    <h2 class="h">PDC headshots</h2>
    <p class="src">{pdc.length} players: {pdc.join(', ')}.</p>
    <h2 class="h">News photographs</h2>
    <ul class="grid">
      {lib.map(([key, x]) => (
        <li class="card"><img class="sq" src={`/news-img/${key}.jpg`} alt={x.alt} loading="lazy" /><div><strong>{x.alt}</strong><span>{x.credit}</span><a href={x.licenseUrl} target="_blank" rel="noopener">{x.license}</a> · <a href={`https://commons.wikimedia.org/wiki/${encodeURIComponent(x.file.replace(/ /g, '_'))}`} target="_blank" rel="noopener">Source</a></div></li>
      ))}
    </ul>
  </section>
</Layout>
<style>
  .h { font-size: 22px; margin: 28px 0 12px; }
  .src { color: var(--ink-2); }
  .grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
  .grid li { display: flex; gap: 12px; align-items: center; padding: 10px; font-size: 13px; }
  .grid img { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; object-position: 50% 18%; }
  .grid img.sq { border-radius: 10px; object-position: 50% 50%; }
  .grid div { display: flex; flex-direction: column; }
  .grid span { color: var(--muted); }
</style>
