---
// Match centre: /match?id=<fixtureId>. Rendered in the browser from the PDC
// fixture feed (players, score) and its timeline (every visit), refreshed
// every 15 seconds while the match is live.
import Layout from '../layouts/Layout.astro';
import cutouts from '../data/cutouts.json';
import portraitsRaw from '../data/portraits.json';

const portraits = Object.fromEntries(Object.entries(portraitsRaw as Record<string, { image: string }>).map(([k, v]) => [k, v.image]));
---
<Layout title="Match centre" description="Live score, statistics, leg table and head to head for a PDC darts match.">
  <section class="mhead" aria-live="polite">
    <div class="wrap mh-in" id="mh"><div class="loading"><span class="spinner"></span>Loading match…</div></div>
  </section>

  <section class="wrap h2h" id="h2h" hidden>
    <h2>Head to head</h2>
    <p class="sub" id="hh-sub"></p>
    <div id="hh"></div>
  </section>

  <section class="wrap tape" id="tape" hidden>
    <h2>Season form</h2>
    <p class="sub">How the two players have gone in PDC main-tour events this year.</p>
    <div class="cmp" id="tp"></div>
  </section>

  <div class="wrap mbody" id="mb" hidden>
    <section class="block">
      <h2>Match stats</h2>
      <div class="cmp" id="cmp"></div>
    </section>

    <section class="block">
      <div class="bh"><h2>Average through the match</h2><div class="legend" id="lg1"></div></div>
      <p class="sub">Each player's running three-dart average after every leg (legs along the bottom).</p>
      <div class="chart" id="runavg"></div>
    </section>

    <section class="block">
      <h2>Leg table</h2>
      <div class="tablewrap"><table class="lt" id="lt"></table></div>
    </section>
  </div>

  <script is:inline type="application/json" id="m-data" set:html={JSON.stringify({ cutouts, portraits })}></script>

  <script>
    import { API, flag, keyName, liveScore, liveLegs, cleanName } from '../lib/pdc.mjs';
    import { liveFor, LIVE_TICK } from '../lib/live-client.mjs';

    const FX = 'https://fixtures.darts.web.gc.pdcservices.co.uk/v2/';
    const C = ['#2b4bff', '#e8362d']; // player 1 blue, player 2 red (validated pair)
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    const name = (p: any) => [p?.firstName, p?.lastName].filter(Boolean).join(' ');
    const last = (p: any) => p?.lastName || name(p);
    let timer: number | undefined;
    // Finished legs from the live data, kept between polls (per match).
    const legCache = new Map<string, Map<string, any>>();

    /** The leg being played: what each player needs, who's throwing and their last visits. */
    function currentLeg(leg: any, names: string[]) {
      const v = (leg.visits || []).slice().sort((a: any, b: any) => a.order - b.order);
      const mine = (p1: boolean) => v.filter((x: any) => x.isParticipant1 === p1);
      const left = (p1: boolean) => mine(p1).at(-1)?.remaining ?? 501;
      const last = v.at(-1);
      const thrower = leg.throwing ?? (last ? (last.isParticipant1 ? 1 : 0) : null);
      const darts = (p1: boolean) => mine(p1).reduce((n: number, x: any) => n + (x.numberOfDartsThrown || 0), 0);
      const chips = (p1: boolean) => mine(p1).slice(-4).reverse().map((x: any, i: number) => `<i class="${x.isBust ? 'bust' : x.score >= 100 ? 'big' : ''}${i === 0 ? ' last' : ''}">${x.isBust ? 'Bust' : x.score}</i>`).join('');
      const side = (k: number) => `<div class="cl-side c${k}${thrower === k ? ' on' : ''}">
          <span class="cl-name">${thrower === k ? '<span class="cl-oche" title="Throwing">●</span>' : ''}${esc(names[k])}</span>
          <b class="poster-num">${left(k === 0)}</b>
          <span class="cl-v">${chips(k === 0) || '<em>No visits yet</em>'}</span>
          <small>${darts(k === 0)} darts</small>
        </div>`;
      return `<div class="curleg"><span class="lbl cl-h">${leg.setNumber > 1 || (leg.sets ?? 0) > 1 ? `Set ${leg.setNumber} · ` : ''}Leg ${leg.legNumber} · in play</span><div class="cl-row">${side(0)}${side(1)}</div></div>`;
    }

    function legData(t: any) {
      return (t.legs || []).slice().sort((a: any, b: any) => (a.setNumber ?? 1) - (b.setNumber ?? 1) || a.legNumber - b.legNumber).map((leg: any) => {
        const v = (leg.visits || []).slice().sort((a: any, b: any) => a.order - b.order);
        const side = (p1: boolean) => {
          const mine = v.filter((x: any) => x.isParticipant1 === p1);
          const pts = mine.reduce((n: number, x: any) => n + (x.isBust ? 0 : x.score || 0), 0);
          const darts = mine.reduce((n: number, x: any) => n + (x.numberOfDartsThrown || 0), 0);
          const won = mine.some((x: any) => x.remaining === 0);
          return { pts, darts, won, path: [501, ...mine.map((x: any) => x.remaining)], checkout: won ? mine[mine.length - 1].score : null };
        };
        const a = side(true), b = side(false);
        return { set: leg.setNumber ?? 1, n: leg.legNumber, starter: v[0]?.isParticipant1 ? 0 : 1, a, b, winner: a.won ? 0 : b.won ? 1 : null };
      });
    }

    function header(f: any, t: any, data: any) {
      const a = f.attributes, ps = [a.participant1, a.participant2];
      const status = /result/i.test(a.status) ? 'Result' : /live|progress/i.test(a.status) ? 'Live' : 'Upcoming';
      const m = t?.attributes?.fixtureMeta;
      const avg = [m?.participant1Data?.threeDartAverage, m?.participant2Data?.threeDartAverage];
      const pic = (p: any) => {
        const k = keyName(name(p));
        if (data.cutouts[k]) return `<img class="cut photo" src="${data.cutouts[k]}" alt="">`;
        if (data.portraits[k]) return `<img class="por photo" src="${data.portraits[k]}" alt="">`;
        return `<span class="ini">${esc((p?.firstName?.[0] || '') + (p?.lastName?.[0] || ''))}</span>`;
      };
      const side = (i: number) => {
        const p = ps[i]; const won = a.winnerParticipantID && String(a.winnerParticipantID) === String(p?.participantID);
        const href = p?.participantSlug ? `/players/${p.participantSlug}` : null;
        return `<div class="side s${i}${won ? ' won' : ''}">
          <div class="pic">${pic(p)}</div>
          <div class="who">${href ? `<a href="${href}">${esc(name(p))}</a>` : `<span>${esc(name(p))}</span>`}
            <small>${flag(p?.countryCode)} ${p?.ranking ? `World #${p.ranking}` : ''}${won ? ' · <b>Winner</b>' : ''}</small>
            ${avg[i] != null ? `<div class="av"><i>Average</i>${Number(avg[i]).toFixed(2)}</div>` : ''}
          </div></div>`;
      };
      const tour = a.tournament;
      const when = new Date(`${a.startDate}T${(a.startTime || '00:00').slice(0, 5)}:00Z`);
      return `
        <a class="back" href="/tournament/${tour?.tournamentID}">← ${esc((tour?.name || 'Tournament').replace(/^\d{4}\s+/, ''))}</a>
        <p class="stg">${esc(a.tournamentStage?.stage?.name || '')}${status === 'Live' ? ' · <span class="live-dot">Live</span>' : ` · ${status === 'Result' ? 'Result' : when.toLocaleString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/London' })}`}</p>
        <div class="duel">${side(0)}
          <div class="score">${status === 'Upcoming' ? '<b class="vs">v</b>' : `<b>${a.participant1Score ?? 0}</b><span>–</span><b>${a.participant2Score ?? 0}</b>`}</div>
          ${side(1)}</div>`;
    }

    function compare(f: any, t: any) {
      const m = t.attributes.fixtureMeta;
      if (!m?.participant1Data) return '<p class="muted">Stats appear once the match starts.</p>';
      const a = m.participant1Data, b = m.participant2Data;
      const rows: [string, string, number, number, (v: number) => string][] = [
        ['Three-dart average', 'threeDartAverage', a.threeDartAverage, b.threeDartAverage, v => v.toFixed(2)],
        ['First 9 average', 'first9Average', a.first9Average, b.first9Average, v => v.toFixed(2)],
        ['180s', 'score180', a.score180, b.score180, v => String(v)],
        ['140+', 'score140plus', a.score140plus ?? a.score140Plus, b.score140plus ?? b.score140Plus, v => String(v)],
        ['100+', 'score100plus', a.score100plus ?? a.score100Plus, b.score100plus ?? b.score100Plus, v => String(v)],
        ['Checkout %', 'checkoutPercentage', a.checkoutPercentage, b.checkoutPercentage, v => `${Number(v).toFixed(1)}%`],
        ['Highest checkout', 'highestCheckout', a.highestCheckout, b.highestCheckout, v => String(v || '–')],
      ];
      return rows.filter(([, , x, y]) => x != null || y != null).map(([label, , x, y, fmt]) => {
        const X = Number(x) || 0, Y = Number(y) || 0, max = Math.max(X, Y, 1);
        return `<div class="cr"><span class="v l${X > Y ? ' hi' : ''}">${fmt(X)}</span>
          <div class="bars"><i class="b0" style="width:${(X / max) * 100}%"></i></div>
          <span class="lab">${label}</span>
          <div class="bars r"><i class="b1" style="width:${(Y / max) * 100}%"></i></div>
          <span class="v r${Y > X ? ' hi' : ''}">${fmt(Y)}</span></div>`;
      }).join('');
    }

    function legend(names: string[]) {
      return names.map((n, i) => `<span><i style="background:${C[i]}"></i>${esc(n)}</span>`).join('');
    }

    // Running average after each leg: one line per player, crosshair tooltip.
    function runAvg(legs: any[], names: string[]) {
      if (!legs.length) return '<p class="muted">No legs completed yet.</p>';
      const pts = [0, 1].map(i => { let p = 0, d = 0; return legs.map(l => { const s = i ? l.b : l.a; p += s.pts; d += s.darts; return d ? (p / d) * 3 : null; }); });
      const all = pts.flat().filter((v): v is number => v != null);
      const lo = Math.floor((Math.min(...all) - 3) / 5) * 5, hi = Math.ceil((Math.max(...all) + 3) / 5) * 5;
      const W = 720, H = 240, L = 40, R = 16, T = 12, B = 28;
      const x = (i: number) => L + (legs.length === 1 ? (W - L - R) / 2 : (i / (legs.length - 1)) * (W - L - R));
      const y = (v: number) => T + (1 - (v - lo) / (hi - lo)) * (H - T - B);
      const ticks = []; for (let v = lo; v <= hi; v += (hi - lo) / 4) ticks.push(v);
      const grid = ticks.map(v => `<line x1="${L}" x2="${W - R}" y1="${y(v)}" y2="${y(v)}" class="gl"/><text x="${L - 8}" y="${y(v) + 4}" class="ax" text-anchor="end">${Math.round(v)}</text>`).join('');
      const xl = legs.map((l, i) => (legs.length <= 14 || i % Math.ceil(legs.length / 14) === 0) ? `<text x="${x(i)}" y="${H - 8}" class="ax" text-anchor="middle">${i + 1}</text>` : '').join('');
      const lines = pts.map((s, k) => `<polyline points="${s.map((v, i) => v == null ? '' : `${x(i)},${y(v)}`).join(' ')}" fill="none" stroke="${C[k]}" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>`).join('');
      const endLabels = pts.map((s, k) => { const v = s[s.length - 1]; return v == null ? '' : `<circle cx="${x(s.length - 1)}" cy="${y(v)}" r="4" fill="${C[k]}" stroke="#fff" stroke-width="2"/>`; }).join('');
      const hits = legs.map((_, i) => `<rect x="${x(i) - (W - L - R) / Math.max(legs.length, 2) / 2}" y="${T}" width="${(W - L - R) / Math.max(legs.length, 2)}" height="${H - T - B}" fill="transparent" data-i="${i}"/>`).join('');
      return `<div class="svgwrap"><svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Running three-dart average by leg">${grid}${xl}${lines}${endLabels}<line class="xh" x1="0" x2="0" y1="${T}" y2="${H - B}" hidden/>${hits}</svg><div class="tip" hidden></div></div>`
        + `<script type="application/json" class="rd">${JSON.stringify({ pts, names, W, L, R, n: legs.length })}<\/script>`;
    }

    // One row per leg: who won it (and whether it was a break of throw), how, and the score after it.
    function legTable(legs: any[], names: string[]) {
      const multiSet = legs.some(x => x.set > 1);
      const tally = [0, 0];
      return `<thead><tr><th>Leg</th><th>Winner</th><th class="n">Darts</th><th class="n">Checkout</th><th class="n">Score</th></tr></thead><tbody>${legs.map(l => {
        const w = l.winner, ws = w == null ? null : w ? l.b : l.a;
        if (w != null) tally[w]++;
        const who = w == null
          ? `<span class="ip">In play</span>`
          : `<i class="dot" style="background:${C[w]}"></i>${esc(names[w])}${w !== l.starter ? ' <span class="brk">Break</span>' : ''}`;
        return `<tr${w == null ? ' class="open"' : ''}><td class="lg-n">${multiSet ? `${l.set}.` : ''}${l.n}</td><td class="lg-w">${who}</td><td class="n">${ws?.darts ?? '–'}</td><td class="n">${ws?.checkout ?? '–'}</td><td class="n sc">${w == null ? '' : `${tally[0]}–${tally[1]}`}</td></tr>`;
      }).join('')}</tbody>`;
    }

    // Head to head from the PDC: every earlier meeting, oriented to this match's players.
    async function headToHead(f: any) {
      const box = document.getElementById('h2h'), out = document.getElementById('hh'), sub = document.getElementById('hh-sub');
      if (!box || !out || !sub || box.dataset.done === f.id) return;
      const a = f.attributes, ids = [String(a.participant1?.participantID || ''), String(a.participant2?.participantID || '')];
      if (!ids[0] || !ids[1]) return;
      box.dataset.done = f.id;
      try {
        const res = await fetch(`${API.participants}${ids[0]}/h2h/${ids[1]}`);
        if (!res.ok) return;
        const games = ((await res.json()).data || [])
          .map((x: any) => ({ id: x.id, ...x.attributes }))
          .filter((x: any) => /result/i.test(x.status) && String(x.id) !== String(f.id))
          .map((x: any) => {
            const flip = String(x.participant1ID) === ids[1];
            const s = flip ? [x.participant2Score, x.participant1Score] : [x.participant1Score, x.participant2Score];
            const w = x.winnerParticipantID ? ids.indexOf(String(x.winnerParticipantID)) : s[0] > s[1] ? 0 : s[1] > s[0] ? 1 : -1;
            return { ...x, s, w };
          })
          .sort((x: any, y: any) => `${y.startDate}${y.startTime || ''}`.localeCompare(`${x.startDate}${x.startTime || ''}`));
        const names = [last(a.participant1), last(a.participant2)];
        if (!games.length) {
          sub.textContent = '';
          out.innerHTML = `<p class="muted hh-none">${esc(names[0])} and ${esc(names[1])} haven't met in a PDC event before.</p>`;
          box.hidden = false;
          return;
        }
        const wins = [0, 1].map(k => games.filter((g: any) => g.w === k).length), draws = games.length - wins[0] - wins[1];
        const shown = games.slice(0, 6);
        sub.textContent = `${games.length} previous meeting${games.length === 1 ? '' : 's'} in PDC events${draws ? ` · ${draws} drawn` : ''}${games.length > 6 ? ' · last 6 below' : ''}`;
        const pct = (n: number) => (n / games.length) * 100;
        const evName = (n: string) => { const c = cleanName(n || ''); return c.name.replace(/^European Tour \d+ - /, ''); };
        const day = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
        out.innerHTML = `<div class="hh-sum">
            <div class="hh-n"><b class="poster-num${wins[0] > wins[1] ? ' lead' : ''}">${wins[0]}</b><span>${esc(names[0])}</span></div>
            <div class="hh-bar" role="img" aria-label="${esc(names[0])} ${wins[0]} wins, ${esc(names[1])} ${wins[1]} wins${draws ? `, ${draws} drawn` : ''}"><i style="width:${pct(wins[0])}%;background:${C[0]}"></i><i class="hh-d" style="width:${pct(draws)}%"></i><i style="width:${pct(wins[1])}%;background:${C[1]}"></i></div>
            <div class="hh-n r"><b class="poster-num${wins[1] > wins[0] ? ' lead' : ''}">${wins[1]}</b><span>${esc(names[1])}</span></div>
          </div>
          <ol class="hh-list">${shown.map((g: any) => `<li>
            <span class="hh-date">${day(g.startDate)}</span>
            <span class="hh-ev">${esc(evName(g.tournament?.name))}<small>${esc(g.stage?.name || '')}</small></span>
            <span class="hh-sc"><b class="${g.w === 0 ? 'w' : ''}"${g.w === 0 ? ` style="color:${C[0]}"` : ''}>${g.s[0]}</b><span>–</span><b class="${g.w === 1 ? 'w' : ''}"${g.w === 1 ? ` style="color:${C[1]}"` : ''}>${g.s[1]}</b></span>
          </li>`).join('')}</ol>`;
        box.hidden = false;
      } catch { /* head to head is optional */ }
    }

    function wireTip() {
      const wrap = document.querySelector<HTMLElement>('#runavg .svgwrap'); if (!wrap) return;
      const d = JSON.parse(document.querySelector('#runavg .rd')!.textContent!);
      const svg = wrap.querySelector('svg')!, tip = wrap.querySelector<HTMLElement>('.tip')!, xh = svg.querySelector<SVGLineElement>('.xh')!;
      svg.querySelectorAll<SVGRectElement>('rect[data-i]').forEach(r => {
        r.addEventListener('pointerenter', () => {
          const i = Number(r.dataset.i); const cx = d.L + (d.n === 1 ? (d.W - d.L - d.R) / 2 : (i / (d.n - 1)) * (d.W - d.L - d.R));
          xh.setAttribute('x1', String(cx)); xh.setAttribute('x2', String(cx)); xh.removeAttribute('hidden');
          tip.innerHTML = `<b>After leg ${i + 1}</b>${d.names.map((n: string, k: number) => `<span><i style="background:${C[k]}"></i>${esc(n)} ${d.pts[k][i] != null ? d.pts[k][i].toFixed(2) : '–'}</span>`).join('')}`;
          tip.hidden = false; tip.style.left = `${(cx / d.W) * 100}%`;
        });
      });
      svg.addEventListener('pointerleave', () => { tip.hidden = true; xh.setAttribute('hidden', ''); });
    }

    // Season form from the players' profile files (top 128 only).
    async function tape(ps: any[]) {
      const box = document.getElementById('tape'), tp = document.getElementById('tp');
      if (!box || !tp) return;
      const prof = await Promise.all(ps.map(p => fetch(`/data/players/${p?.participantID}.json`).then(r => (r.ok ? r.json() : null)).catch(() => null)));
      if (!prof.some(Boolean)) { box.hidden = true; return; }
      const st = prof.map(x => x?.season?.stats || null), se = prof.map(x => x?.season || null);
      const rows: [string, number | null, number | null, (v: number) => string, boolean][] = [
        ['World ranking', ps[0]?.ranking ?? null, ps[1]?.ranking ?? null, v => `#${v}`, false],
        ['Season average', st[0]?.avg ?? null, st[1]?.avg ?? null, v => v.toFixed(2), true],
        ['First 9 average', st[0]?.f9 ?? null, st[1]?.f9 ?? null, v => v.toFixed(2), true],
        ['Checkout %', st[0]?.co ?? null, st[1]?.co ?? null, v => `${v.toFixed(1)}%`, true],
        ['180s per match', st[0] ? st[0].t80 / st[0].matches : null, st[1] ? st[1].t80 / st[1].matches : null, v => v.toFixed(1), true],
        ['Matches won', se[0]?.played ? (se[0].won / se[0].played) * 100 : null, se[1]?.played ? (se[1].won / se[1].played) * 100 : null, v => `${Math.round(v)}%`, true],
      ];
      const html = rows.filter(([, x, y]) => x != null || y != null).map(([label, x, y, fmt, hiGood]) => {
        const X = x ?? 0, Y = y ?? 0, max = Math.max(X, Y, 1);
        const better = x == null || y == null || X === Y ? 0 : (X > Y) === hiGood ? 1 : 2;
        const bar = (v: number | null, k: number) => (v == null || !hiGood ? '' : `<i class="b${k}" style="width:${(v / max) * 100}%"></i>`);
        return `<div class="cr"><span class="v l${better === 1 ? ' hi' : ''}">${x == null ? '–' : fmt(X)}</span><div class="bars">${bar(x, 0)}</div><span class="lab">${label}</span><div class="bars r">${bar(y, 1)}</div><span class="v r${better === 2 ? ' hi' : ''}">${y == null ? '–' : fmt(Y)}</span></div>`;
      }).join('');
      tp.innerHTML = html;
      box.hidden = false;
    }

    async function load() {
      const id = new URLSearchParams(location.search).get('id');
      const mh = document.getElementById('mh');
      if (!mh) return;
      if (!id) { mh.innerHTML = '<div class="loading">No match selected. Open a match from a tournament page.</div>'; return; }
      const data = JSON.parse(document.getElementById('m-data')!.textContent!);
      try {
        let [f, t] = await Promise.all([fetch(FX + id, { cache: 'no-store' }).then(r => r.json()), fetch(`${FX}${id}/timeline`, { cache: 'no-store' }).then(r => (r.ok ? r.json() : null))]);
        const a = f.data;
        // PDC's live data fills the score and stats until the official feed has them.
        const tid = a.attributes.tournament?.tournamentID;
        const m: any = tid ? (await liveFor(String(tid), [String(id)])).get(String(id)) : null;
        let liveStats = false;
        if (m && m.status !== 'upcoming') {
          if (!/result/i.test(a.attributes.status)) {
            const [s1, s2] = liveScore(m, (t?.data?.attributes?.stage?.numberOfSets || 0) > 1);
            Object.assign(a.attributes, { participant1Score: s1, participant2Score: s2, status: m.status === 'live' ? 'Live' : 'Result' });
            if (m.status === 'result' && s1 !== s2) a.attributes.winnerParticipantID = (s1 > s2 ? a.attributes.participant1 : a.attributes.participant2)?.participantID;
          }
          // Every visit of every leg so far, when the official timeline doesn't have them yet.
          if (!t?.data?.attributes?.legs?.length) {
            if (!legCache.has(id)) legCache.set(id, new Map());
            const lg = await liveLegs(String(tid), String(id), m, legCache.get(id)).catch(() => []);
            if (lg.length) { t = t?.data ? t : { data: { attributes: { legs: [] } } }; t.data.attributes.legs = lg; }
          }
          if (m.stats && !t?.data?.attributes?.fixtureMeta?.participant1Data) {
            const side = (x: any) => x && { threeDartAverage: x.avg, first9Average: null, score180: x.t80, score140plus: x.t140, score100plus: x.t100, checkoutPercentage: x.co, highestCheckout: x.hi };
            t = t?.data ? t : { data: { attributes: { legs: [] } } };
            t.data.attributes.fixtureMeta = { participant1Data: side(m.stats[0]), participant2Data: side(m.stats[1]) };
            liveStats = true;
          }
        }
        const names = [last(a.attributes.participant1), last(a.attributes.participant2)];
        document.title = `${name(a.attributes.participant1)} v ${name(a.attributes.participant2)} · The Oche`;
        mh.innerHTML = header(a, t?.data, data);
        const legs = t?.data ? legData(t.data.attributes) : [];
        const playing = m?.status === 'live' ? t?.data?.attributes?.legs?.find((l: any) => (l.setNumber ?? 1) === (m.set || 1) && l.legNumber === m.leg) : null;
        if (playing) {
          // Nobody has thrown yet: players alternate who starts each leg.
          if (playing.throwing == null && !playing.visits.length) {
            const prev = t.data.attributes.legs.find((l: any) => (l.setNumber ?? 1) === (playing.setNumber ?? 1) && l.legNumber === playing.legNumber - 1);
            const first = prev?.visits?.slice().sort((x: any, y: any) => x.order - y.order)[0];
            if (first) playing.throwing = first.isParticipant1 ? 1 : 0;
          }
          mh.insertAdjacentHTML('beforeend', currentLeg(playing, names));
        }
        // Key numbers under the score: each player's average, best checkout, shortest leg.
        const meta = t?.data?.attributes?.fixtureMeta;
        if (meta?.participant1Data && legs.length) {
          const won = legs.filter(l => l.winner != null).map(l => ({ l, s: l.winner ? l.b : l.a }));
          const best = won.filter(x => x.s.checkout).sort((x, y) => y.s.checkout - x.s.checkout)[0];
          const fast = won.slice().sort((x, y) => x.s.darts - y.s.darts)[0];
          const kpi = (v: string, label: string, hi = false) => `<div><b class="poster-num${hi ? ' hi' : ''}">${v}</b><span class="lbl">${label}</span></div>`;
          mh.insertAdjacentHTML('beforeend', `<div class="kpis">${kpi(Number(meta.participant1Data.threeDartAverage).toFixed(2), `${esc(names[0])} average`, meta.participant1Data.threeDartAverage >= meta.participant2Data.threeDartAverage)}${best ? kpi(String(best.s.checkout), `Best checkout · leg ${best.l.n} · ${esc(names[best.l.winner])}`) : ''}${fast ? kpi(String(fast.s.darts), `Shortest leg · darts · ${esc(names[fast.l.winner])}`) : ''}${kpi(Number(meta.participant2Data.threeDartAverage).toFixed(2), `${esc(names[1])} average`, meta.participant2Data.threeDartAverage > meta.participant1Data.threeDartAverage)}</div>`);
        }
        const started = !/result|live|progress/i.test(a.attributes.status) && new Date(`${a.attributes.startDate}T${(a.attributes.startTime || '23:59').slice(0, 5)}:00`) <= new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/London' }));
        const noLegs = !(t?.data?.attributes?.legs?.length);
        const isResult = /result/i.test(a.attributes.status);
        const isLive = /live|progress/i.test(a.attributes.status);
        if (isLive && liveStats) mh.insertAdjacentHTML('beforeend', `<p class="inplay"><span class="live-dot">Live</span> Score and stats update every few seconds. <a href="https://www.pdc.tv/matches/${esc(id)}" target="_blank" rel="noopener">Follow it dart by dart on pdc.tv ↗</a></p>`);
        else if (isResult && noLegs) mh.insertAdjacentHTML('beforeend', `<p class="inplay"><b>Result confirmed.</b> ${liveStats ? 'Stats are from PDC live scoring; the' : 'The PDC adds averages and'} leg-by-leg detail follows when the PDC publishes it. This page checks again every two minutes and fills in on its own.</p>`);
        if (!document.getElementById('tp')!.innerHTML) tape([a.attributes.participant1, a.attributes.participant2]);
        headToHead(a);
        if (started && noLegs && !m?.stats) mh.insertAdjacentHTML('beforeend', `<p class="inplay"><span class="live-dot">On now</span> This match should be under way. The PDC's public feed publishes scores when a match finishes, so this page fills in then. <a href="https://www.pdc.tv/matches/${esc(id)}" target="_blank" rel="noopener">Follow it dart by dart on pdc.tv ↗</a></p>`);
        // Stats show as soon as there are any; the leg charts wait for the visit data.
        const mb = document.getElementById('mb')!;
        mb.hidden = !t?.data?.attributes?.fixtureMeta?.participant1Data && noLegs;
        mb.querySelectorAll<HTMLElement>('.block:not(:first-child)').forEach(b => { b.hidden = noLegs; });
        if (t?.data) {
          document.getElementById('cmp')!.innerHTML = compare(a, t.data);
          document.getElementById('lg1')!.innerHTML = legend(names);
          document.getElementById('runavg')!.innerHTML = runAvg(legs.filter(l => l.winner != null), names);
          document.getElementById('lt')!.innerHTML = legTable(legs, names);
          wireTip();
        }
        clearTimeout(timer);
        if (isLive) timer = window.setTimeout(load, LIVE_TICK);
        else if (!isResult && a.attributes.startDate <= new Date().toISOString().slice(0, 10)) timer = window.setTimeout(load, 15_000);
        else if (isResult && noLegs) timer = window.setTimeout(load, 120_000);
      } catch {
        mh.innerHTML = '<div class="loading">This match could not be loaded. Please try again shortly.</div>';
      }
    }
    document.addEventListener('astro:page-load', () => { clearTimeout(timer); if (document.getElementById('mh')) load(); });
  </script>
</Layout>

<style>
  .mhead { color: #fff; background: var(--ink); border-top: 1px solid var(--ink-2); }
  .mh-in { padding: 24px 0 0; min-height: 300px; }
  .mh-in :global(.loading) { padding: 80px 0; text-align: center; color: rgba(255, 255, 255, .75); }
  .mh-in :global(.spinner) { display: inline-block; width: 22px; height: 22px; border-radius: 50%; border: 3px solid rgba(255, 255, 255, .2); border-top-color: #fff; animation: rot .8s linear infinite; margin-right: 10px; vertical-align: middle; }
  @keyframes rot { to { transform: rotate(360deg); } }
  .mh-in :global(.back) { color: rgba(255, 255, 255, .75); text-decoration: none; font-weight: 600; font-size: 14px; }
  .mh-in :global(.back:hover) { color: #fff; }
  .mh-in :global(.stg) { margin: 10px 0 0; font-weight: 700; color: rgba(255, 255, 255, .8); }
  .mh-in :global(.duel) { display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 16px; margin-top: 8px; }
  .mh-in :global(.side) { display: flex; align-items: flex-end; gap: 16px; min-width: 0; }
  .mh-in :global(.s1) { flex-direction: row-reverse; text-align: right; }
  .mh-in :global(.pic) { width: 170px; height: 210px; flex: none; display: flex; align-items: flex-end; justify-content: center; overflow: hidden; }
  .mh-in :global(.pic .cut) { height: 100%; width: auto; max-width: none; }
  .mh-in :global(.pic .por) { width: 120px; height: 120px; border-radius: 50%; object-fit: cover; margin-bottom: 30px; }
  .mh-in :global(.pic .ini) { width: 110px; height: 110px; border-radius: 50%; display: grid; place-items: center; background: rgba(255, 255, 255, .12); font-family: var(--display); font-size: 40px; font-weight: 800; margin-bottom: 30px; }
  .mh-in :global(.who) { display: flex; flex-direction: column; gap: 4px; padding-bottom: 26px; min-width: 0; }
  .mh-in :global(.who a), .mh-in :global(.who > span) { font-family: var(--poster); text-transform: uppercase; font-size: clamp(30px, 4vw, 60px); font-weight: 400; color: #fff; text-decoration: none; line-height: .92; }
  .mh-in :global(.side:not(.won) .who a) { color: var(--on-ink); }
  .mh-in :global(.who a:hover) { text-decoration: underline; }
  .mh-in :global(.who small) { color: rgba(255, 255, 255, .75); font-size: 13px; }
  .mh-in :global(.av) { display: inline-flex; flex-direction: column; align-self: flex-start; margin-top: 6px; background: #fff; color: var(--ink); border-radius: 12px; padding: 6px 12px; font-family: var(--display); font-size: 22px; font-weight: 800; font-variant-numeric: tabular-nums; }
  .mh-in :global(.s1 .av) { align-self: flex-end; }
  .mh-in :global(.av i) { font-style: normal; font-family: var(--body); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .mh-in :global(.s0 .av) { box-shadow: inset 4px 0 0 #1d3fd6; }
  .mh-in :global(.s1 .av) { box-shadow: inset -4px 0 0 #d7263d; }
  .mh-in :global(.score) { display: flex; align-items: baseline; gap: 10px; padding-bottom: 40px; font-family: var(--display); }
  .mh-in :global(.score b) { font-family: var(--poster); font-weight: 400; font-size: clamp(110px, 16vw, 260px); line-height: .86; color: var(--volt); font-variant-numeric: tabular-nums; }
  .mh-in :global(.score b.vs) { color: #fff; }
  .mh-in :global(.score .vs) { font-size: 56px; color: rgba(255, 255, 255, .5); }
  .mh-in :global(.score span) { font-family: var(--poster); font-size: clamp(60px, 8vw, 140px); color: #3a3d47; }
  .mh-in :global(.score small) { position: absolute; }
  .mh-in :global(.score small) { display: none; }

  /* The leg in play */
  .mh-in :global(.curleg) { margin: 0 0 22px; background: rgba(255, 255, 255, .06); border: 1px solid var(--ink-2); border-radius: 18px; padding: 14px 18px 16px; }
  .mh-in :global(.cl-h) { color: var(--on-ink-2); display: block; margin-bottom: 10px; }
  .mh-in :global(.cl-row) { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .mh-in :global(.cl-side) { display: grid; grid-template-columns: auto 1fr; grid-template-areas: 'name name' 'left v' 'left n'; column-gap: 16px; align-items: center; }
  .mh-in :global(.cl-side.c1) { grid-template-columns: 1fr auto; grid-template-areas: 'name name' 'v left' 'n left'; text-align: right; }
  .mh-in :global(.cl-name) { grid-area: name; font-weight: 800; font-size: 14px; color: rgba(255, 255, 255, .85); margin-bottom: 2px; }
  .mh-in :global(.cl-oche) { color: var(--volt); margin-right: 6px; font-size: 11px; vertical-align: 2px; }
  .mh-in :global(.c1 .cl-oche) { margin: 0 0 0 6px; float: right; }
  .mh-in :global(.cl-side b) { grid-area: left; font-family: var(--poster); font-weight: 400; font-size: clamp(54px, 7vw, 84px); line-height: .95; color: #fff; font-variant-numeric: tabular-nums; }
  .mh-in :global(.cl-side.on b) { color: var(--volt); }
  .mh-in :global(.cl-v) { grid-area: v; display: flex; flex-wrap: wrap; gap: 5px; }
  .mh-in :global(.c1 .cl-v) { justify-content: flex-end; }
  .mh-in :global(.cl-v i) { font-style: normal; font-weight: 800; font-size: 13px; min-width: 38px; text-align: center; padding: 3px 8px; border-radius: 8px; background: rgba(255, 255, 255, .1); color: rgba(255, 255, 255, .85); font-variant-numeric: tabular-nums; }
  .mh-in :global(.cl-v i.big) { background: rgba(200, 255, 46, .18); color: var(--volt); }
  .mh-in :global(.cl-v i.bust) { background: rgba(232, 54, 45, .25); color: #ff8a80; }
  .mh-in :global(.cl-v i.last) { outline: 1px solid rgba(255, 255, 255, .35); }
  .mh-in :global(.cl-v em) { font-style: normal; font-size: 13px; color: var(--on-ink-2); }
  .mh-in :global(.cl-side small) { grid-area: n; font-size: 12px; color: var(--on-ink-2); margin-top: 4px; }
  @media (max-width: 640px) {
    .mh-in :global(.cl-row) { gap: 12px; }
    .mh-in :global(.cl-side), .mh-in :global(.cl-side.c1) { grid-template-columns: 1fr; grid-template-areas: 'name' 'left' 'v' 'n'; }
    .mh-in :global(.cl-v) { margin-top: 6px; }
    .mh-in :global(.cl-v i) { min-width: 0; font-size: 12px; padding: 2px 6px; }
  }
  .mh-in :global(.inplay) { margin: 0 0 22px; font-size: 14px; color: rgba(255, 255, 255, .85); background: rgba(255, 255, 255, .08); border-radius: 12px; padding: 10px 14px; }
  .mh-in :global(.inplay a) { color: #fff; font-weight: 700; }
  .mh-in :global(.inplay .live-dot) { color: #ff8a98; margin-right: 6px; }
  .tape, .h2h { margin-top: 28px; }

  /* Head to head: wins either side of a split bar, then the latest meetings */
  .h2h :global(.hh-sum) { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 18px; background: var(--card); border-radius: var(--tile) var(--tile) 0 0; padding: 18px 22px; }
  .h2h :global(.hh-n) { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; min-width: 64px; }
  .h2h :global(.hh-n.r) { align-items: flex-end; text-align: right; }
  .h2h :global(.hh-n b) { font-size: 52px; line-height: .9; color: var(--muted); }
  .h2h :global(.hh-n b.lead) { color: var(--ink); }
  .h2h :global(.hh-n span) { font-size: 13px; font-weight: 700; }
  .h2h :global(.hh-bar) { display: flex; height: 12px; border-radius: 99px; overflow: hidden; background: var(--paper-2); }
  .h2h :global(.hh-bar i) { display: block; height: 100%; }
  .h2h :global(.hh-bar .hh-d) { background: #c9c2b2; }
  .h2h :global(.hh-list) { list-style: none; margin: 0; padding: 0 22px 8px; background: var(--card); border-radius: 0 0 var(--tile) var(--tile); }
  .h2h :global(.hh-list li) { display: grid; grid-template-columns: 104px minmax(0, 1fr) auto; align-items: center; gap: 14px; padding: 11px 0; border-top: 1px solid var(--line); font-size: 14px; }
  .h2h :global(.hh-date) { color: var(--muted); font-weight: 600; font-size: 13px; white-space: nowrap; }
  .h2h :global(.hh-ev) { display: flex; flex-direction: column; min-width: 0; font-weight: 700; }
  .h2h :global(.hh-ev small) { color: var(--muted); font-weight: 600; font-size: 12px; }
  .h2h :global(.hh-sc) { display: inline-flex; align-items: center; gap: 6px; font-family: var(--poster); font-size: 24px; font-variant-numeric: tabular-nums; }
  .h2h :global(.hh-sc b) { font-weight: 400; color: var(--muted); min-width: 1.2ch; text-align: center; }
  .h2h :global(.hh-sc span) { color: var(--line); }
  .h2h :global(.hh-none) { background: var(--card); border-radius: var(--tile); padding: 18px 22px; margin: 0; }
  .mh-in :global(.kpis) { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--ink-2); }
  .mh-in :global(.kpis > div) { padding: 20px 0; display: flex; flex-direction: column; gap: 8px; }
  .mh-in :global(.kpis > div + div) { border-left: 1px solid var(--ink-2); padding-left: 22px; }
  .mh-in :global(.kpis b) { font-size: clamp(34px, 4vw, 54px); }
  .mh-in :global(.kpis b.hi) { color: var(--volt); }
  .mh-in :global(.kpis .lbl) { color: var(--on-ink-2); }
  .mbody { margin-top: 28px; }
  .block + .block { margin-top: 36px; }
  h2 { font-size: 40px; margin-bottom: 8px; }
  .sub { margin: 0 0 14px; color: var(--muted); font-size: 14px; }
  .bh { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 10px; }
  .legend { display: flex; gap: 16px; font-size: 13px; font-weight: 700; }
  .legend :global(span) { display: inline-flex; align-items: center; gap: 6px; }
  .legend :global(i), .lt :global(.dot) { display: inline-block; width: 10px; height: 10px; border-radius: 3px; }

  .cmp { background: var(--card); border-radius: var(--tile); padding: 10px 24px; }
  .cmp :global(.cr) { display: grid; grid-template-columns: 130px 1fr 150px 1fr 130px; align-items: center; gap: 12px; padding: 10px 0; border-top: 1px solid var(--line); font-variant-numeric: tabular-nums; }
  .cmp :global(.cr:first-child) { border-top: 0; }
  .cmp :global(.v) { font-weight: 700; color: var(--muted); }
  .cmp :global(.v.l) { text-align: right; }
  .cmp :global(.v.hi) { color: var(--ink); font-weight: 800; }
  .cmp :global(.lab) { text-align: center; font-size: 13px; font-weight: 700; color: var(--ink-2); }
  .cmp :global(.bars) { height: 8px; display: flex; justify-content: flex-end; }
  .cmp :global(.bars.r) { justify-content: flex-start; }
  .cmp :global(.bars i) { height: 100%; border-radius: 4px; transition: width .6s var(--ease); }
  .cmp :global(.b0) { background: #1d3fd6; }
  .cmp :global(.b1) { background: #d7263d; }

  .chart { background: var(--card); border-radius: var(--tile); padding: 18px; }
  .chart :global(.svgwrap) { position: relative; }
  .chart :global(svg) { width: 100%; height: auto; display: block; }
  :global(.gl) { stroke: var(--line); stroke-width: 1; }
  :global(.ax) { fill: var(--muted); font-size: 11px; font-family: var(--body); }
  .chart :global(.xh) { stroke: var(--ink-2); stroke-width: 1; stroke-dasharray: 3 3; }
  .chart :global(.tip) { position: absolute; top: 8px; transform: translateX(-50%); background: var(--ink); color: #fff; border-radius: 10px; padding: 8px 10px; font-size: 12px; display: flex; flex-direction: column; gap: 3px; pointer-events: none; white-space: nowrap; }
  .chart :global(.tip span) { display: inline-flex; align-items: center; gap: 6px; font-variant-numeric: tabular-nums; }
  .chart :global(.tip i) { width: 8px; height: 8px; border-radius: 2px; display: inline-block; }


  .tablewrap { overflow-x: auto; background: var(--card); border-radius: var(--tile); }
  .lt { width: 100%; border-collapse: collapse; font-size: 14px; font-variant-numeric: tabular-nums; }
  .lt :global(th) { text-align: left; font-size: 12px; color: var(--muted); font-weight: 700; padding: 10px 14px; border-bottom: 1px solid var(--line); white-space: nowrap; }
  .lt :global(td) { padding: 9px 14px; border-top: 1px solid var(--line); white-space: nowrap; }
  .lt :global(.n) { text-align: right; }
  .lt :global(.dot) { margin-right: 8px; vertical-align: -1px; }
  .lt :global(.brk) { font-size: 10px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--ink); background: var(--volt); border-radius: 6px; padding: 2px 6px; margin-left: 8px; vertical-align: 1px; }
  .lt :global(.lg-n) { width: 48px; color: var(--muted); font-weight: 700; }
  .lt :global(.lg-w) { font-weight: 700; }
  .lt :global(.sc) { font-family: var(--poster); font-size: 18px; }
  .lt :global(tr.open td) { color: var(--muted); }
  .lt :global(.ip) { font-weight: 700; color: var(--red); }

  @media (max-width: 760px) {
    .mh-in :global(.kpis) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mh-in :global(.kpis > div:nth-child(3)) { border-left: 0; padding-left: 0; }
    .mh-in :global(.pic) { width: 96px; height: 130px; }
    .mh-in :global(.pic .por), .mh-in :global(.pic .ini) { width: 72px; height: 72px; font-size: 26px; margin-bottom: 20px; }
    .mh-in :global(.side) { flex-direction: column; align-items: flex-start; gap: 6px; }
    .mh-in :global(.s1) { flex-direction: column; align-items: flex-end; }
    .mh-in :global(.who) { padding-bottom: 14px; }
    .mh-in :global(.score) { padding-bottom: 60px; }
    .cmp :global(.cr) { grid-template-columns: 1fr 1fr; row-gap: 4px; }
    .cmp :global(.lab) { grid-column: 1 / -1; grid-row: 1; }
    .cmp :global(.bars) { display: none; }
    .cmp :global(.v.l) { text-align: left; } .cmp :global(.v.r) { grid-column: 2; text-align: right; }
    .lt :global(th), .lt :global(td) { padding-left: 10px; padding-right: 10px; }
    .lt :global(.lg-n) { width: 32px; }
    .h2h :global(.hh-sum) { padding: 16px; gap: 12px; }
    .h2h :global(.hh-n) { min-width: 0; }
    .h2h :global(.hh-n b) { font-size: 40px; }
    .h2h :global(.hh-list) { padding: 0 16px 6px; }
    .h2h :global(.hh-list li) { grid-template-columns: minmax(0, 1fr) auto; gap: 2px 12px; }
    .h2h :global(.hh-date) { grid-column: 1 / -1; font-size: 12px; }
  }
</style>
