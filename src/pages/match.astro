---
// Match centre: /match?id=<fixtureId>. Rendered in the browser from the PDC
// fixture feed (players, score) and its timeline (every visit), refreshed
// every 15 seconds while the match is live.
import Layout from '../layouts/Layout.astro';
---
<Layout title="Match centre" description="Live score, statistics, leg table and head to head for a PDC darts match.">
  <section class="mhead" aria-live="polite">
    <div class="wrap mh-in" id="mh"><div class="loading"><span class="spinner"></span>Loading match…</div></div>
  </section>

  <!-- Once a match starts: two tabs, Match stats (default) and Head to head & form -->
  <div id="mtabbed">
  <div class="wrap mtabs" id="mtabs" role="tablist" aria-label="Match sections" hidden>
    <button class="mt" role="tab" data-mt="stats" aria-selected="true">Match stats</button>
    <button class="mt" role="tab" data-mt="h2h" aria-selected="false">Head to head &amp; form</button>
  </div>
  <p class="wrap muted mb-wait" id="mb-wait" hidden>Match stats appear here after the first leg.</p>

  <section class="wrap h2h" id="h2h" hidden>
    <h2>Head to head</h2>
    <p class="sub" id="hh-sub"></p>
    <div id="hh"></div>
  </section>

  <section class="wrap tape" id="tape" hidden>
    <h2>Form</h2>
    <p class="sub">How the two players have gone in PDC main-tour events over the last 12 months.</p>
    <div class="cmp" id="tp"></div>
  </section>

  <div class="wrap mbody" id="mb" hidden>
    <section class="block">
      <h2>Match stats</h2>
      <div class="cmp" id="cmp"></div>
    </section>

    <section class="block">
      <div class="bh"><h2>Average through the match</h2><div class="legend" id="lg1"></div></div>
      <p class="sub">Each player's running three-dart average after every leg (legs along the bottom).</p>
      <div class="chart" id="runavg"></div>
    </section>

    <section class="block">
      <h2>Leg table</h2>
      <div class="tablewrap"><table class="lt" id="lt"></table></div>
    </section>
  </div>
  </div>

  <script>
    import { onBreak, visitShown, API, flag, keyName, liveScore, liveLegs, cleanName, formatLabel } from '../lib/pdc.mjs';
    import { fetchH2H, h2hSummary, renderH2H } from '../lib/h2h.mjs';
    import { liveFor, watchLive, unwatch, isPushing, pushedLegFor, LIVE_TICK, PUSH_TICK } from '../lib/live-client.mjs';
    import { ukTime, scoreHtml } from '../lib/format.mjs';
    import { watchWins, watch180, flashWin, heldThrow } from '../lib/leg-flash.mjs';
    import { getDelay } from '../lib/tv-delay.mjs';
    import { patch } from '../lib/morph.mjs';
    import { cutoutImg, avatarSrc, pairPrefer } from '../lib/images.mjs';
    // Share a finished match: the phone's share sheet, else copy the link.
    const SHARE_SVG = '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3v12M7.5 7.5 12 3l4.5 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 11H6.5A1.5 1.5 0 0 0 5 12.5v7A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5v-7a1.5 1.5 0 0 0-1.5-1.5H16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
    const shareIcon = (text: string, id: any) => ` <button type="button" class="share-ic" data-share data-text="${esc(text)}" data-id="${esc(id ?? '')}" aria-label="Share result" title="Share result">${SHARE_SVG}</button>`;
    if (!(window as any).__ocheShare) {
      (window as any).__ocheShare = true;
      document.addEventListener('click', async e => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-share]');
        if (!b) return;
        const url = `${location.origin}/match?id=${b.dataset.id}`, text = b.dataset.text || '';
        try {
          if (navigator.share) { await navigator.share({ title: text, text, url }); return; }
          await navigator.clipboard.writeText(`${text} ${url}`);
          b.classList.add('copied'); b.title = 'Link copied'; setTimeout(() => { b.classList.remove('copied'); b.title = 'Share result'; }, 2000);
        } catch { /* cancelled */ }
      });
    }

    const FX = 'https://fixtures.darts.web.gc.pdcservices.co.uk/v2/';
    const C = ['#2b4bff', '#e8362d']; // player 1 blue, player 2 red (validated pair)
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    const name = (p: any) => [p?.firstName, p?.lastName].filter(Boolean).join(' ');
    const last = (p: any) => p?.lastName || name(p);
    let timer: number | undefined;
    let holdTimer: number | undefined; // ends the hold on the throw after a 180
    // Finished legs from the live data, kept between polls (per match).
    const legCache = new Map<string, Map<string, any>>();
    let ftCache: { id: string | null; at: number; f: any; t: any } = { id: null, at: 0, f: null, t: null };

    function legData(t: any) {
      return (t.legs || []).slice().sort((a: any, b: any) => (a.setNumber ?? 1) - (b.setNumber ?? 1) || a.legNumber - b.legNumber).map((leg: any) => {
        const v = (leg.visits || []).slice().sort((a: any, b: any) => a.order - b.order);
        const side = (p1: boolean) => {
          const mine = v.filter((x: any) => x.isParticipant1 === p1);
          const pts = mine.reduce((n: number, x: any) => n + (x.isBust ? 0 : x.score || 0), 0);
          const darts = mine.reduce((n: number, x: any) => n + (x.numberOfDartsThrown || 0), 0);
          const won = mine.some((x: any) => x.remaining === 0);
          return { pts, darts, won, path: [501, ...mine.map((x: any) => x.remaining)], checkout: won ? mine[mine.length - 1].score : null };
        };
        const a = side(true), b = side(false);
        return { set: leg.setNumber ?? 1, n: leg.legNumber, starter: v[0]?.isParticipant1 ? 0 : 1, a, b, winner: a.won ? 0 : b.won ? 1 : null };
      });
    }

    function header(f: any, t: any, data: any, live: any = null, leg: any = null, brk = false, hold: number | null = null) {
      const a = f.attributes, ps = [a.participant1, a.participant2];
      const ts = a.tournamentStage || {};
      const sets = (ts.numberOfSets || 0) > 1;
      const fmt = formatLabel({ sets, bestOf: sets ? ts.numberOfSets : ts.numberOfLegsPerSet, twoClear: ts.twoClearLegsToWin });
      const status = /result/i.test(a.status) ? 'Result' : /live|progress/i.test(a.status) ? 'Live' : 'Upcoming';
      const m = t?.attributes?.fixtureMeta;
      const avg = [m?.participant1Data?.threeDartAverage, m?.participant2Data?.threeDartAverage];
      const pic = (p: any) => {
        const cut = cutoutImg(name(p), 'cut photo', '(max-width: 760px) 96px, 170px', '', pairPrefer(name(ps[0]), name(ps[1])), true);
        if (cut) return cut;
        const av = avatarSrc(name(p));
        if (av) return `<img class="por photo" src="${av}" alt="" width="112" height="112">`;
        return `<span class="ini">${esc((p?.firstName?.[0] || '') + (p?.lastName?.[0] || ''))}</span>`;
      };
      const side = (i: number) => {
        const p = ps[i]; const won = a.winnerParticipantID && String(a.winnerParticipantID) === String(p?.participantID);
        const href = p?.participantSlug ? `/players/${p.participantSlug}` : null;
        return `<div class="side s${i}${won ? ' won' : ''}">
          <div class="pic">${pic(p)}</div>
          <div class="who">${href ? `<a href="${href}">${esc(name(p))}</a>` : `<span>${esc(name(p))}</span>`}
            <small>${flag(p?.countryCode)} ${p?.ranking ? `World #${p.ranking}` : ''}</small>
            ${avg[i] != null ? `<div class="av"><i>Average</i>${Number(avg[i]).toFixed(2)}</div>` : ''}
          </div></div>`;
      };
      const tour = a.tournament;
      // Start: "Thu 19 Nov · 9:15pm GMT" (the feed's times are UK local time).
      const when = `${new Date(`${a.startDate}T12:00:00Z`).toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' })}${ukTime(a.startTime, a.startDate) ? ` · ${ukTime(a.startTime, a.startDate)}` : ''}`;
      // In play: a scoreboard. Pictures, then each player's score left (the hero
      // number) with their average under it and the match score small between them,
      // then names. The same order as the homepage tile.
      if (status === 'Live' && leg) {
        const v = (leg.visits || []).slice().sort((x: any, y: any) => x.order - y.order);
        const left = (k: number) => v.filter((x: any) => x.isParticipant1 === (k === 0)).at(-1)?.remaining ?? 501;
        const fin = v.find((x: any) => x.remaining === 0);
        const won = fin ? (fin.isParticipant1 ? 0 : 1) : null;
        const lastV = v.at(-1);
        // After a 180 the throw stays with whoever hit it until the 180 sticker has gone.
        const thr = won != null ? null : hold ?? leg.throwing ?? (lastV ? (lastV.isParticipant1 ? 1 : 0) : null);
        // Under each dot: the visit being thrown (running total) or the player's last visit.
        // It follows the dot as shown (a 180 holds the dot, and its 180, on the thrower).
        const vt = (k: number) => { const x = won != null ? null : visitShown({ ...leg, throwing: thr, holdK: hold }, k); return x ? `<span class="lb-vt${x.live ? ' live' : ''}" title="${x.live ? 'This visit so far' : 'Last visit'}">${x.n}</span>` : ''; };
        const big = (k: number) => `<div class="lb-s s${k}${thr === k ? ' on' : ''}${won === k ? ' won' : ''}">
            <b class="poster-num"><span class="lb-dot" aria-label="throwing"${thr === k ? '' : ' hidden'}></span>${vt(k)}${left(k)}</b>
            <span class="lb-av" title="Three-dart average">${avg[k] != null ? `${Number(avg[k]).toFixed(2)} <i>avg</i>` : ''}</span></div>`;
        const who = (k: number) => { const p = ps[k]; const href = p?.participantSlug ? `/players/${p.participantSlug}` : null;
          return `<div class="who w${k}">${href ? `<a href="${href}">${esc(name(p))}</a>` : `<span>${esc(name(p))}</span>`}<small>${flag(p?.countryCode)} ${p?.ranking ? `World #${p.ranking}` : ''}</small></div>`; };
        const mid = `<div class="lb-mid"><span class="lbl">${sets ? 'Sets' : 'Legs'}</span><b class="poster-num">${scoreHtml(a.participant1Score, a.participant2Score)}</b>${sets && live ? `<span class="lbl">Legs <b>${scoreHtml(live.legs[0], live.legs[1])}</b></span>` : ''}${brk ? '<span class="brk-tag">Break</span>' : ''}</div>`;
        return `
        <a class="back" href="/tournament/${tour?.tournamentID}">← ${esc((tour?.name || 'Tournament').replace(/^\d{4}\s+/, ''))}</a>
        <p class="stg">${esc(a.tournamentStage?.stage?.name || '')}${fmt ? ` · ${esc(fmt)}` : ''} · Leg ${leg.legNumber} · <span class="live-dot">Live</span></p>
        <div class="board${brk ? ' brk' : ''}">
          <div class="pic p0">${pic(ps[0])}</div><div class="pic p1">${pic(ps[1])}</div>
          ${big(0)}${mid}${big(1)}
          ${who(0)}${who(1)}
        </div>`;
      }
      return `
        <a class="back" href="/tournament/${tour?.tournamentID}">← ${esc((tour?.name || 'Tournament').replace(/^\d{4}\s+/, ''))}</a>
        <p class="stg">${esc(a.tournamentStage?.stage?.name || '')}${fmt ? ` · ${esc(fmt)}` : ''}${status === 'Live' ? ' · <span class="live-dot">Live</span>' : ` · ${status === 'Result' ? `Result${shareIcon(`${name(ps[0])} ${a.participant1Score ?? 0}–${a.participant2Score ?? 0} ${name(ps[1])} · ${(tour?.name || '').replace(/^\d{4}\s+/, '')}`, f.id ?? a.fixtureID)}` : when}`}</p>
        <div class="duel">${side(0)}
          <div class="score${Math.max(a.participant1Score ?? 0, a.participant2Score ?? 0) >= 10 ? ' wide' : ''}">${status === 'Upcoming' ? '<b class="vs">v</b>' : `<div class="sc-n"><b>${a.participant1Score ?? 0}</b><span>–</span><b>${a.participant2Score ?? 0}</b></div>${sets ? `<p class="sc-sub">Sets${status === 'Live' && live ? ` · Set ${live.set || 1}, legs <b>${scoreHtml(live.legs[0], live.legs[1])}</b>` : ''}</p>` : ''}`}</div>
          ${side(1)}</div>`;
    }

    function compare(f: any, t: any) {
      const m = t.attributes.fixtureMeta;
      if (!m?.participant1Data) return '<p class="muted">Stats appear once the match starts.</p>';
      const a = m.participant1Data, b = m.participant2Data;
      const rows: [string, string, number, number, (v: number) => string][] = [
        ['Three-dart average', 'threeDartAverage', a.threeDartAverage, b.threeDartAverage, v => v.toFixed(2)],
        ['First 9 average', 'first9Average', a.first9Average, b.first9Average, v => v.toFixed(2)],
        ['180s', 'score180', a.score180, b.score180, v => String(v)],
        ['140+', 'score140plus', a.score140plus ?? a.score140Plus, b.score140plus ?? b.score140Plus, v => String(v)],
        ['100+', 'score100plus', a.score100plus ?? a.score100Plus, b.score100plus ?? b.score100Plus, v => String(v)],
        ['Checkout %', 'checkoutPercentage', a.checkoutPercentage, b.checkoutPercentage, v => `${Number(v).toFixed(1)}%`],
        ['Highest checkout', 'highestCheckout', a.highestCheckout, b.highestCheckout, v => String(v || '–')],
      ];
      return rows.filter(([, , x, y]) => x != null || y != null).map(([label, , x, y, fmt]) => {
        const X = Number(x) || 0, Y = Number(y) || 0, max = Math.max(X, Y, 1);
        return `<div class="cr"><span class="v l${X > Y ? ' hi' : ''}">${fmt(X)}</span>
          <div class="bars"><i class="b0" style="width:${(X / max) * 100}%"></i></div>
          <span class="lab">${label}</span>
          <div class="bars r"><i class="b1" style="width:${(Y / max) * 100}%"></i></div>
          <span class="v r${Y > X ? ' hi' : ''}">${fmt(Y)}</span></div>`;
      }).join('');
    }

    function legend(names: string[]) {
      return names.map((n, i) => `<span><i style="background:${C[i]}"></i>${esc(n)}</span>`).join('');
    }

    // Running average after each leg: one line per player, crosshair tooltip.
    function runAvg(legs: any[], names: string[]) {
      if (!legs.length) return '<p class="muted">No legs completed yet.</p>';
      const pts = [0, 1].map(i => { let p = 0, d = 0; return legs.map(l => { const s = i ? l.b : l.a; p += s.pts; d += s.darts; return d ? (p / d) * 3 : null; }); });
      const all = pts.flat().filter((v): v is number => v != null);
      const lo = Math.floor((Math.min(...all) - 3) / 5) * 5, hi = Math.ceil((Math.max(...all) + 3) / 5) * 5;
      const W = 720, H = 240, L = 40, R = 16, T = 12, B = 28;
      const x = (i: number) => L + (legs.length === 1 ? (W - L - R) / 2 : (i / (legs.length - 1)) * (W - L - R));
      const y = (v: number) => T + (1 - (v - lo) / (hi - lo)) * (H - T - B);
      const ticks = []; for (let v = lo; v <= hi; v += (hi - lo) / 4) ticks.push(v);
      const grid = ticks.map(v => `<line x1="${L}" x2="${W - R}" y1="${y(v)}" y2="${y(v)}" class="gl"/><text x="${L - 8}" y="${y(v) + 4}" class="ax" text-anchor="end">${Math.round(v)}</text>`).join('');
      const xl = legs.map((l, i) => (legs.length <= 14 || i % Math.ceil(legs.length / 14) === 0) ? `<text x="${x(i)}" y="${H - 8}" class="ax" text-anchor="middle">${i + 1}</text>` : '').join('');
      const lines = pts.map((s, k) => `<polyline points="${s.map((v, i) => v == null ? '' : `${x(i)},${y(v)}`).join(' ')}" fill="none" stroke="${C[k]}" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>`).join('');
      const endLabels = pts.map((s, k) => { const v = s[s.length - 1]; return v == null ? '' : `<circle cx="${x(s.length - 1)}" cy="${y(v)}" r="4" fill="${C[k]}" stroke="#fff" stroke-width="2"/>`; }).join('');
      const hits = legs.map((_, i) => `<rect x="${x(i) - (W - L - R) / Math.max(legs.length, 2) / 2}" y="${T}" width="${(W - L - R) / Math.max(legs.length, 2)}" height="${H - T - B}" fill="transparent" data-i="${i}"/>`).join('');
      return `<div class="svgwrap"><svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Running three-dart average by leg">${grid}${xl}${lines}${endLabels}<line class="xh" x1="0" x2="0" y1="${T}" y2="${H - B}" hidden/>${hits}</svg><div class="tip" hidden></div></div>`
        + `<script type="application/json" class="rd">${JSON.stringify({ pts, names, W, L, R, n: legs.length })}<\/script>`;
    }

    // One row per leg: who won it (and whether it was a break of throw), how, and the score after it.
    function legTable(legs: any[], names: string[]) {
      const multiSet = legs.some(x => x.set > 1);
      const tally = [0, 0];
      return `<thead><tr><th>Leg</th><th>Winner</th><th class="n">Darts</th><th class="n"><span class="wide-only">Checkout</span><span class="narrow-only">Out</span></th><th class="n">Score</th></tr></thead><tbody>${legs.map(l => {
        const w = l.winner, ws = w == null ? null : w ? l.b : l.a;
        if (w != null) tally[w]++;
        const who = w == null
          ? `<span class="ip">In play</span>`
          : `<i class="dot" style="background:${C[w]}"></i>${esc(names[w])}${w !== l.starter ? ' <span class="brk">Break</span>' : ''}`;
        return `<tr${w == null ? ' class="open"' : ''}><td class="lg-n">${multiSet ? `${l.set}.` : ''}${l.n}</td><td class="lg-w">${who}</td><td class="n">${ws?.darts ?? '–'}</td><td class="n">${ws?.checkout ?? '–'}</td><td class="n sc">${w == null ? '' : scoreHtml(tally[0], tally[1])}</td></tr>`;
      }).join('')}</tbody>`;
    }

    // Head to head from the PDC: every earlier meeting, oriented to this match's players.
    async function headToHead(f: any) {
      const box = document.getElementById('h2h'), out = document.getElementById('hh'), sub = document.getElementById('hh-sub');
      if (!box || !out || !sub || box.dataset.done === f.id) return;
      const a = f.attributes, ids = [String(a.participant1?.participantID || ''), String(a.participant2?.participantID || '')];
      if (!ids[0] || !ids[1]) return;
      box.dataset.done = f.id;
      try {
        const games = await fetchH2H(ids[0], ids[1], f.id);
        sub.textContent = h2hSummary(games);
        out.innerHTML = renderH2H(games, [last(a.participant1), last(a.participant2)]);
        box.hidden = false;
      } catch { /* head to head is optional */ }
    }

    function wireTip() {
      // One delegated listener per chart (the chart is patched in place on each update,
      // so per-bar listeners would pile up); it reads the current data on each move.
      const wrap = document.querySelector<HTMLElement>('#runavg .svgwrap'); if (!wrap || (wrap as any).__tip) return;
      (wrap as any).__tip = true;
      wrap.addEventListener('pointerover', e => {
        const r = (e.target as Element).closest?.('rect[data-i]') as SVGRectElement | null; if (!r) return;
        const d = JSON.parse(document.querySelector('#runavg .rd')!.textContent!);
        const svg = wrap.querySelector('svg')!, tip = wrap.querySelector<HTMLElement>('.tip')!, xh = svg.querySelector<SVGLineElement>('.xh')!;
        const i = Number(r.dataset.i); const cx = d.L + (d.n === 1 ? (d.W - d.L - d.R) / 2 : (i / (d.n - 1)) * (d.W - d.L - d.R));
        xh.setAttribute('x1', String(cx)); xh.setAttribute('x2', String(cx)); xh.removeAttribute('hidden');
        tip.innerHTML = `<b>After leg ${i + 1}</b>${d.names.map((n: string, k: number) => `<span><i style="background:${C[k]}"></i>${esc(n)} ${d.pts[k][i] != null ? d.pts[k][i].toFixed(2) : '–'}</span>`).join('')}`;
        tip.hidden = false; tip.style.left = `${(cx / d.W) * 100}%`;
      });
      wrap.addEventListener('pointerleave', () => { const tip = wrap.querySelector<HTMLElement>('.tip'), xh = wrap.querySelector('svg .xh'); if (tip) tip.hidden = true; xh?.setAttribute('hidden', ''); });
    }

    // Form from the players' profile files (every ranked player).
    async function tape(ps: any[]) {
      const box = document.getElementById('tape'), tp = document.getElementById('tp');
      if (!box || !tp) return;
      const prof = await Promise.all(ps.map(p => fetch(`/data/players/${p?.participantID}.json`).then(r => (r.ok ? r.json() : null)).catch(() => null)));
      if (!prof.some(Boolean)) { box.hidden = true; return; }
      const st = prof.map(x => x?.season?.stats || null), se = prof.map(x => x?.season || null);
      const rows: [string, number | null, number | null, (v: number) => string, boolean][] = [
        ['Average', st[0]?.avg ?? null, st[1]?.avg ?? null, v => v.toFixed(2), true],
        ['First 9 average', st[0]?.f9 ?? null, st[1]?.f9 ?? null, v => v.toFixed(2), true],
        ['Checkout %', st[0]?.co ?? null, st[1]?.co ?? null, v => `${v.toFixed(1)}%`, true],
        ['180s per match', st[0] ? st[0].t80 / st[0].matches : null, st[1] ? st[1].t80 / st[1].matches : null, v => v.toFixed(1), true],
        ['Matches won', se[0]?.played ? (se[0].won / se[0].played) * 100 : null, se[1]?.played ? (se[1].won / se[1].played) * 100 : null, v => `${Math.round(v)}%`, true],
      ];
      const html = rows.filter(([, x, y]) => x != null || y != null).map(([label, x, y, fmt, hiGood]) => {
        const X = x ?? 0, Y = y ?? 0, max = Math.max(X, Y, 1);
        const better = x == null || y == null || X === Y ? 0 : (X > Y) === hiGood ? 1 : 2;
        const bar = (v: number | null, k: number) => (v == null || !hiGood ? '' : `<i class="b${k}" style="width:${(v / max) * 100}%"></i>`);
        return `<div class="cr"><span class="v l${better === 1 ? ' hi' : ''}">${x == null ? '–' : fmt(X)}</span><div class="bars">${bar(x, 0)}</div><span class="lab">${label}</span><div class="bars r">${bar(y, 1)}</div><span class="v r${better === 2 ? ' hi' : ''}">${y == null ? '–' : fmt(Y)}</span></div>`;
      }).join('');
      tp.innerHTML = html;
      box.hidden = false;
    }

    async function load() {
      const id = new URLSearchParams(location.search).get('id');
      const mh = document.getElementById('mh');
      if (!mh) return;
      if (!id) { patch(mh, '<div class="loading">No match selected. Open a match from a tournament page.</div>'); return; }
      const data = {};
      try {
        // While PDC is pushing this match, the fixture and timeline barely change: reuse them for 30s.
        const reuse = (isPushing() || getDelay() > 0) && ftCache.id === id && Date.now() - ftCache.at < (isPushing() ? PUSH_TICK : LIVE_TICK);
        let [f, t] = reuse ? [structuredClone(ftCache.f), structuredClone(ftCache.t)] : await Promise.all([fetch(FX + id, { cache: 'no-store' }).then(r => r.json()), fetch(`${FX}${id}/timeline`, { cache: 'no-store' }).then(r => (r.ok ? r.json() : null))]);
        if (!reuse) ftCache = { id, at: Date.now(), f: structuredClone(f), t: structuredClone(t) };
        const a = f.data;
        // PDC's live data fills the score and stats until the official feed has them.
        const tid = a.attributes.tournament?.tournamentID;
        const m: any = tid ? (await liveFor(String(tid), [String(id)])).get(String(id)) : null;
        let liveStats = false;
        if (m && m.status !== 'upcoming') {
          if (!/result/i.test(a.attributes.status)) {
            const [s1, s2] = liveScore(m, (t?.data?.attributes?.stage?.numberOfSets || 0) > 1);
            Object.assign(a.attributes, { participant1Score: s1, participant2Score: s2, status: m.status === 'live' ? 'Live' : 'Result' });
            if (m.status === 'result' && s1 !== s2) a.attributes.winnerParticipantID = (s1 > s2 ? a.attributes.participant1 : a.attributes.participant2)?.participantID;
          }
          // Every visit of every leg so far, when the official timeline doesn't have them yet.
          const official = t?.data?.attributes?.legs || [];
          const stale = official.some((l: any) => !(l.visits || []).some((x: any) => x.remaining === 0) && !((l.setNumber ?? 1) === (m.set || 1) && l.legNumber === m.leg));
          if (!official.length || stale) {
            if (!legCache.has(id)) legCache.set(id, new Map());
            // With push running, only finished legs are fetched (once); the leg in play comes from push below.
            const lg = await liveLegs(String(tid), String(id), pushedLegFor(id, m.set || 1, m.leg) ? { ...m, leg: m.leg - 1, status: 'result' } : m, legCache.get(id)).catch(() => []);
            if (lg.length) { t = t?.data ? t : { data: { attributes: { legs: [] } } }; t.data.attributes.legs = lg; }
          }
          if (m.stats && !t?.data?.attributes?.fixtureMeta?.participant1Data) {
            const side = (x: any) => x && { threeDartAverage: x.avg, first9Average: null, score180: x.t80, score140plus: x.t140, score100plus: x.t100, checkoutPercentage: x.co, highestCheckout: x.hi };
            t = t?.data ? t : { data: { attributes: { legs: [] } } };
            t.data.attributes.fixtureMeta = { participant1Data: side(m.stats[0]), participant2Data: side(m.stats[1]) };
            liveStats = true;
          }
        }
        // The leg in play straight from pushed data when it's flowing (every dart, no extra fetch).
        const pl = m?.status === 'live' ? pushedLegFor(id, m.set || 1, m.leg) : null;
        if (pl) {
          t = t?.data ? t : { data: { attributes: { legs: [] } } };
          const L = t.data.attributes.legs || (t.data.attributes.legs = []);
          const i = L.findIndex((l: any) => (l.setNumber ?? 1) === pl.setNumber && l.legNumber === pl.legNumber);
          if (i >= 0) L[i] = pl; else L.push(pl);
        }
        const names = [last(a.attributes.participant1), last(a.attributes.participant2)];
        const legs = t?.data ? legData(t.data.attributes) : [];
        // PDC saves the checkout a moment before the match score: count won legs so
        // the score never lags the leg that has just been won (legs format only).
        if (m?.status === 'live' && !((t?.data?.attributes?.stage?.numberOfSets || a.attributes.tournamentStage?.numberOfSets || 0) > 1)) {
          const won = [0, 1].map(k => legs.filter(l => l.winner === k).length);
          if (won[0] + won[1] > (a.attributes.participant1Score ?? 0) + (a.attributes.participant2Score ?? 0)) Object.assign(a.attributes, { participant1Score: won[0], participant2Score: won[1] });
        }
        // "Leg · name" flash when a leg or set is won.
        if (m?.status === 'live') {
          const setPlay = (t?.data?.attributes?.stage?.numberOfSets || a.attributes.tournamentStage?.numberOfSets || 0) > 1;
          watchWins(id, setPlay ? m.legs : [a.attributes.participant1Score ?? 0, a.attributes.participant2Score ?? 0], setPlay ? m.sets : null, names, '#mh .lb-mid > b, #mh .score');
        }
        document.title = `${name(a.attributes.participant1)} v ${name(a.attributes.participant2)} · The Oche`;
        const playing = m?.status === 'live' ? t?.data?.attributes?.legs?.find((l: any) => (l.setNumber ?? 1) === (m.set || 1) && l.legNumber === m.leg) : null;
        const prevLeg = playing && !playing.visits?.length ? t.data.attributes.legs.find((l: any) => (l.setNumber ?? 1) === (playing.setNumber ?? 1) && l.legNumber === playing.legNumber - 1) : null;
        // Nobody has thrown yet in the new leg: players alternate who starts each leg.
        if (playing && playing.throwing == null && !playing.visits.length) {
          const first = prevLeg?.visits?.slice().sort((x: any, y: any) => x.order - y.order)[0];
          if (first) playing.throwing = first.isParticipant1 ? 1 : 0;
        }
        // As soon as a leg is won the board shows the new one (501 each); the leg flash marks the win.
        const boardLeg = playing;
        if (playing) watch180(id, playing.setNumber ?? 1, playing.legNumber, playing.visits, names, ['#mh .lb-s.s0', '#mh .lb-s.s1']);
        // A 180 sticker on screen: keep the throw on that player, and move it on once the sticker has gone.
        const hold = heldThrow(id);
        clearTimeout(holdTimer);
        if (hold) holdTimer = window.setTimeout(load, hold.left + 50);
        // No darts for a while since the last leg ended: a break (PDC's data has no flag for it).
        const brk = !!playing && onBreak(playing, prevLeg?.lastAt);
        // Built as one string and patched in, so a live update changes only what moved
        // (the score, the darts thrown) instead of redrawing the header and its photos.
        let mhHtml = header(a, t?.data, data, m?.status === 'live' ? m : null, boardLeg, brk, hold?.k ?? null);
        // Key numbers under the score (the averages are already by each name): 180s, breaks of throw, best checkout, shortest leg.
        const meta = t?.data?.attributes?.fixtureMeta;
        if (meta?.participant1Data && legs.length) {
          const won = legs.filter(l => l.winner != null).map(l => ({ l, s: l.winner ? l.b : l.a }));
          const best = won.filter(x => x.s.checkout).sort((x, y) => y.s.checkout - x.s.checkout)[0];
          const fast = won.slice().sort((x, y) => x.s.darts - y.s.darts)[0];
          const kpi = (v: string, label: string, hi = false) => `<div><b class="poster-num${hi ? ' hi' : ''}">${v}</b><span class="lbl">${label}</span></div>`;
          const t80 = [meta.participant1Data.score180 ?? 0, meta.participant2Data.score180 ?? 0];
          const breaks = [0, 1].map(k => won.filter(x => x.l.winner === k && x.l.starter !== k).length);
          mhHtml += (`<div class="kpis">${kpi(scoreHtml(t80[0], t80[1]), '180s', t80[0] + t80[1] > 0)}${kpi(scoreHtml(breaks[0], breaks[1]), 'Breaks of throw')}${best ? kpi(String(best.s.checkout), `Best checkout · ${esc(names[best.l.winner])}`) : ''}${fast ? kpi(String(fast.s.darts), `Shortest leg (darts) · ${esc(names[fast.l.winner])}`) : ''}</div>`);
        }
        const started = !/result|live|progress/i.test(a.attributes.status) && new Date(`${a.attributes.startDate}T${(a.attributes.startTime || '23:59').slice(0, 5)}:00`) <= new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/London' }));
        const noLegs = !(t?.data?.attributes?.legs?.length);
        const isResult = /result/i.test(a.attributes.status);
        const isLive = /live|progress/i.test(a.attributes.status);
        if (isLive && liveStats) mhHtml += `<p class="inplay"><span class="live-dot">Live</span> Score and stats update every few seconds.</p>`;
        else if (isResult && noLegs) mhHtml += `<p class="inplay"><b>Result confirmed.</b> ${liveStats ? 'Stats are from PDC live scoring; the' : 'The PDC adds averages and'} leg-by-leg detail follows when the PDC publishes it. This page checks again every two minutes and fills in on its own.</p>`;
        if (!document.getElementById('tp')!.innerHTML) tape([a.attributes.participant1, a.attributes.participant2]);
        headToHead(a);
        if (started && noLegs && !m?.stats) mhHtml += `<p class="inplay"><span class="live-dot">On now</span> Scores will show here as soon as the game is in play.</p>`;
        patch(mh, mhHtml);
        // Stats show as soon as there are any; the leg charts wait for the visit data.
        const mb = document.getElementById('mb')!;
        // Before a match: head to head and form only. Once it starts: tabs, with Match stats first.
        const tabbed = document.getElementById('mtabbed')!, tabsEl = document.getElementById('mtabs')!;
        if (isLive || isResult) {
          if (tabsEl.hidden) tabsEl.hidden = false;
          if (!tabbed.dataset.tab) tabbed.dataset.tab = 'stats';
        } else { if (!tabsEl.hidden) tabsEl.hidden = true; delete tabbed.dataset.tab; }
        // Visibility is only written when it changes (writing the same value still touches the page).
        const show = (el: HTMLElement, hide: boolean) => { if (el.hidden !== hide) el.hidden = hide; };
        show(mb, !t?.data?.attributes?.fixtureMeta?.participant1Data && noLegs);
        show(document.getElementById('mb-wait')!, !(mb.hidden && (isLive || isResult)));
        mb.querySelectorAll<HTMLElement>('.block:not(:first-child)').forEach(b => show(b, noLegs));
        if (t?.data) {
          patch(document.getElementById('cmp'), compare(a, t.data));
          patch(document.getElementById('lg1'), legend(names));
          patch(document.getElementById('runavg'), runAvg(legs.filter(l => l.winner != null), names));
          patch(document.getElementById('lt'), legTable(legs, names));
          wireTip();
        }
        clearTimeout(timer);
        // Live: PDC pushes each change (load runs again at once); the timer is only a safety check.
        if (isLive && tid) watchLive(String(tid), [String(id)], onPush);
        if (isLive) timer = window.setTimeout(load, isPushing() ? PUSH_TICK : LIVE_TICK);
        else if (!isResult && a.attributes.startDate <= new Date().toISOString().slice(0, 10)) timer = window.setTimeout(load, 15_000);
        else if (isResult && noLegs) timer = window.setTimeout(load, 120_000);
      } catch {
        patch(mh, '<div class="loading">This match could not be loaded. Please try again shortly.</div>');
      }
    }
    // Match tabs: remembered while the page is open (each poll keeps the choice).
    document.addEventListener('click', e => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('#mtabs [data-mt]');
      if (!b) return;
      document.getElementById('mtabbed')!.dataset.tab = b.dataset.mt!;
      document.querySelectorAll('#mtabs [data-mt]').forEach(x => x.setAttribute('aria-selected', String(x === b)));
    });
    const onPush = () => { if (document.getElementById('mh')) { clearTimeout(timer); load(); } };
    document.addEventListener('astro:before-swap', () => unwatch(onPush));
    document.addEventListener('astro:page-load', () => { clearTimeout(timer); if (document.getElementById('mh')) load(); });
    // Preview the leg-won flash: /match?id=…&demo=leg plays it for each player in turn.
    document.addEventListener('astro:page-load', () => {
      if (new URLSearchParams(location.search).get('demo') !== 'leg' || !document.getElementById('mh')) return;
      let n = 0;
      const tick = () => {
        const who = [...document.querySelectorAll('#mh .who a, #mh .who > span')].map(e => (e.textContent || '').trim().split(' ').slice(1).join(' '));
        if (who.length === 2) flashWin(who[n % 2], n === 3 ? 'Set' : 'Leg', '#mh .lb-mid > b, #mh .score');
        if (++n < 4 && document.getElementById('mh')) setTimeout(tick, 4000);
      };
      setTimeout(tick, 1500);
    });
  </script>
</Layout>

<style>
