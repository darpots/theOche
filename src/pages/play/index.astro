---
// Games and tools hub.
import Layout from '../../layouts/Layout.astro';
import calendar from '../../data/calendar.json';

const today = new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/London' });
const wc = calendar.events.find(e => /world championship/i.test(e.name) && e.end >= today);
const items = [
  { href: '/play/predictor', tone: 'volt', kick: 'Every session', title: 'Predictor', text: 'Call the winners before the darts fly. Points for every right pick, a streak for the brave.' },
  { href: '/play/guess', tone: 'ink', kick: 'Daily', title: 'Guess the player', text: 'One mystery player a day. Six clues, six guesses. How fast can you get there?' },
  { href: '/play/checkout', tone: 'red', kick: 'Practice', title: 'Checkout trainer', text: '121 left, three in the hand. What’s your route? Beat the clock and your best.' },
  { href: '/h2h', tone: 'card', kick: 'Tool', title: 'Head to head', text: 'Pick any two players: every meeting, and their numbers side by side.' },
  { href: '/my', tone: 'card', kick: 'Yours', title: 'My Oche', text: 'The players you follow: their matches today, their form and their news.' },
  { href: '/records', tone: 'card', kick: 'This season', title: 'Records', text: 'The best match averages, the most 180s and every 170 of the season.' },
];
---
<Layout title="Play" description="Darts games and tools: predictor, guess the player, checkout trainer, head to head and records." active="play">
  <section class="hero wrap">
    <span class="eyebrow">Games &amp; tools</span>
    <h1>Step up to <span class="accent">the oche.</span></h1>
    <p class="lede">Call the results, test your darts brain and dig into the numbers. Everything here is saved on your device, nothing to sign up for.</p>
  </section>
  <section class="wrap grid">
    {wc && (
      <a class="tile wc" href="/world-championship">
        <span class="lbl">From {new Date(wc.start).toLocaleDateString('en-GB', { day: 'numeric', month: 'long' })}</span>
        <b class="poster">World Championship hub</b>
        <span>Draw, seeds, favourites, roll of honour and a countdown to Ally Pally.</span>
      </a>
    )}
    {items.map(i => (
      <a class={`tile t-${i.tone}`} href={i.href}>
        <span class="lbl">{i.kick}</span>
        <b class="poster">{i.title}</b>
        <span>{i.text}</span>
        <i aria-hidden="true">→</i>
      </a>
    ))}
  </section>
</Layout>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
  .tile { position: relative; display: flex; flex-direction: column; gap: 10px; padding: 24px; min-height: 210px; text-decoration: none; transition: transform .3s var(--ease), box-shadow .3s; }
  .tile:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .tile b { font-size: 40px; }
  .tile span:not(.lbl) { font-size: 15px; line-height: 1.45; }
  .tile i { position: absolute; right: 22px; bottom: 18px; font-style: normal; font-weight: 800; font-size: 20px; }
  .t-volt { background: var(--volt); color: var(--ink); }
  .t-ink { background: var(--ink); color: #fff; }
  .t-ink .lbl { color: var(--volt); }
  .t-red { background: var(--red); color: #fff; }
  .t-card { background: var(--card); color: var(--fg); }
  .t-card .lbl { color: var(--red-text); }
  .wc { grid-column: 1 / -1; min-height: 0; background: linear-gradient(120deg, #1a1030, #0b0c10 60%); color: #fff; }
  .wc .lbl { color: var(--volt); }
  .wc b { font-size: clamp(34px, 5vw, 56px); }
</style>
