---
// Predictor: pick the winner of every match in the current event before it starts.
// Picks live in this browser (localStorage); results come from the PDC feed.
import Layout from '../../layouts/Layout.astro';
import data from '../../data/tournament.json';
import { jsonForHtml } from '../../lib/play-data';

const t = data.tournament as any;
---
<Layout title="Predictor" description={`Pick the winners at the ${t.name}: points for every right call.`} active="play">
  <section class="hero wrap">
    <span class="eyebrow">Predictor · {t.name}</span>
    <h1>Call it <span class="accent">before they throw.</span></h1>
    <p class="lede">Tap who wins each match. Picks lock when the match starts, and you score a point for every right call (two if you back the underdog and they deliver).</p>
  </section>

  <section class="wrap">
    <div class="score tile tile-ink" id="pscore" aria-live="polite">
      <div><b class="poster-num" id="ps-pts">0</b><span class="lbl">Points</span></div>
      <div><b class="poster-num" id="ps-hit">0/0</b><span class="lbl">Right calls</span></div>
      <div><b class="poster-num" id="ps-streak">0</b><span class="lbl">Streak</span></div>
      <button class="share" type="button" id="ps-share">Share my score</button>
    </div>
    <div id="pboard" class="board"><p class="muted">Loading the schedule…</p></div>
  </section>

  <script is:inline type="application/json" id="p-data" set:html={jsonForHtml({ id: t.id, name: t.name, stages: t.stages.map((s: any) => ({ name: s.name, fixtures: s.fixtures.map((f: any) => ({ id: f.id, date: f.date, time: f.time, status: f.status, p1: f.p1 && { id: f.p1.id, name: f.p1.name, rank: f.p1.rank ?? null }, p2: f.p2 && { id: f.p2.id, name: f.p2.name, rank: f.p2.rank ?? null }, s1: f.s1, s2: f.s2, winner: f.winner })) })) })} />

  <script>
    import { API, normaliseTournament } from '../../lib/pdc.mjs';
    import { patch, setText } from '../../lib/morph.mjs';
    const KEY = 'oche:picks';
    type Pick = { p: string; t: string };
    const load = (): Record<string, Pick> => { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; } };
    const save = (x: Record<string, Pick>) => { try { localStorage.setItem(KEY, JSON.stringify(x)); } catch { /* private mode */ } };
    const esc = (x: unknown) => String(x ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    const surname = (n: string) => n.split(' ').slice(1).join(' ') || n;
    const ldn = () => {
      const p = Object.fromEntries(new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date()).map(x => [x.type, x.value]));
      return `${p.year}-${p.month}-${p.day} ${p.hour === '24' ? '00' : p.hour}:${p.minute}`;
    };
    let ranks = new Map<string, number>();

    function init() {
      const board = document.getElementById('pboard');
      if (!board) return;
      let t = JSON.parse(document.getElementById('p-data')!.textContent!);
      // World rankings for the underdog bonus (the search index has them).
      fetch('/search.json').then(r => r.json()).then((idx: any[]) => {
        for (const x of idx) if (x.t === 'p') { const m = String(x.s).match(/World #(\d+)/); if (m) ranks.set(x.n, Number(m[1])); }
        draw();
      }).catch(() => {});

      const locked = (f: any) => f.status !== 'upcoming' || (f.date && `${f.date} ${f.time || '00:00'}` <= ldn());
      const underdog = (f: any, id: string) => {
        const r1 = ranks.get(f.p1.name) ?? 999, r2 = ranks.get(f.p2.name) ?? 999;
        return id === f.p1.id ? r1 > r2 : r2 > r1;
      };
      function score() {
        const picks = load(); let pts = 0, hit = 0, settled = 0, streak = 0;
        const all = t.stages.flatMap((s: any) => s.fixtures).filter((f: any) => f.status === 'result' && picks[f.id]).sort((a: any, b: any) => `${a.date}${a.time}`.localeCompare(`${b.date}${b.time}`));
        for (const f of all) { settled++; if (picks[f.id].p === f.winner) { hit++; streak++; pts += underdog(f, f.winner) ? 2 : 1; } else streak = 0; }
        setText(document.getElementById('ps-pts'), String(pts));
        setText(document.getElementById('ps-hit'), `${hit}/${settled}`);
        setText(document.getElementById('ps-streak'), String(streak));
        return { pts, hit, settled };
      }
      function draw() {
        const picks = load();
        const groups: string[] = [];
        // Upcoming first (soonest first), then results (newest first).
        const fx = t.stages.flatMap((s: any) => s.fixtures.map((f: any) => ({ ...f, stage: s.name }))).filter((f: any) => f.p1 && f.p2);
        const open = fx.filter((f: any) => !locked(f)).sort((a: any, b: any) => `${a.date}${a.time}`.localeCompare(`${b.date}${b.time}`));
        const shut = fx.filter((f: any) => locked(f)).sort((a: any, b: any) => `${b.date}${b.time}`.localeCompare(`${a.date}${a.time}`)).slice(0, 24);
        const row = (f: any) => {
          const pk = picks[f.id]?.p, isLocked = locked(f), done = f.status === 'result';
          const side = (p: any, s: number | null) => {
            const mine = pk === p.id, won = done && f.winner === p.id;
            const cls = ['pk', mine ? 'mine' : '', done ? (won ? 'won' : 'lost') : '', done && mine ? (won ? 'right' : 'wrong') : ''].join(' ');
            return `<button type="button" class="${cls}" data-f="${esc(f.id)}" data-p="${esc(p.id)}" ${isLocked ? 'disabled' : ''} aria-pressed="${mine}">
              <span class="nm">${esc(surname(p.name))}${ranks.get(p.name) ? `<small>#${ranks.get(p.name)}</small>` : ''}</span>${done ? `<b class="poster-num">${s ?? ''}</b>` : ''}</button>`;
          };
          const when = f.date ? `${new Date(f.date + 'T12:00:00Z').toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' })}${f.time ? ` · ${f.time}` : ''}` : '';
          const note = done ? (pk ? (pk === f.winner ? `<span class="ok">✓ ${underdog(f, f.winner) ? '+2 underdog' : '+1'}</span>` : '<span class="no">✗</span>') : '<span class="muted">No pick</span>')
            : isLocked ? '<span class="live-dot">Locked</span>' : pk ? '<span class="muted">Picked</span>' : '<span class="muted">Your call</span>';
          return `<div class="m"><div class="meta"><span>${esc(f.stage)}</span><span>${esc(when)}</span>${note}</div><div class="pair">${side(f.p1, f.s1)}<i>v</i>${side(f.p2, f.s2)}</div></div>`;
        };
        if (open.length) groups.push(`<h2 class="gh">Up next</h2>${open.map(row).join('')}`);
        if (shut.length) groups.push(`<h2 class="gh">Played and locked</h2>${shut.map(row).join('')}`);
        // Patched: the minute-by-minute refresh only touches matches whose state changed.
        patch(board, groups.join('') || `<div class="empty"><h3>Nothing to call yet</h3><p>Picks open as soon as the draw for the ${esc(t.name)} is out.</p></div>`);
        score();
      }
      board.onclick = e => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-f]');
        if (!b || b.disabled) return;
        const picks = load();
        picks[b.dataset.f!] = { p: b.dataset.p!, t: t.id };
        save(picks); draw();
      };
      document.getElementById('ps-share')!.onclick = async () => {
        const s = score();
        const text = `I've called ${s.hit} of ${s.settled} at the ${t.name} on The Oche (${s.pts} pts). Can you beat it?`;
        const url = `${location.origin}/play/predictor`;
        try { if (navigator.share) await navigator.share({ text, url }); else { await navigator.clipboard.writeText(`${text} ${url}`); (document.getElementById('ps-share') as HTMLButtonElement).textContent = 'Copied!'; } } catch { /* cancelled */ }
      };
      draw();
      // Fresh schedule and results from the PDC feed.
      const refresh = () => fetch(`${API.tournaments}${t.id}`, { cache: 'no-store' }).then(r => r.json()).then(j => { t = normaliseTournament(j); draw(); }).catch(() => {});
      refresh();
      clearInterval((window as any).__predTimer);
      (window as any).__predTimer = setInterval(() => { if (!document.hidden && document.getElementById('pboard')) refresh(); }, 60_000);
    }
    document.addEventListener('astro:page-load', init);
  </script>
</Layout>

<style>
  .score { display: grid; grid-template-columns: repeat(3, 1fr) auto; align-items: center; gap: 16px; padding: 20px 24px; margin-bottom: 22px; }
  .score div { display: flex; flex-direction: column; gap: 4px; }
  .score b { font-size: 48px; color: var(--volt); }
  .score .lbl { color: var(--on-ink); }
  .share { border: 0; border-radius: 999px; background: var(--volt); color: var(--ink); font-weight: 800; padding: 12px 18px; cursor: pointer; }
  .board :global(.gh) { font-size: 28px; margin: 18px 0 12px; }
  .board :global(.m) { background: var(--card); border-radius: 18px; padding: 12px 14px; margin-bottom: 10px; box-shadow: var(--shadow-sm); }
  .board :global(.meta) { display: flex; gap: 12px; align-items: center; font-size: 12px; font-weight: 700; color: var(--muted); margin-bottom: 8px; }
  .board :global(.meta > :last-child) { margin-left: auto; }
  .board :global(.ok) { color: var(--green-text); font-weight: 800; }
  .board :global(.no) { color: var(--red-text); font-weight: 800; }
  .board :global(.pair) { display: grid; grid-template-columns: 1fr auto 1fr; gap: 10px; align-items: center; }
  .board :global(.pair i) { font-style: normal; color: var(--muted); font-weight: 700; }
  .board :global(.pk) { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 12px 14px; border-radius: 14px; border: 2px solid var(--line); background: var(--paper); color: var(--fg); font-weight: 800; font-size: 16px; cursor: pointer; text-align: left; transition: transform .2s var(--spring), border-color .2s, background .2s; }
  .board :global(.pk:not(:disabled):hover) { transform: translateY(-2px); border-color: var(--fg); }
  .board :global(.pk.mine) { background: var(--ink); color: var(--volt); border-color: var(--ink); }
  .board :global(.pk:disabled) { cursor: default; }
  .board :global(.pk.lost) { opacity: .55; }
  .board :global(.pk.right) { box-shadow: 0 0 0 3px var(--green); }
  .board :global(.pk.wrong) { box-shadow: 0 0 0 3px var(--red); }
  .board :global(.pk small) { display: block; font-size: 11px; color: var(--muted); font-weight: 700; }
  .board :global(.pk b) { font-size: 26px; }
  @media (max-width: 640px) { .score { grid-template-columns: repeat(3, 1fr); } .share { grid-column: 1 / -1; } .score b { font-size: 36px; } }
</style>
