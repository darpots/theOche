---
import Layout from '../layouts/Layout.astro';
import CalendarMonths from '../components/CalendarMonths.astro';
import { focusMonths } from '../lib/calendar-cards';

// The page opens on the previous, current and next tournaments (from the month of the
// latest finished event onwards); the two years before load in after the first paint.
const current = focusMonths;
---
<Layout title="Calendar" description="Every PDC darts event on Sky Sports, ITV and PDCTV: dates, venues, broadcasters and winners." active="calendar">

  <section class="hero wrap">
    <span class="eyebrow">Sky Sports · ITV · PDCTV</span>
    <h1>Season <span class="accent">calendar</span></h1>
    <p class="lede">Every PDC major, Premier League night, World Series and European Tour event, and who's showing it.</p>
  </section>

  <section class="wrap controls" data-reveal>
    <div class="chips" role="group" aria-label="Filter by broadcaster">
      <button class="chip" data-filter="all" aria-pressed="true">All events</button>
      <button class="chip logo-chip" data-filter="sky" aria-pressed="false" aria-label="Sky Sports"><img src="/brand/sky-sports.svg" alt="" height="14" /></button>
      <button class="chip logo-chip" data-filter="itv" aria-pressed="false" aria-label="ITV"><img src="/brand/itv.svg" alt="" height="18" /></button>
      <button class="chip logo-chip" data-filter="pdctv" aria-pressed="false" aria-label="European Tour on PDCTV"><span class="pdc-mark"><img src="/brand/pdctv.png" alt="" height="12" /></span>European Tour</button>
    </div>
  </section>

  <section class="wrap months" id="months">
    <CalendarMonths entries={current} />
    <p class="empty" id="none" hidden>No events match this filter.</p>
  </section>
  <!-- Open on the previous, current and next tournaments: scrolled there while the page
       is still loading, so the top of the page is never painted first. -->
  <script is:inline>
    (function () {
      if (location.hash || window.scrollY > 40) return;
      var m = document.querySelector('#months > .month'); if (!m) return;
      var c = document.querySelector('.controls'), sticky = c && getComputedStyle(c).position === 'sticky';
      var h = document.querySelector('header'), hdr = h ? h.getBoundingClientRect().bottom : 68;
      window.scrollTo({ top: m.getBoundingClientRect().top + window.scrollY - hdr - (sticky ? c.offsetHeight : 0) - 14, behavior: 'instant' });
    })();
  </script>


  <script>

    let pastHtml: Promise<string> | null = null;
    function init() {
      const root = document.getElementById('months');
      if (!root) return;
      const p = Object.fromEntries(new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date()).map(x => [x.type, x.value]));
      const today = `${p.year}-${p.month}-${p.day}`;
      const status = (cards: HTMLElement[]) => {
        for (const c of cards) {
          const { start = '', end = '' } = c.dataset;
          const s = c.querySelector<HTMLElement>('[data-status]');
          const set = (cls: string, txt: string) => { if (s) { s.className = cls; s.textContent = txt; } };
          c.classList.remove('live', 'past');
          if (start <= today && end >= today) { c.classList.add('live'); set('status live-dot', 'On now'); }
          else if (end < today) { c.classList.add('past'); set('status done', 'Completed'); }
          else {
            const days = Math.round((Date.parse(start) - Date.parse(today)) / 864e5);
            set('status soon', days === 1 ? 'Tomorrow' : days <= 60 ? `In ${days} days` : 'Coming up');
            if (days <= 60) c.style.setProperty('--soon', String(1 - days / 60));
          }
        }
      };
      status([...root.querySelectorAll<HTMLElement>('.ev')]);

      let filter = 'all';
      const apply = (scope: ParentNode = root) => {
        for (const c of scope.querySelectorAll<HTMLElement>('.ev')) { const hide = !(filter === 'all' || c.dataset.kind === filter); if (c.hidden !== hide) c.hidden = hide; }
        const ms = scope instanceof HTMLElement && scope.matches('.month') ? [scope] : [...scope.querySelectorAll<HTMLElement>('.month')];
        ms.forEach(m => { const hide = !m.querySelector('.ev:not([hidden])'); if (m.hidden !== hide) m.hidden = hide; });
        document.getElementById('none')!.hidden = !!root.querySelector('.ev:not([hidden])');
        scope.querySelectorAll('[data-reveal]:not(.in)').forEach(el => el.classList.add('in'));
      };
      const later = (window as any).requestIdleCallback || ((f: (d?: any) => void) => setTimeout(f, 50));
      // The two years before load in once the page has painted, above what's on screen,
      // without moving it: the view stays on the previous, current and next tournaments.
      const loadPast = async () => {
        if (root.querySelector('#past-months')) return;
        pastHtml ||= fetch('/calendar/past').then(r => r.text());
        const doc = new DOMParser().parseFromString(await pastHtml, 'text/html');
        const block = doc.getElementById('past-months');
        if (!block || root.querySelector('#past-months') || !document.body.contains(root)) return;
        // Its images wait until they come near the screen (inserted far above it, the
        // browser would otherwise fetch them straight away).
        for (const img of block.querySelectorAll('img')) { const src = img.getAttribute('src'); if (src) { img.setAttribute('data-src', src); img.removeAttribute('src'); } }
        const io = new IntersectionObserver(es => es.forEach(e => { if (!e.isIntersecting) return; const i = e.target as HTMLImageElement; i.src = i.dataset.src!; i.removeAttribute('data-src'); io.unobserve(i); }), { rootMargin: '900px 0px' });
        const holder = document.createElement('div'); holder.id = 'past-months';
        root.prepend(holder);
        // A month at a time, newest first, each in its own idle moment, so no single task is long.
        const months = [...block.querySelectorAll<HTMLElement>(':scope > .month')].reverse();
        const step = (deadline?: { timeRemaining(): number }) => {
          do {
            const m = months.shift(); if (!m || !document.body.contains(root)) return;
            const node = document.importNode(m, true) as HTMLElement;
            node.querySelectorAll('img[data-src]').forEach(i => io.observe(i));
            status([...node.querySelectorAll<HTMLElement>('.ev')]);
            apply(node);
            // Keep what's on screen exactly where it is (Safari doesn't do this by itself).
            const anchor = holder.nextElementSibling as HTMLElement || root;
            const before = anchor.getBoundingClientRect().top;
            holder.prepend(node);
            const moved = anchor.getBoundingClientRect().top - before;
            if (moved) window.scrollBy({ top: moved, behavior: 'instant' }); // never animated: the view mustn't move
          } while (deadline && deadline.timeRemaining() > 8);
          if (months.length) later(step, { timeout: 1000 });
        };
        later(step, { timeout: 1000 });
      };
      document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(b => b.addEventListener('click', () => {
        filter = b.dataset.filter!;
        document.querySelectorAll('[data-filter]').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
        apply();
      }));
      apply();
      // Arrived by an in-site link (the inline script above ran before the router's scroll reset).
      if (!location.hash && window.scrollY < 40 && !root.querySelector('#past-months')) {
        const m = root.querySelector<HTMLElement>('.month'), c = document.querySelector<HTMLElement>('.controls');
        const hdr = document.querySelector('header')?.getBoundingClientRect().bottom || 68;
        if (m) window.scrollTo({ top: m.getBoundingClientRect().top + window.scrollY - hdr - (c && getComputedStyle(c).position === 'sticky' ? c.offsetHeight : 0) - 14, behavior: 'instant' });
      }
      // After the first paint, while the reader looks at what's here.
      requestAnimationFrame(() => later(() => loadPast().catch(() => {}), { timeout: 1500 }));
    }
    document.addEventListener('astro:page-load', init);
  </script>
</Layout>

<style>
  .controls { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; padding: 16px 0 8px; position: sticky; top: var(--hdr, 68px); z-index: 20; background: linear-gradient(var(--paper) 75%, transparent); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  /* Broadcaster logos are made for white: the chips stay white in the dark theme too */
  .logo-chip { gap: 8px; background: #fff; color: #0b0c10; border-color: #e2ddd2; }
  /* Chips and their logos keep their natural size (a chip that doesn't fit moves to the
     next line instead of squeezing), so the channel logos look as they do on the event cards. */
  .chips > .chip { flex: none; }
  .logo-chip img { width: auto; max-width: none; flex: none; display: block; }
  .pdc-mark { flex: none; }
  .logo-chip[aria-pressed='true'] { background: #fff; color: #0b0c10; border-color: var(--fg); box-shadow: 0 0 0 2px var(--fg); }
  .pdc-mark { background: #14161f; border-radius: 6px; padding: 3px 6px; display: inline-flex; }

  @media (max-width: 640px) { .controls { position: static; background: none; } .chip { white-space: nowrap; } } /* chips wrap onto a second line on phones */
</style>
