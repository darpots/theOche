---
// Matchday homepage ("Floodlight Bento"): a big match tile, what's next,
// today's results, news, the live race, a player spotlight and what's coming.
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import calendar from '../data/calendar.json';
import data from '../data/tournament.json';
import rankings from '../data/rankings.json';
import liveRaceData from '../data/live-race.json';
import cutoutsRaw from '../data/cutouts.json';
import { tvBadge, keyName, flag } from '../lib/pdc.mjs';
import { newsDate, dayNum, monthShort, dateRange, money, shortDate } from '../lib/format.mjs';
import { matchday, featureTile, nextTileInner } from '../lib/feature.mjs';
import { chooseCover } from '../lib/covers';
import { loadProfile } from '../lib/players';

const cutouts = cutoutsRaw as Record<string, string>;
const t = data.tournament as any;
const today = new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/London' });
const nowHHMM = new Date().toLocaleTimeString('en-GB', { timeZone: 'Europe/London', hour: '2-digit', minute: '2-digit', hour12: false });
const isOn = t.start <= today && t.end >= today;
const md = matchday(t, today, nowHHMM);
const feature = isOn ? (md.now ? { f: md.now, mode: 'now' } : md.next ? { f: md.next, mode: 'next' } : md.results[0] ? { f: md.results[0], mode: 'result' } : null) : null;
const nextUp = isOn ? (md.now ? md.next : md.next && feature?.f !== md.next ? md.next : md.todays.find(f => f.status !== 'result' && f !== feature?.f) || null) : null;
const resultsList = (md.results.filter(f => f.date === today).length ? md.results.filter(f => f.date === today) : md.results).slice(0, 5);

const upcoming = calendar.events.filter(e => e.start > today && e.id !== t.id);
const nextEvent = upcoming[0];
const short = (n: string) => n.split(' ').slice(-1)[0];

const news = (await getCollection('news')).map(n => n.data).sort((a, b) => b.date.localeCompare(a.date)).slice(0, 4);
const bigFigure = (h: string) => (h.match(/£[\d,.]+(?:k|m)?|\b\d{1,2}-\d{1,2}\b|\b1\d\d\.\d\d\b/i) || [null])[0]?.replace(/,000$/, 'K').replace(/^(£\d+),(\d{3})$/, '$1K');

const prev = (rankings.previous || {}) as Record<string, number>;
const top = rankings.players.slice(0, 5).map(p => ({ ...p, move: prev[p.id] ? prev[p.id] - p.pos : 0 }));
// Live race from the daily snapshot (scripts/refresh-live-race.mjs), shown while its event is on.
const lrd = liveRaceData as any;
const liveOn = !!lrd.event && lrd.event.startDate <= today && lrd.event.endDate >= today;
const raceTop = liveOn ? lrd.race.slice(0, 4) : [];
const raceMover = liveOn ? lrd.race.slice(4, 32).filter((p: any) => p.move > 0).sort((a: any, b: any) => b.move - a.move)[0] : null;
const raceUpdated = liveOn ? new Date(lrd.updatedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'Europe/London' }) : '';
// Spotlight: the best-ranked player in today's matches, else world number one.
const todayIds = new Set(md.todays.flatMap(f => [f.p1.id, f.p2.id]));
const spotRank = rankings.players.find(p => todayIds.has(p.id) && cutouts[keyName(p.name)]) || rankings.players[0];
const spot = loadProfile(spotRank.id);
---
<Layout title="The Oche" description="PDC darts today: the match on now, results, news, the live rankings race and every event on Sky Sports, ITV and PDCTV." active="home">
  <div class="wrap bento-wrap">
    <div class="bento">

      <section class="tile tile-ink feature" id="feature" data-id={t.id} data-name={t.name} data-on={isOn ? '1' : ''} aria-live="polite">
        {feature ? (
          <Fragment set:html={featureTile(feature.f, feature.mode, t.name, cutouts)} />
        ) : nextEvent ? (
          <a class="ne" href={`/tournament/${nextEvent.id}`}>
            <span class="lbl ft-next">Next on the oche</span>
            <h1 class="ne-name">{nextEvent.name}{nextEvent.tag && <small>{nextEvent.tag}</small>}</h1>
            <p class="ne-meta">{dateRange(nextEvent.start, nextEvent.end)} · {nextEvent.venue || nextEvent.city}</p>
            <div class="ne-count" data-count={nextEvent.start}>{['d', 'h', 'm'].map(u => <div><b class="poster-num" data-u={u}>–</b><span class="lbl">{{ d: 'Days', h: 'Hours', m: 'Mins' }[u]}</span></div>)}</div>
            <span class="ne-tv"><Fragment set:html={tvBadge(nextEvent.broadcaster)} /></span>
          </a>
        ) : null}
      </section>

      <div class="side">
        {nextUp ? (
          <a class="tile tile-volt nu" href={`/match?id=${nextUp.id}`} id="nextup" set:html={nextTileInner(nextUp, t.name)} />
        ) : nextEvent && (
          <a class="tile tile-volt nu" href={`/tournament/${nextEvent.id}`}>
            <span class="lbl">Next event · {dayNum(nextEvent.start)} {monthShort(nextEvent.start)}</span>
            <span class="poster nu-names">{nextEvent.name}</span>
            <span class="nu-sub">{nextEvent.venue || nextEvent.city}</span>
          </a>
        )}
        <section class="tile tile-card res">
          <div class="th"><h2 class="lbl">{md.results.some(f => f.date === today) ? 'Today’s results' : 'Latest results'}</h2><a href={`/tournament/${t.id}`}>All →</a></div>
          <ol id="results">
            {resultsList.map(f => (
              <li><a href={`/match?id=${f.id}`}>
                <span class="rd">{shortDate(f.date)}</span>
                <span class:list={['rn', { w: f.winner === f.p1.id }]}>{short(f.p1.name)}</span>
                <span class="poster-num rs">{f.s1}–{f.s2}</span>
                <span class:list={['rn', 'r', { w: f.winner === f.p2.id }]}>{short(f.p2.name)}</span>
              </a></li>
            ))}
          </ol>
        </section>
      </div>

      {news[0] && (() => {
        const c = chooseCover(news[0])[0];
        return (
          <a class="tile tile-ink lead" href={`/news/${news[0].slug}`}>
            <img class="photo" src={c.src.replace('.jpg', '-1200.webp')} srcset={`${c.src.replace('.jpg', '-600.webp')} 600w, ${c.src.replace('.jpg', '-1200.webp')} 1200w`} sizes="(max-width: 900px) 100vw, 680px" alt={c.alt} style={`object-position:${c.focus}`} />
            <div class="lead-box">
              <span class="lbl volt">{newsDate(news[0].date)} · {news[0].tags[0]}</span>
              <h2>{news[0].headline}</h2>
              <p>{news[0].standfirst}</p>
            </div>
          </a>
        );
      })()}

      <div class="nsub">
        {news[1] && (() => {
          const c = chooseCover(news[1])[0];
          return (
            <a class="tile tile-card nc" href={`/news/${news[1].slug}`}>
              <img class="photo" src={c.src.replace('.jpg', '-600.webp')} alt={c.alt} style={`object-position:${c.focus}`} loading="lazy" />
              <div><span class="lbl red">{newsDate(news[1].date)}</span><h3>{news[1].headline}</h3></div>
            </a>
          );
        })()}
        {news[2] && (
          <a class="tile nred" href={`/news/${news[2].slug}`}>
            <span class="lbl">{newsDate(news[2].date)} · {news[2].tags[0]}</span>
            <div>{bigFigure(news[2].headline) && <div class="poster-num big">{bigFigure(news[2].headline)}</div>}<h3>{news[2].headline}</h3></div>
          </a>
        )}
        {news[3] && (
          <a class="tile tile-card nwide" href={`/news/${news[3].slug}`}>
            {bigFigure(news[3].headline) && <span class="poster-num big red">{bigFigure(news[3].headline)}</span>}
            <div><span class="lbl muted">{newsDate(news[3].date)} · {news[3].tags[0]}</span><h3>{news[3].headline}</h3></div>
          </a>
        )}
      </div>

      <section class="tile tile-card race">
        <div class="th"><h2>{liveOn ? 'Live race' : 'World rankings'}</h2><a href="/rankings">Top 128 →</a></div>
        <ol>
          {liveOn ? [...raceTop.map((p: any) => ({ p, hi: false })), ...(raceMover ? [{ p: raceMover, hi: true }] : [])].map(({ p, hi }) => (
            <li class:list={{ hi }}><a href={`/players/${p.slug}`}><span class="poster-num rp">{p.live}</span><b>{p.name}{p.move ? <i class={p.move > 0 ? 'up' : 'down'}>{p.move > 0 ? '▲' : '▼'} {Math.abs(p.move)}</i> : null}</b><span class="rm">{money(p.money)}</span></a></li>
          )) : top.map(p => (
            <li><a href={`/players/${p.slug}`}><span class="poster-num rp">{p.pos}</span><b><Fragment set:html={flag(p.country)} /> {p.name}</b><span class="rm">{money(p.money)}</span></a></li>
          ))}
        </ol>
        <p class="lbl muted rk-note">{liveOn ? `Projected after the ${lrd.event.name.replace(/^\d{4}\s+/, '')} · updated daily (${raceUpdated})` : 'Official PDC Order of Merit'}</p>
      </section>

      {spot && (
        <a class="tile tile-ink spot" href={`/players/${spot.slug}`}>
          {cutouts[keyName(spot.name)] && <img class="spot-cut photo" src={cutouts[keyName(spot.name)]} alt="" loading="lazy" />}
          <div class="spot-top"><span class="lbl volt">Player spotlight · World #{spotRank.pos}</span><h2>{spot.name.split(' ')[0]}<br />{spot.name.split(' ').slice(1).join(' ')}</h2></div>
          {spot.season?.stats && (
            <div class="spot-bottom">
              <div class="poster-num spot-avg">{spot.season.stats.avg.toFixed(2)}</div>
              <div class="lbl">{spot.season.year} season average</div>
            </div>
          )}
        </a>
      )}

      <section class="tile tile-card cu">
        <div class="th"><h2 class="lbl">Coming up</h2><a href="/calendar">Calendar →</a></div>
        {upcoming.slice(0, 3).map(e => (
          <a class="cu-row" href={`/tournament/${e.id}`}>
            <span class="cu-d"><b class="poster-num">{dayNum(e.start)}</b><span class="lbl">{monthShort(e.start)}</span></span>
            <span class="cu-n"><b>{e.name}</b><small>{e.city || e.venue}{e.tag ? ` · ${e.tag}` : ''}</small></span>
          </a>
        ))}
      </section>

    </div>
  </div>

  <script is:inline type="application/json" id="home-data" set:html={JSON.stringify({ cutouts })}></script>

  <script>
    import { normaliseTournament, applyLive, liveCurrentLeg } from '../lib/pdc.mjs';
    import { liveFor, LIVE_TICK } from '../lib/live-client.mjs';
    import { matchday, featureTile, nextTileInner } from '../lib/feature.mjs';
    import { shortDate } from '../lib/format.mjs';

    let timer: number | undefined;
    function init() {
      clearInterval(timer);
      const box = document.getElementById('feature');
      if (!box) return;
      const { cutouts } = JSON.parse(document.getElementById('home-data')!.textContent!);
      const today = () => new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/London' });
      const hhmm = () => new Date().toLocaleTimeString('en-GB', { timeZone: 'Europe/London', hour: '2-digit', minute: '2-digit', hour12: false });

      // Countdown to the next event when nothing is on.
      const count = box.querySelector<HTMLElement>('[data-count]');
      if (count) {
        const target = Date.parse(count.dataset.count + 'T12:00:00Z');
        const tick = () => {
          const s = Math.max(0, (target - Date.now()) / 1000);
          const v: Record<string, number> = { d: Math.floor(s / 86400), h: Math.floor(s / 3600) % 24, m: Math.floor(s / 60) % 60 };
          count.querySelectorAll<HTMLElement>('[data-u]').forEach(el => { el.textContent = String(v[el.dataset.u!]).padStart(2, '0'); });
        };
        tick(); timer = window.setInterval(tick, 30_000);
      }

      // While the event is on: the schedule is re-read every 30 seconds and the
      // live score and averages every few seconds; tiles redraw only on change.
      if (box.dataset.on) {
        let base: any = null, baseAt = 0;
        const draw = (el: HTMLElement, html: string) => { if (el.dataset.html !== html) { el.innerHTML = html; el.dataset.html = html; } };
        const refresh = async () => {
          if (document.hidden) return;
          try {
            if (!base || Date.now() - baseAt > 28_000) {
              base = normaliseTournament(await (await fetch(`https://tournaments.darts.web.gc.pdcservices.co.uk/v2/${box.dataset.id}`, { cache: 'no-store' })).json());
              baseAt = Date.now();
            }
            const ids = base.stages.flatMap((s: any) => s.fixtures).filter((f: any) => f.date === today()).map((f: any) => f.id);
            const lv = await liveFor(box.dataset.id!, ids);
            const t = applyLive(structuredClone(base), lv);
            const md = matchday(t, today(), hhmm());
            const pick = md.now ? [md.now, 'now'] : md.next ? [md.next, 'next'] : md.results[0] ? [md.results[0], 'result'] : null;
            // The leg in play: what each player needs.
            if (md.now?.status === 'live') (md.now as any).legNow = await liveCurrentLeg(box.dataset.id!, lv.get(String(md.now.id))).catch(() => null);
            if (pick) draw(box, featureTile(pick[0] as any, pick[1] as string, box.dataset.name!, cutouts));
            const nu = document.getElementById('nextup') as HTMLAnchorElement | null;
            const after = md.todays.find((f: any) => f.status !== 'result' && f !== pick?.[0] && (!md.now || f !== md.now) && f.time >= ((pick?.[0] as any)?.time || ''));
            if (nu) {
              if (after) { nu.innerHTML = nextTileInner(after, box.dataset.name!); nu.href = `/match?id=${after.id}`; nu.hidden = false; }
              else nu.hidden = true;
            }
            const ol = document.getElementById('results');
            if (ol) {
              const todays = md.results.filter((f: any) => f.date === today());
              const list = (todays.length ? todays : md.results).slice(0, 5);
              const last = (n: string) => n.split(' ').slice(-1)[0];
              const e = (x: unknown) => String(x ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
              draw(ol, list.map((f: any) => `<li><a href="/match?id=${e(f.id)}"><span class="rd">${e(shortDate(f.date))}</span><span class="rn${f.winner === f.p1.id ? ' w' : ''}">${e(last(f.p1.name))}</span><span class="poster-num rs">${f.s1}–${f.s2}</span><span class="rn r${f.winner === f.p2.id ? ' w' : ''}">${e(last(f.p2.name))}</span></a></li>`).join(''));
            }
          } catch { /* keep what we have */ }
        };
        refresh();
        timer = window.setInterval(refresh, LIVE_TICK);
      }

    }
    document.addEventListener('astro:page-load', init);
  </script>
</Layout>

<style>
  .bento-wrap { padding-top: 28px; }
  .bento { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px; }
  .lbl.volt { color: var(--volt); } .lbl.red { color: var(--red); } .lbl.muted { color: var(--muted); }
  .th { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; margin-bottom: 8px; }
  .th h2 { margin: 0; }
  .th a { font-size: 13px; font-weight: 700; text-decoration: none; }
  .th a:hover { color: var(--red); }

  /* feature */
  .feature { grid-column: span 8; min-height: 520px; display: flex; flex-direction: column; }
  .feature :global(.ft-link) { position: absolute; inset: 0; z-index: 3; border-radius: inherit; }
  .feature :global(.ft-top) { position: relative; z-index: 2; display: flex; gap: 14px; flex-wrap: wrap; padding: 26px 30px 0; }
  .feature :global(.ft-live), .feature :global(.ft-next) { color: var(--volt); }
  .feature :global(.ft-res) { color: #fff; }
  .feature :global(.ft-stage) { color: var(--on-ink-2); }
  .feature :global(.ft-stage-row) { flex: 1; display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; padding: 0 20px; }
  .feature :global(.ft-p) { display: flex; height: 320px; align-items: flex-end; min-width: 0; overflow: hidden; }
  .feature :global(.ft-p.r) { justify-content: flex-end; }
  .feature :global(.ft-cut) { height: 100%; width: 100%; object-fit: contain; object-position: left bottom; filter: saturate(.88) contrast(1.06); }
  .feature :global(.ft-cut.r) { object-position: right bottom; }
  .feature :global(.ft-ini) { width: 210px; height: 280px; border-radius: 120px 120px 0 0; background: var(--ink-3); display: grid; place-items: center; }
  .feature :global(.ft-ini span) { font-family: var(--poster); font-size: 90px; color: #3a3d47; }
  .feature :global(.ft-mid) { text-align: center; padding-bottom: 64px; }
  .feature :global(.ft-score) { font-size: clamp(110px, 13vw, 200px); color: var(--volt); }
  .feature :global(.ft-score span) { color: #3a3d47; padding: 0 .08em; }
  .feature :global(.ft-vs) { color: #fff; }
  .feature :global(.ft-sub) { color: var(--on-ink-2); margin-top: 14px; }
  .feature :global(.ft-leg) { display: inline-flex; align-items: center; gap: 10px; margin-bottom: 10px; padding: 6px 20px; border-radius: 999px; background: rgba(255, 255, 255, .07); white-space: nowrap; }
  .feature :global(.ft-leg-n) { font-size: 10px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--on-ink-2); }
  .feature :global(.ft-leg b) { font-family: var(--poster); font-weight: 400; font-size: 22px; line-height: 1; color: var(--on-ink-2); font-variant-numeric: tabular-nums; min-width: 3ch; }
  .feature :global(.ft-leg b:first-child) { text-align: right; }
  .feature :global(.ft-leg b) { position: relative; }
  .feature :global(.ft-leg b.on) { color: var(--volt); }
  /* Who's throwing: a volt dot on the outside of their score */
  .feature :global(.ft-leg b.on::after) { content: ''; position: absolute; top: 50%; width: 7px; height: 7px; margin-top: -3.5px; border-radius: 50%; background: var(--volt); box-shadow: 0 0 0 3px rgba(200, 255, 46, .22); }
  .feature :global(.ft-leg b.on:first-child::after) { left: -12px; }
  .feature :global(.ft-leg b.on:last-child::after) { right: -12px; }
  .feature :global(.ft-pulse) { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--red); margin-right: 7px; vertical-align: 1px; animation: pulse 1.6s infinite; }
  .feature :global(.ft-bottom) { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--ink-2); }
  .feature :global(.ft-who) { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 18px 30px; }
  .feature :global(.ft-who.l) { border-right: 1px solid var(--ink-2); }
  .feature :global(.ft-who.r) { flex-direction: row-reverse; text-align: right; }
  .feature :global(.ft-who b) { display: block; font-size: 19px; }
  .feature :global(.ft-who small) { color: var(--on-ink-2); font-size: 13px; }
  .feature :global(.ft-who.won b) { color: var(--volt); }
  .feature :global(.ft-avg) { display: flex; flex-direction: column; align-items: inherit; }
  .feature :global(.ft-avg .poster-num) { font-size: 34px; }
    .ne { display: flex; flex-direction: column; gap: 14px; padding: 30px; height: 100%; text-decoration: none; color: #fff; }
  .ne-name { font-size: clamp(64px, 8vw, 120px); margin-top: auto; }
  .ne-name small { display: block; font-size: .35em; color: var(--on-ink); margin-top: 8px; }
  .ne-meta { margin: 0; color: var(--on-ink); font-weight: 600; }
  .ne-count { display: flex; gap: 12px; }
  .ne-count div { background: var(--ink-3); border-radius: 18px; padding: 12px 18px; text-align: center; min-width: 88px; }
  .ne-count b { display: block; font-size: 56px; color: var(--volt); }
  .ne-count span { color: var(--on-ink-2); }

  .side { grid-column: span 4; display: flex; flex-direction: column; gap: 16px; }
  .nu[hidden] { display: none; }
  .nu :global(.nu-names) { font-size: 60px; }
  .nu :global(.nu-sub) { font-weight: 600; font-size: 14px; }
  .nu { display: flex; flex-direction: column; gap: 10px; padding: 24px 26px; text-decoration: none; }
  .nu-names { font-size: 60px; }
  .nu-sub { font-weight: 600; font-size: 14px; }
  .res { padding: 20px 22px; flex: 1; }
  .res ol, .race ol { list-style: none; margin: 0; padding: 0; }
  .res :global(li a) { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto minmax(0, 1fr); gap: 10px; align-items: center; padding: 10px 0; border-top: 1px solid var(--line); text-decoration: none; }
  .res :global(.rn) { color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .res :global(.rd) { font-size: 12px; font-weight: 700; color: var(--muted); white-space: nowrap; }
  .res :global(.rn.w) { color: var(--ink); font-weight: 700; }
  .res :global(.rn.r) { text-align: right; }
  .res :global(.rs) { font-size: 22px; }

  .lead { grid-column: span 6; min-height: 440px; display: flex; flex-direction: column; justify-content: flex-end; text-decoration: none; }
  .lead img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .lead-box { position: relative; background: var(--ink); margin: 0 16px 16px; border-radius: 20px; padding: 22px 24px; }
  .lead-box h2 { font-size: clamp(32px, 3.2vw, 46px); margin: 10px 0 8px; }
  .lead-box p { margin: 0; color: var(--on-ink); font-size: 15px; }
  .lead:hover h2 { color: var(--volt); }
  .nsub { grid-column: span 6; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .nc { display: flex; flex-direction: column; text-decoration: none; }
  .nc img { width: 100%; height: 180px; object-fit: cover; }
  .nc div { padding: 16px 20px 20px; }
  .nc h3, .nred h3, .nwide h3 { font-size: 19px; line-height: 1.2; margin-top: 8px; }
  .nc:hover h3, .nwide:hover h3 { color: var(--red); }
  .nred { background: var(--red); color: #fff; padding: 22px; display: flex; flex-direction: column; justify-content: space-between; text-decoration: none; }
  .big { font-size: 96px; }
  .nwide { grid-column: span 2; display: flex; align-items: center; gap: 22px; padding: 20px 24px; text-decoration: none; }
  .nwide .big { font-size: 64px; flex: none; }
  .big.red { color: var(--red); }

  .race { grid-column: span 5; padding: 22px 26px; }
