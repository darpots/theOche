---
// Matchday homepage: what's on now, the latest news, who's moving in the
// rankings and what's coming up. The full season lives on /calendar.
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import NewsArt from '../components/NewsArt.astro';
import { getCollection } from 'astro:content';
import calendar from '../data/calendar.json';
import data from '../data/tournament.json';
import rankings from '../data/rankings.json';
import portraitsRaw from '../data/portraits.json';
import { tvBadge, flag, keyName } from '../lib/pdc.mjs';
import { newsDate, dayNum, monthShort, weekday, money, avatarColours, initials } from '../lib/format.mjs';

const today = new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/London' });
const t = data.tournament as any;
const all = t.stages.flatMap((s: any) => s.fixtures.map((f: any) => ({ ...f, stage: /^group/i.test(s.name) ? 'Group stage' : s.name })))
  .filter((f: any) => f.p1 && f.p2);
const todays = all.filter((f: any) => f.date === today).sort((a: any, b: any) => (a.time || '99').localeCompare(b.time || '99'));
const latest = all.filter((f: any) => f.status === 'result').sort((a: any, b: any) => `${b.date}${b.time}`.localeCompare(`${a.date}${a.time}`)).slice(0, 8);
const strip = todays.length ? todays : latest;
const stripTitle = todays.length ? 'Today’s order of play' : 'Latest results';

const news = (await getCollection('news')).map(n => n.data).sort((a, b) => b.date.localeCompare(a.date)).slice(0, 3);
const upcoming = calendar.events.filter(e => e.start > today && e.id !== t.id).slice(0, 6);
const portraits = portraitsRaw as Record<string, { image: string }>;
const prev = (rankings.previous || {}) as Record<string, number>;
const top = rankings.players.slice(0, 8).map(p => ({ ...p, move: prev[p.id] ? prev[p.id] - p.pos : 0 }));
const pic = (n: string) => portraits[keyName(n)]?.image;
const av = (n: string) => { const [c1, c2] = avatarColours(n); return `--c1:${c1};--c2:${c2}`; };
const place = (e: { venue: string | null; city: string | null }) => (e.venue && e.city && e.venue.includes(e.city) ? e.venue : [e.venue, e.city].filter(Boolean).join(', '));
---
<Layout title="The Oche" description="PDC darts today: live scores, the latest news, live rankings and every event on Sky Sports, ITV and PDCTV.">
  <Hero />

  {strip.length > 0 && (
    <section class="wrap sec" aria-labelledby="op">
      <div class="sh"><h2 id="op">{stripTitle}</h2><a href={`/tournament/${t.id}`}>{t.name} schedule →</a></div>
      <ol class="op" id="op-list" data-id={t.id}>
        {strip.map((f: any) => {
          const w1 = f.winner && f.winner === f.p1.id, w2 = f.winner && f.winner === f.p2.id;
          return (
            <li class={`opc ${f.status}`} data-fx={f.id}>
              <a href={`/match?id=${f.id}`}>
                <span class="opm">{f.stage}<b data-st>{f.status === 'result' ? 'Result' : f.status === 'live' ? 'Live' : f.time || 'TBC'}</b></span>
                <span class:list={['opp', { w: w1 }]}><Fragment set:html={flag(f.p1.country)} /> {f.p1.name}<b data-s1>{f.status !== 'upcoming' ? f.s1 : ''}</b></span>
                <span class:list={['opp', { w: w2 }]}><Fragment set:html={flag(f.p2.country)} /> {f.p2.name}<b data-s2>{f.status !== 'upcoming' ? f.s2 : ''}</b></span>
              </a>
            </li>
          );
        })}
      </ol>
    </section>
  )}

  <section class="wrap sec two">
    <div>
      <div class="sh"><h2>Latest news</h2><a href="/news">All news →</a></div>
      <div class="nl">
        {news.map((n, i) => (
          <a class:list={['ni card', { lead: i === 0 }]} href={`/news/${n.slug}`}>
            <NewsArt story={n} class="ni-art" eager={i === 0} />
            <div class="ni-c"><time datetime={n.date}>{newsDate(n.date)}</time><h3>{n.headline}</h3>{i === 0 && <p>{n.standfirst}</p>}</div>
          </a>
        ))}
      </div>
    </div>
    <aside>
      <div class="sh"><h2 id="rk-title">World rankings</h2><a href="/rankings">Top 128 →</a></div>
      <ol class="rk card" id="rk">
        {top.map(p => (
          <li>
            <a href={`/players/${p.slug}`}>
              <span class="rp">{p.pos}</span>
              <span class="avatar" style={`--size:34px;${av(p.name)}`}>{pic(p.name) ? <img src={pic(p.name)} alt="" loading="lazy" /> : initials(p.name)}</span>
              <span class="rn"><Fragment set:html={flag(p.country)} /> {p.name}</span>
              <span class="rm">{money(p.money)}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="rk-note muted" id="rk-note">Official PDC Order of Merit.</p>
    </aside>
  </section>

  <section class="wrap sec" aria-labelledby="cu">
    <div class="sh"><h2 id="cu">Coming up</h2><a href="/calendar">Full calendar →</a></div>
    <ol class="tl">
      {upcoming.map(e => (
        <li>
          <a href={`/tournament/${e.id}`}>
            <span class="td"><small>{weekday(e.start)}</small><b>{dayNum(e.start)}</b><small>{monthShort(e.start)}</small></span>
            <span class="tn"><b>{e.name}</b>{e.tag && <small>{e.tag}</small>}<small class="muted">{place(e)}</small></span>
            <span class="tb"><Fragment set:html={tvBadge(e.broadcaster)} /></span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <script>
    import { loadLiveRace } from '../lib/pdc.mjs';
    import { money } from '../lib/format.mjs';

    let timer: number | undefined;
    function init() {
      const list = document.getElementById('op-list');
      clearInterval(timer);
      const today = new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/London' });

      // Keep today's scores current.
      if (list) {
        const refresh = async () => {
          if (document.hidden) return;
          try {
            const a = (await (await fetch(`https://tournaments.darts.web.gc.pdcservices.co.uk/v2/${list.dataset.id}`, { cache: 'no-store' })).json()).data.attributes;
            const byId = new Map((a.stages || []).flatMap((s: any) => s.fixtures || []).map((f: any) => [String(f.fixtureID), f]));
            list.querySelectorAll<HTMLElement>('[data-fx]').forEach(li => {
              const f: any = byId.get(li.dataset.fx!); if (!f) return;
              const st = /result/i.test(f.status) ? 'result' : /live|progress/i.test(f.status) ? 'live' : 'upcoming';
              li.className = `opc ${st}`;
              li.querySelector('[data-st]')!.textContent = st === 'result' ? 'Result' : st === 'live' ? 'Live' : (f.startTime || '').slice(0, 5) || 'TBC';
              if (st !== 'upcoming') { li.querySelector('[data-s1]')!.textContent = String(f.participant1Score ?? 0); li.querySelector('[data-s2]')!.textContent = String(f.participant2Score ?? 0); }
              const w = f.winnerParticipantID ? String(f.winnerParticipantID) : null;
              const ps = li.querySelectorAll('.opp');
              ps[0].classList.toggle('w', !!w && w === String(f.participant1?.participantID));
              ps[1].classList.toggle('w', !!w && w === String(f.participant2?.participantID));
            });
          } catch { /* keep the build-time scores */ }
        };
        refresh();
        timer = window.setInterval(refresh, 30_000);
      }

      // During a ranking event, show the live race instead of the official order.
      const rk = document.getElementById('rk');
      if (rk) loadLiveRace(today).then(res => {
        if (!res || !document.getElementById('rk')) return;
        const top = res.race.slice(0, 8);
        const esc = (x: unknown) => String(x ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
        const old = new Map([...rk.querySelectorAll('li')].map(li => [li.querySelector('.rn')!.textContent!.trim(), li.innerHTML]));
        rk.innerHTML = top.map((p: any) => {
          const prev = old.get(p.name);
          const tmp = document.createElement('div'); tmp.innerHTML = prev || '';
          const avatar = tmp.querySelector('.avatar')?.outerHTML || '';
          const mv = p.move ? `<i class="${p.move > 0 ? 'up' : 'down'}">${p.move > 0 ? '▲' : '▼'}${Math.abs(p.move)}</i>` : '';
          return `<li><a href="/players/${esc((p.slug || ''))}"><span class="rp">${p.live}${mv}</span>${avatar}<span class="rn">${esc(p.name)}</span><span class="rm">${money(p.money)}</span></a></li>`;
        }).join('');
        document.getElementById('rk-title')!.textContent = 'Live race';
        document.getElementById('rk-note')!.textContent = `Projected standings during the ${res.event.name.replace(/^\d{4}\s+/, '')}. Movement is against the official list.`;
      });
    }
    document.addEventListener('astro:page-load', init);
  </script>
</Layout>

<style>
  .sec { margin-top: 44px; }
  .sh { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .sh h2 { font-size: 26px; }
  .sh a { font-weight: 700; font-size: 14px; text-decoration: none; color: var(--ink-2); white-space: nowrap; }
  .sh a:hover { color: var(--red); }

  .op { list-style: none; margin: 0; padding: 2px 2px 10px; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(250px, 1fr); gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: thin; }
  .opc { scroll-snap-align: start; }
  .opc a { display: flex; flex-direction: column; gap: 6px; padding: 14px 16px; height: 100%; background: var(--card); border: 1px solid var(--line); border-radius: 16px; text-decoration: none; transition: border-color .2s, transform .3s var(--ease); }
  .opc a:hover { border-color: var(--ink); transform: translateY(-2px); }
  .opc.live a { border-color: var(--red); box-shadow: 0 0 0 3px var(--red-soft); }
  .opm { display: flex; justify-content: space-between; font-size: 12px; font-weight: 700; color: var(--muted); }
  .opm b { color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .opc.live .opm b { color: var(--red); }
  .opp { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 15px; color: var(--muted); }
  .opp b { margin-left: auto; font-family: var(--display); font-size: 20px; font-variant-numeric: tabular-nums; color: var(--muted); }
  .opc.upcoming .opp, .opp.w { color: var(--ink); }
  .opp.w b { color: var(--ink); }
  .opc.live .opp b { color: var(--ink); }

  .two { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 32px; align-items: start; }
  .nl { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .ni { display: flex; flex-direction: column; overflow: hidden; text-decoration: none; }
  .ni.lead { grid-column: 1 / -1; display: grid; grid-template-columns: 1.1fr 1fr; }
  .ni :global(.ni-art) { aspect-ratio: 16 / 9; }
  .ni.lead :global(.ni-art) { aspect-ratio: auto; height: 100%; min-height: 240px; }
  .ni-c { padding: 14px 16px 18px; display: flex; flex-direction: column; gap: 6px; }
  .ni.lead .ni-c { padding: 22px; justify-content: center; }
  .ni time { font-size: 12px; font-weight: 800; color: var(--red); }
  .ni h3 { font-size: 18px; line-height: 1.2; }
  .ni.lead h3 { font-size: 26px; }
  .ni p { margin: 0; color: var(--muted); }
  .ni:hover h3 { color: var(--red); }

  .rk { list-style: none; margin: 0; padding: 6px; }
  .rk :global(li a) { display: grid; grid-template-columns: 44px 34px 1fr auto; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 12px; text-decoration: none; }
  .rk :global(li a:hover) { background: var(--paper); }
  .rk :global(.rp) { font-family: var(--display); font-weight: 800; font-size: 17px; display: flex; flex-direction: column; line-height: 1; }
  .rk :global(.rp i) { font-style: normal; font-family: var(--body); font-size: 10px; font-weight: 800; margin-top: 2px; }
  .rk :global(.up) { color: var(--green); } .rk :global(.down) { color: var(--red); }
  .rk :global(.rn) { font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rk :global(.rm) { font-size: 13px; font-weight: 700; color: var(--muted); font-variant-numeric: tabular-nums; }
  .rk-note { font-size: 12px; margin: 8px 4px 0; }

  .tl { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 10px; }
  .tl a { display: grid; grid-template-columns: 56px 1fr auto; align-items: center; gap: 14px; padding: 10px 14px 10px 10px; background: var(--card); border: 1px solid var(--line); border-radius: 16px; text-decoration: none; transition: border-color .2s; }
  .tl a:hover { border-color: var(--ink); }
  .td { display: flex; flex-direction: column; align-items: center; background: var(--ink); color: #fff; border-radius: 12px; padding: 6px 0; line-height: 1.1; }
  .td small { font-size: 10px; font-weight: 800; text-transform: uppercase; opacity: .75; }
  .td b { font-family: var(--display); font-size: 22px; }
  .tn { display: flex; flex-direction: column; min-width: 0; }
  .tn b { font-family: var(--display); font-size: 17px; }
  .tn small { font-size: 13px; color: var(--ink-2); }
  .tn small.muted { color: var(--muted); }

  @media (max-width: 900px) {
    .two { grid-template-columns: 1fr; }
    .nl { grid-template-columns: 1fr; }
    .ni.lead { grid-template-columns: 1fr; }
    .ni.lead :global(.ni-art) { height: auto; aspect-ratio: 16 / 9; min-height: 0; }
  }
</style>
