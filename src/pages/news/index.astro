---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import NewsArt from '../../components/NewsArt.astro';
import { newsDate } from '../../lib/format.mjs';
import calendar from '../../data/calendar.json';
import rankings from '../../data/rankings.json';

// The news page shows the last month. (Tournament round-ups stay longer and
// are listed on their tournament's page.)
const cutoff = Date.now() - 31 * 864e5;
const stories = (await getCollection('news'))
  .map(s => s.data)
  .filter(s => Date.parse(s.date) >= cutoff)
  .sort((a, b) => b.date.localeCompare(a.date));
const [lead, ...rest] = stories;
// Filter chips: only tournaments and players, with at least two stories, most covered first.
const known = new Set([...calendar.events.map(e => e.name.toLowerCase()), 'world championship', 'premier league', 'grand slam of darts', 'players championship', 'players championship finals', 'order of merit', ...rankings.players.map(p => p.name.toLowerCase())]);
const counts = new Map<string, number>();
for (const s of stories) for (const t of s.tags) if (known.has(t.toLowerCase())) counts.set(t, (counts.get(t) || 0) + 1);
const tags = [...counts].filter(([, n]) => n >= 2).sort((a, b) => b[1] - a[1]).map(([t]) => t).slice(0, 8);
---
<Layout title="News" description="The latest PDC darts news, written by The Oche newsdesk." active="news">
  <section class="hero wrap">
    <span class="eyebrow">Newsdesk</span>
    <h1>The latest from <span class="accent">the tour.</span></h1>
    <p class="lede">Original reports on the PDC, refreshed through the day. Every story is dated and links to its sources, and the page covers the last month.</p>
  </section>

  {!lead ? (
    <section class="wrap empty"><h3>The newsdesk is warming up</h3><p>New stories will appear here automatically within a few hours.</p></section>
  ) : (
    <section class="wrap">
      {tags.length > 0 && (
        <div class="chips" role="group" aria-label="Filter stories" data-reveal>
          <button class="chip" data-tag="" aria-pressed="true">All stories</button>
          {tags.map(t => <button class="chip" data-tag={t} aria-pressed="false">{t}</button>)}
        </div>
      )}
      <a href={`/news/${lead.slug}`} class="lead card lift" data-tags={lead.tags.join('|')} data-reveal>
        <NewsArt story={lead} class="lead-art" eager />
        <div class="lead-copy">
          {lead.tags[0] && <span class="tagpill">{lead.tags[0]}</span>}
          <time datetime={lead.date}>{newsDate(lead.date)}</time>
          <h2 class="headline" transition:name={`h-${lead.slug}`}>{lead.headline}</h2>
          <p>{lead.standfirst}</p>
          <span class="more">Read the story <span aria-hidden="true">→</span></span>
        </div>
      </a>
      <div class="list">
        {rest.map((s, i) => (
          <a href={`/news/${s.slug}`} class="story card lift" data-tags={s.tags.join('|')} data-reveal style={`--d:${(i % 3) * 80}ms`}>
            <NewsArt story={s} class="story-art" sizes="(max-width: 760px) 100vw, 380px" />
            <div class="story-copy">
              {s.tags[0] && <span class="tagpill">{s.tags[0]}</span>}
              <time datetime={s.date}>{newsDate(s.date)}</time>
              <h3 transition:name={`h-${s.slug}`}>{s.headline}</h3>
              <p>{s.standfirst}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <script>
    function init() {
      const chips = document.querySelectorAll<HTMLButtonElement>('[data-tag]');
      chips.forEach(c => c.addEventListener('click', () => {
        const tag = c.dataset.tag!;
        chips.forEach(x => x.setAttribute('aria-pressed', String(x === c)));
        document.querySelectorAll<HTMLElement>('[data-tags]').forEach(el => {
          el.hidden = !!tag && !el.dataset.tags!.split('|').includes(tag);
          el.classList.add('in');
        });
      }));
    }
    document.addEventListener('astro:page-load', init);
  </script>
</Layout>

<style>
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }
  a.card { text-decoration: none; display: block; overflow: hidden; }
  time { font-size: 12px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--red); }
  a.card.lead { display: grid; grid-template-columns: 1.25fr 1fr; align-items: center; }
  .lead :global(.lead-art) { height: 340px; }
  .lead-copy { padding: 32px; display: flex; flex-direction: column; justify-content: center; gap: 10px; }
  .lead h2 { font-size: clamp(24px, 3vw, 34px); }
  .lead p { margin: 0; color: var(--muted); font-size: 17px; }
  .more { margin-top: 8px; font-weight: 700; color: var(--ink); }
  .list { margin-top: 18px; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 18px; }
  .story { display: flex; flex-direction: column; }
  .story :global(.story-art) { aspect-ratio: 16 / 8; }
  .tagpill { align-self: flex-start; background: var(--ink); color: #fff; font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; padding: 5px 10px; border-radius: 999px; }
  .story-copy { padding: 18px 20px 22px; display: flex; flex-direction: column; gap: 8px; }
  .story h3 { font-size: 20px; }
  .story p { margin: 0; color: var(--muted); font-size: 15px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 760px) { a.card.lead { grid-template-columns: 1fr; } .lead :global(.lead-art) { height: auto; aspect-ratio: 16 / 8; } .lead-copy { padding: 22px; } }
</style>
