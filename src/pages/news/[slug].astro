---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import NewsArt from '../../components/NewsArt.astro';
import { SITE } from '../../lib/site.mjs';
import { keyNumbers, pullQuote, linkedBody } from '../../lib/story-facts';

export async function getStaticPaths() {
  const all = (await getCollection('news')).map(s => s.data).sort((a, b) => b.date.localeCompare(a.date));
  const related = (story: (typeof all)[number]) => {
    const same = all.filter(s => s.slug !== story.slug && story.tournament && s.tournament === story.tournament);
    return [...same, ...all.filter(s => s.slug !== story.slug && !same.includes(s))].slice(0, 3);
  };
  return all.map(story => ({ params: { slug: story.slug }, props: { story, more: related(story) } }));
}
const { story, more } = Astro.props;
const published = new Date(story.date).toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
const shareImage = `/og/news/${story.slug}.jpg`;
const keys = keyNumbers(story);
const quote = pullQuote(story);
const paras = linkedBody(story);
const jsonld = {
  '@context': 'https://schema.org', '@type': 'NewsArticle',
  headline: story.headline, description: story.standfirst, datePublished: story.date, dateModified: story.updated || story.date,
  image: [new URL(shareImage, Astro.site).href],
  author: { '@type': 'Organization', name: SITE.name, url: Astro.site?.href },
  publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: new URL('/icon-512.png', Astro.site).href } },
  mainEntityOfPage: new URL(`/news/${story.slug}`, Astro.site).href,
  about: story.players.map(name => ({ '@type': 'Person', name })),
};
---
<Layout title={story.headline} description={story.standfirst} active="news" type="article" image={shareImage} jsonld={jsonld}>
  <article class="wrap article">
    <a href="/news" class="back">← All news</a>
    <header>
      <div class="tags">{story.kind === 'morning' && <span class="ed">Morning Oche</span>}{story.kind === 'preview' && <span class="ed">Preview</span>}{story.tags.map(t => <span>{t}</span>)}</div>
      <h1 class="headline" transition:name={`h-${story.slug}`}>{story.headline}</h1>
      <p class="stand">{story.standfirst}</p>
      <p class="byline muted">By The Oche newsdesk · <time datetime={story.date}>{published}</time>{story.updated && <> · Updated <time datetime={story.updated}>{new Date(story.updated).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit', timeZone: 'Europe/London' })}</time></>}</p>
    </header>
    <NewsArt story={story} class="cover" eager />
    {keys.numbers.length > 0 && (
      <aside class="keys" aria-label="Key numbers">
        {keys.numbers.map(k => <div class:list={{ hi: k.hi }}><b class="poster-num">{k.value}</b><span>{k.label}</span></div>)}
        {keys.matchId && <a class="keys-go" href={`/match?id=${keys.matchId}`}>Match centre →</a>}
      </aside>
    )}
    <div class="text">
      {paras.map((p, i) => <>
        <p class:list={{ dc: i === 0 && !p.startsWith('<a') }} data-reveal style={`--d:${Math.min(i, 3) * 60}ms`} set:html={p} />
        {quote && quote.after === i && <blockquote class="pull"><p>“{quote.text}”</p><cite>{quote.by}</cite></blockquote>}
      </>)}
    </div>
    {story.verdict && (
      <aside class="verdict" aria-label="Oche Verdict">
        <span class="lbl">The Oche Verdict</span>
        <p><b>{story.verdict.pick}</b>{story.verdict.score && <> to win <span class="poster-num">{story.verdict.score}</span></>}</p>
      </aside>
    )}
    {more.length > 0 && (
      <section class="more">
        <h2>More news</h2>
        <div class="more-grid">
          {more.map(s => <a class="card lift" href={`/news/${s.slug}`}><strong>{s.headline}</strong><span class="muted">{new Date(s.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}</span></a>)}
        </div>
      </section>
    )}
  </article>
</Layout>

<style>
  .article { max-width: 780px; padding-top: 40px; }
  .back { text-decoration: none; font-weight: 700; color: var(--muted); }
  .back:hover { color: var(--fg); }
  header { margin: 22px 0 26px; }
  .tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .tags span { font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--red-text); background: var(--red-soft); padding: 4px 10px; border-radius: 999px; }
  .tags span.ed { background: var(--ink); color: var(--volt); }
  h1 { font-size: clamp(30px, 4.6vw, 48px); margin: 14px 0; }
  .stand { font-size: 20px; color: var(--fg-2); margin: 0 0 12px; line-height: 1.45; }
  .byline { font-size: 14px; margin: 0; }
  .article :global(.cover) { border-radius: var(--radius); aspect-ratio: 16 / 7; box-shadow: var(--shadow); }
  .text { margin-top: 30px; font-size: 18px; line-height: 1.75; }
  .text p { margin: 0 0 1.1em; }
  .text p.dc::first-letter { font-family: var(--display); font-size: 3.4em; font-weight: 800; float: left; line-height: .9; margin: 6px 10px 0 0; color: var(--red-text); }
  /* Key numbers: the story at a glance */
  .keys { display: flex; flex-wrap: wrap; gap: 2px; margin-top: 18px; background: var(--line); border-radius: 18px; overflow: hidden; }
  .keys div { flex: 1 1 120px; background: var(--card); padding: 14px 16px; display: flex; flex-direction: column; gap: 6px; }
  .keys div.hi { background: var(--ink); color: #fff; }
  .keys div.hi b { color: var(--volt); }
  .keys b { font-size: 36px; }
  .keys span { font-size: 12px; font-weight: 700; color: var(--muted); line-height: 1.3; }
  .keys div.hi span { color: var(--on-ink); }
  .keys-go { flex: 1 1 100%; background: var(--card); padding: 10px 16px; font-weight: 800; font-size: 14px; text-decoration: none; text-align: right; }
  .keys-go:hover { color: var(--red-text); }
  .text :global(a) { color: inherit; text-decoration-color: var(--red); text-decoration-thickness: 2px; text-underline-offset: 3px; font-weight: 600; }
  .pull { margin: 28px 0; padding: 4px 0 4px 22px; border-left: 4px solid var(--volt); }
  .pull p { font-family: var(--display); font-weight: 800; font-size: clamp(22px, 3vw, 28px); line-height: 1.25; letter-spacing: -.015em; margin: 0 0 8px; }
  .pull cite { font-style: normal; font-weight: 700; font-size: 14px; color: var(--muted); }
  .pull cite::before { content: '— '; }
  .verdict { margin-top: 8px; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; background: var(--ink); color: #fff; border-radius: 18px; padding: 16px 20px; }
  .verdict .lbl { color: var(--volt); }
  .verdict p { margin: 0; font-size: 18px; }
  .verdict .poster-num { font-size: 30px; color: var(--volt); margin-left: 6px; vertical-align: -3px; }
  .more { margin-top: 48px; }
  .more h2 { font-size: 24px; margin-bottom: 14px; }
  .more-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
  .more-grid a { padding: 16px; text-decoration: none; display: flex; flex-direction: column; gap: 8px; }
</style>
