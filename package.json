{
  "name": "the-oche",
  "description": "The Oche \u2014 PDC darts calendar, matches, news and rankings",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "data:calendar": "node scripts/refresh-calendar.mjs",
    "data:rankings": "node scripts/refresh-rankings.mjs",
    "data:tournament": "node scripts/refresh-tournament.mjs",
    "data:players": "node scripts/refresh-players.mjs",
    "data:fast": "node scripts/refresh-calendar.mjs && node scripts/refresh-rankings.mjs && node scripts/refresh-tournament.mjs",
    "news": "node scripts/news/run.mjs",
    "test": "node --test tests/",
    "recap-facts": "node scripts/news/recap-facts.mjs",
    "data:live-race": "node scripts/refresh-live-race.mjs",
    "data:images": "node scripts/make-player-images.mjs"
  },
  "type": "module",
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "fast-xml-parser": "^5.12.1"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "sharp@0.34.5": true
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
